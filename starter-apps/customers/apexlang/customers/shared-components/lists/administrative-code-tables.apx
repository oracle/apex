    entry reference-types (
        label: Reference Types
        icon {
            imageIconCssClasses: fa-group
        }
        layout {
            sequence: 140
        }
        isCurrent {
            type: pages
            pages: 78
        }
        link {
            target: {
                page: 78
                action: resetPagination
            }
        }
        userDefinedAttributes {
            1: Manage domain of customer reference types.
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                APEX_UTIL.GET_BUILD_OPTION_STATUS(
                    P_APPLICATION_ID => :APP_ID,
                    P_BUILD_OPTION_NAME => 'Customer Referencability') = 'INCLUDE'
                or
                APEX_UTIL.GET_BUILD_OPTION_STATUS(
                    P_APPLICATION_ID => :APP_ID,
                    P_BUILD_OPTION_NAME => 'Product Referencability') = 'INCLUDE'
                ```
        }
        security {
            authorizationScheme: @administration-rights
        }
        config {
            buildOption: @product-referencability
        }
    )

    entry sales-channels (
