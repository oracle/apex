list administrative-code-tables (
    name: Administrative Code Tables

    entry activity-types (
        label: Activity Types
        icon {
            imageIconCssClasses: fa-newspaper-o
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 53
                clearCache: [
                    RIR
                    53
                ]
                action: resetPagination
            }
        }
        userDefinedAttributes {
            1: Manage the types of activities tracked by the system.
        }
        security {
            authorizationScheme: @administration-rights
        }
        config {
            buildOption: @activities
        }
    )

    entry categories (
        label: Categories
        icon {
            imageIconCssClasses: fa-bullseye
        }
        layout {
            sequence: 20
        }
        isCurrent {
            type: pages
            pages: 3
        }
        link {
            target: {
                page: 3
                action: resetPagination
            }
        }
        userDefinedAttributes {
            1: Manage the categories used to bucket customers.
            2: formIcon
            3: &CNT_02.
        }
        security {
            authorizationScheme: @administration-rights
        }
    )

