lov max-rows (
    name: MAX ROWS
    source {
        location: staticValues
    }

    entry all (
        sequence: 70
        display: All
        return: 100000000
    )

    entry lov_data (
        sequence: 10
        display: 20
        return: 20
    )

    entry lov_data-2 (
        sequence: 20
        display: 50
        return: 50
    )

    entry lov_data-3 (
        sequence: 30
        display: 100
        return: 100
    )

    entry lov_data-4 (
        sequence: 40
        display: 200
        return: 200
    )

    entry lov_data-5 (
        sequence: 50
        display: 500
        return: 500
    )

    entry lov_data-6 (
        sequence: 60
        display: 1000
        return: 1000
    )

)

