lov active-categories-p (
    name: ACTIVE_CATEGORIES_P2
    source {
        type: legacySqlQuery
        sqlQuery:
            ```sql
            select category d, id r
              from EBA_CUST_CATEGORIES
             where is_active = 'Y'
                or ID = :P2_CATEGORY_ID
             order by 1
            ```
    }
)

