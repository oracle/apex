    )

    entry us-east-indiana (
        sequence: 2
        display: US/East-Indiana
        return: US/East-Indiana
    )

    entry us-eastern (
        sequence: 1
        display: US/Eastern
        return: US/Eastern
    )

    entry us-hawaii (
        sequence: 9
        display: US/Hawaii
        return: US/Hawaii
    )

    entry us-michigan (
        sequence: 3
        display: US/Michigan
        return: US/Michigan
    )

    entry us-mountain (
        sequence: 5
        display: US/Mountain
        return: US/Mountain
    )

    entry us-pacific (
