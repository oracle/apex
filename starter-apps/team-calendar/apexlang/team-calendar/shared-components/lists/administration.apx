list administration (
    name: Administration

    entry application-appearance (
        label: Application Appearance
        icon {
            imageIconCssClasses: fa-desktop
        }
        layout {
            sequence: 100
        }
        link {
            target: {
                page: 41
            }
        }
        userDefinedAttributes {
            1: Change user interface theme style for all users.
        }
    )

    entry application-error-log (
        label: Application Error Log
        icon {
            imageIconCssClasses: fa-alert
        }
        layout {
            sequence: 70
        }
        link {
            target: {
                page: 175
                clearCache: [
                    RIR
                    CIR
                ]
            }
        }
        userDefinedAttributes {
            1: Report of all internal errors encountered within the application.
            2: reportIcon
        }
        security {
            authorizationScheme: @administration-rights
        }
    )

    entry build-options (
        label: Build Options
        icon {
            imageIconCssClasses: fa-gear
        }
        layout {
            sequence: 110
        }
        link {
            target: {
                page: 40
                action: resetPagination
            }
        }
        userDefinedAttributes {
            1: Manage the status of build options. Build options allow application functionality to be included or excluded from an application.  Use build options to factor your application.
        }
        security {
            authorizationScheme: @administration-rights
        }
    )

    entry calendars (
        label: Calendars
        icon {
            imageIconCssClasses: fa-calendar
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 42
                action: resetPagination
            }
        }
        userDefinedAttributes {
            1: Maintain the different calendars available to enter events against.
        }
        security {
            authorizationScheme: @administration-rights
        }
        config {
            buildOption: @include-multiple-calendars
        }
    )

    entry event-types (
        label: Event Types
        icon {
            imageIconCssClasses: fa-align-left
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 7
                action: resetPagination
            }
        }
        userDefinedAttributes {
            1: Maintain the different types of events available. Examples: meeting, conference, etc.
            2: formIcon
        }
        security {
            authorizationScheme: @administration-rights
        }
    )

    entry manage-sample-data (
        label: Manage Sample Data
        icon {
            imageIconCssClasses: fa-database
        }
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 43
            }
        }
        userDefinedAttributes {
            1: Create, re-Create or remove sample data distributed with this application.
        }
        security {
            authorizationScheme: @administration-rights
        }
    )

    entry notifications (
        label: Notifications
        icon {
            imageIconCssClasses: fa-bullhorn
        }
        layout {
            sequence: 60
        }
        link {
            target: {
                page: 4
            }
        }
        userDefinedAttributes {
            1: Manage application notifications that can be used to notify users of information.  Notifications can be set up to show within a specific date range.
            2: formIcon
        }
        security {
            authorizationScheme: @administration-rights
        }
    )

    entry page-privileges (
        label: Page Privileges
        icon {
            imageIconCssClasses: fa-file-o
        }
        layout {
            sequence: 90
        }
        link {
            target: {
                page: 35
            }
        }
        userDefinedAttributes {
            1: Report of the pages within this application and their corresponding access control security level.
            2: reportIcon
        }
        serverSideCondition {
            type: never
        }
        security {
            authorizationScheme: @administration-rights
        }
    )

    entry rename-application (
        label: Rename Application
        icon {
            imageIconCssClasses: fa-tag
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 37
            }
        }
        userDefinedAttributes {
            1: Change the application name, displayed on the top left of each page, to one of your choosing.  By default, the application name is "&APP_NAME.".
            2: formIcon
        }
        security {
            authorizationScheme: @administration-rights
        }
    )

    entry reporting-time-frames (
        label: Reporting Time Frames
        icon {
            imageIconCssClasses: fa-file-o
        }
        layout {
            sequence: 50
        }
        link {
            target: {
                page: 23
                action: resetPagination
            }
        }
        userDefinedAttributes {
            1: For reporting purposes, define different periods, such as fiscal months.
            2: formIcon
        }
        security {
            authorizationScheme: @administration-rights
        }
    )

    entry time-zone (
        label: Time Zone
        icon {
            imageIconCssClasses: fa-globe
        }
        layout {
            sequence: 80
        }
        link {
            target: {
                page: 100
            }
        }
        userDefinedAttributes {
            1: Set my time zone preference for this application.
            2: formIcon
        }
        serverSideCondition {
            type: never
        }
    )

)

