                41
                40
                42
                44
                6
            ]
        }
        link {
            target: {
                page: 26
            }
        }
        security {
            authorizationScheme: @administration-rights
        }
    )

    entry calendar (
        label: Calendar
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 1
        }
        isCurrent {
            type: pages
            pages: [
                1
                3
                14
                31
                32
                10
                33
                34
                11
