page 13 (
    name: Initiative Document
    alias: INITIATIVE-DOCUMENT
    title: Initiative Document
    pageGroup: @projects
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        resizable: false
    }
    security {
        authorizationScheme: @contribution-rights
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region document (
        name: Document
        type: form
        source {
            location: localDatabase
            tableName: SP_INITIATIVE_DOCUMENTS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P13_DOCUMENT_BLOB (
        type: fileUpload
        label {
            label: Document
            alignment: left
        }
        display {
            displayAs: inlineDropzone
        }
        storage {
            mimeTypeColumn: DOCUMENT_MIMETYPE
            filenameColumn: DOCUMENT_FILENAME
            charSetColumn: DOCUMENT_CHARSET
            bobLastUpdatedColumn: DOCUMENT_LASTUPD
        }
        layout {
            sequence: 50
            region: @document
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @document
            column: DOCUMENT_BLOB
            dataType: blob
        }
    )

    pageItem P13_DOCUMENT_CHARSET (
        type: hidden
        layout {
            sequence: 120
            region: @document
            slot: regionBody
        }
        source {
            formRegion: @document
            column: DOCUMENT_CHARSET
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            restrictedChars: webSafe
        }
    )

    pageItem P13_DOCUMENT_FILENAME (
        type: hidden
        layout {
            sequence: 100
            region: @document
            slot: regionBody
        }
        source {
            formRegion: @document
            column: DOCUMENT_FILENAME
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            restrictedChars: webSafe
        }
    )

    pageItem P13_DOCUMENT_LASTUPD (
        type: hidden
        layout {
            sequence: 130
            region: @document
            slot: regionBody
        }
        source {
            formRegion: @document
            column: DOCUMENT_LASTUPD
            dataType: date
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            restrictedChars: webSafe
        }
    )

    pageItem P13_DOCUMENT_MIMETYPE (
        type: hidden
        layout {
            sequence: 110
            region: @document
            slot: regionBody
        }
        source {
            formRegion: @document
            column: DOCUMENT_MIMETYPE
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            restrictedChars: webSafe
        }
    )

    pageItem P13_DOC_DESCRIPTION (
        type: textarea
        label {
            label: Description
            alignment: left
        }
        layout {
            sequence: 70
            region: @document
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
            height: 5
        }
        validation {
            maxLength: 4000
        }
        source {
            formRegion: @document
            column: DOC_DESCRIPTION
            dataType: varchar2
        }
    )

    pageItem P13_ID (
        type: hidden
        layout {
            sequence: 10
            region: @document
            slot: regionBody
        }
        source {
            formRegion: @document
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P13_IMPORTANT_YN (
        type: switch
        label {
            label: Important
            alignment: left
        }
        layout {
            sequence: 90
            region: @document
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @document
            column: IMPORTANT_YN
            dataType: varchar2
        }
        default {
            type: static
            staticValue: N
        }
    )

    pageItem P13_INITIATIVE_ID (
        type: hidden
        layout {
            sequence: 150
            region: @document
            slot: regionBody
        }
        source {
            formRegion: @document
            column: INITIATIVE_ID
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P13_ON_DELETE (
        type: hidden
        layout {
            sequence: 160
            region: @document
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P13_PREV_PAGE (
        type: hidden
        layout {
            sequence: 170
            region: @document
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P13_TAGS (
        type: combobox
        label {
            label: Tags
            alignment: left
        }
        settings {
            multiSelection: true
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery: select 1 from dual where 1=2
        }
        multipleValues {
            type: delimitedList
            separator: ,
        }
        layout {
            sequence: 80
            region: @document
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 4000
        }
        source {
            formRegion: @document
            column: TAGS
            dataType: varchar2
        }
        security {
            restrictedChars: webSafe
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Add Document
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P13_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P13_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P13_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 90
        }
        advanced {
            executionMappingIdentifier: 16034022026978315302
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    process close-dialog-delete (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 100
        }
        advanced {
            executionMappingIdentifier: 19710762670031881517
        }
        serverSideCondition {
            whenButtonPressed: @delete
            type: item=value
            item: P13_ON_DELETE
            value: CLOSE
        }
    )

    process initialize-form-document (
        name: Initialize form Document
        type: formInitialization
        formRegion: @document
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 16034018753855315299
        }
    )

    process process-form-document (
        name: Process form Document
        type: formAutoRowProcessing
        formRegion: @document
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 16034019190717315300
        }
    )

    branch (
        name: after delete
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: &P13_PREV_PAGE.
            }
        }
        serverSideCondition {
            whenButtonPressed: @delete
            type: item=value
            item: P13_ON_DELETE
            value: PREV_PAGE
        }
    )

    branch (
        name: after delete, no prev page
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 21
            }
        }
        serverSideCondition {
            whenButtonPressed: @delete
            type: item=value
            item: P13_ON_DELETE
            value: HOME
        }
    )

)

