page 709 (
    name: Add Multiple Team Calendar Events
    alias: ADD-MULTIPLE-TEAM-CALENDAR-EVENTS
    title: Add Multiple Team Calendar Events
    pageGroup: @administrative-utilities
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @administration-rights
    }
    config {
        buildOption: @team-calendar
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region events (
        name: Events
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText: This allows Administrators to add multiple, single-day events (such as holidays).
        }
    )

    region events-recently-created (
        name: Events Recently Created
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.event_type, 
                       e.event_date, 
                       e.event_name,
                       e.event_details,
                       e.created
                  from sp_events e,
                       sp_event_types t
                 where e.event_type_id = t.id
                   and e.created_by = :APP_USER
                   and e.created > sysdate-1
                 order by e.created desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noUI
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
                t-Report--horizontalBorders
            ]
        }

        column CREATED (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Created
            }
            layout {
                sequence: 50
            }
            appearance {
                formatMask: SINCE
            }
            sorting {
                sortable: false
            }
        )

        column EVENT_DATE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Date
            }
            layout {
                sequence: 20
            }
            appearance {
                formatMask: DD-Mon-YYYY
            }
            sorting {
                sortable: false
            }
        )

        column EVENT_DETAILS (
            reportColumnQueryId: 4
