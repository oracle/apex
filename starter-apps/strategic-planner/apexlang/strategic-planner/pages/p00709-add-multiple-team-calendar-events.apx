    process create (
        name: create
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P709_EVENT_DATE_1 is not null and
                   :P709_EVENT_NAME_1 is not null
                then
                    sp_event_util.create_event ( 
                        p_event_type_id  => :P709_EVENT_TYPE, 
                        p_event_date     => to_date(:P709_EVENT_DATE_1,'DD-Mon-YYYY'), 
                        p_event_name     => :P709_EVENT_NAME_1, 
                        p_for_user_id    => null,
                        p_event_details  => :P709_EVENT_DETAILS_1, 
                        p_recur_freq     => null, 
                        p_recur_end_date => null ); 
                end if;
                
                if :P709_EVENT_DATE_2 is not null and
                   :P709_EVENT_NAME_2 is not null
                then
                    sp_event_util.create_event ( 
                        p_event_type_id  => :P709_EVENT_TYPE, 
                        p_event_date     => to_date(:P709_EVENT_DATE_2,'DD-Mon-YYYY'), 
                        p_event_name     => :P709_EVENT_NAME_2, 
                        p_for_user_id    => null,
                        p_event_details  => :P709_EVENT_DETAILS_2, 
                        p_recur_freq     => null, 
                        p_recur_end_date => null ); 
                end if;
                
                if :P709_EVENT_DATE_3 is not null and
                   :P709_EVENT_NAME_3 is not null
                then
                    sp_event_util.create_event ( 
                        p_event_type_id  => :P709_EVENT_TYPE, 
                        p_event_date     => to_date(:P709_EVENT_DATE_3,'DD-Mon-YYYY'), 
                        p_event_name     => :P709_EVENT_NAME_3, 
                        p_for_user_id    => null,
                        p_event_details  => :P709_EVENT_DETAILS_3, 
                        p_recur_freq     => null, 
                        p_recur_end_date => null ); 
                end if;
                
                if :P709_EVENT_DATE_4 is not null and
                   :P709_EVENT_NAME_4 is not null
                then
                    sp_event_util.create_event ( 
                        p_event_type_id  => :P709_EVENT_TYPE, 
                        p_event_date     => to_date(:P709_EVENT_DATE_4,'DD-Mon-YYYY'), 
                        p_event_name     => :P709_EVENT_NAME_4, 
                        p_for_user_id    => null,
                        p_event_details  => :P709_EVENT_DETAILS_4, 
                        p_recur_freq     => null, 
                        p_recur_end_date => null ); 
                end if;
                
                if :P709_EVENT_DATE_5 is not null and
                   :P709_EVENT_NAME_5 is not null
                then
                    sp_event_util.create_event ( 
                        p_event_type_id  => :P709_EVENT_TYPE, 
                        p_event_date     => to_date(:P709_EVENT_DATE_5,'DD-Mon-YYYY'), 
                        p_event_name     => :P709_EVENT_NAME_5, 
                        p_for_user_id    => null,
                        p_event_details  => :P709_EVENT_DETAILS_5, 
                        p_recur_freq     => null, 
                        p_recur_end_date => null ); 
                end if;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Event(s) created.
        }
        advanced {
            executionMappingIdentifier: 35903687522841405406
        }
        serverSideCondition {
            whenButtonPressed: @create-events
            type: itemIsNotNull
            item: P709_EVENT_TYPE
        }
    )

    process load-quick-picks (
        name: Load Quick Picks
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                   l_cnt  number := 1;
                begin
                
                for c1 in (
                    select event_type, id
                      from sp_event_types
                     where active_yn = 'Y'
                       and general_event_yn = 'Y'
                       and quick_pick_yn = 'Y'
                      order by event_type desc
                ) loop
                    if l_cnt = 1 then
                        :P709_QP1    := c1.event_type;
                        :P709_QP1_ID := c1.id;
                    elsif l_cnt = 2 then
                        :P709_QP2    := c1.event_type;
                        :P709_QP2_ID := c1.id;
                    elsif l_cnt = 3 then
                        :P709_QP3    := c1.event_type;
                        :P709_QP3_ID := c1.id;
                    elsif l_cnt = 4 then
                        :P709_QP4    := c1.event_type;
                        :P709_QP4_ID := c1.id;
                    elsif l_cnt = 5 then
                        :P709_QP5    := c1.event_type;
                        :P709_QP5_ID := c1.id;
                    end if;
                
                    l_cnt := l_cnt + 1;
                end loop;
                
                end;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 35933891040384364379
        }
    )

    branch (
        name: Go To Page 709
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 709
                items: {
                    P709_EVENT_TYPE: &P709_EVENT_TYPE.
                }
                clearCache: 709
            }
        }
    )

)

