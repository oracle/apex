            derivedColumn: N
            heading {
                heading: Name
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column EVENT_TYPE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Type
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

