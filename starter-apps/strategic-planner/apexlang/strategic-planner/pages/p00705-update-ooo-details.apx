        comments {
            comments:
                ```
                :P704_RECURS = 'Y' and
                (:P705_EVENT_TYPE != :P705_NEW_EVENT_TYPE or
                 nvl(:P705_EVENT_NAME,'~') != nvl(:P705_NEW_EVENT_NAME,'~') or
                 nvl(:P705_EVENT_DETAILS,'~') != nvl(:P705_NEW_EVENT_DETAILS,'~') )
                ```
        }
    )

