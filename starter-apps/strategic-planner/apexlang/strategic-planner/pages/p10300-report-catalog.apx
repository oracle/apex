page 10300 (
    name: Report Catalog
    alias: REPORT-CATALOG
    title: Report Catalog
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
        cssClasses: rw-pillar--sienna
    }
    security {
        authorizationScheme: @administration-rights
    }
    config {
        buildOption: @ir-catalog
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region interactive-report-catalog (
        name: Report Catalog
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select page_id,
                       sp_util.replace_nomenclature(page_title) page_title,
                       sp_util.replace_nomenclature(help_text) description,
                       sp_util.replace_nomenclature(page_comment) comments,
                       case when page_id = 710 then 'Interactive Report'
                            else page_function
                            end report_type
                  from APEX_APPLICATION_PAGES p
                 where application_id = :APP_ID
                   and page_mode = 'Normal'
                   and ( page_function = 'Interactive Report' or
                         page_id = 710 or
                         (page_function = 'Faceted Search' and page_id in (8, 17, 19, 21, 23, 55, 74, 102, 700)) )
                   and nvl(authorization_scheme,'Reader Rights') = 'Reader Rights'
                   and (build_option is null or 
                        apex_util.get_build_option_status (
                            p_application_id    => :APP_ID,
                            p_build_option_name => build_option) = 'INCLUDE')
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            controlBreak: false
            highlight: false
            compute: false
            aggregate: false
            chart: false
            groupBy: false
            pivot: false
            flashback: false
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 80917069574270777435
        }

        column COMMENTS (
            type: plainText
            heading {
                heading: Comments
            }
            layout {
                sequence: 60
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: BM
            }
        )

        column DESCRIPTION (
            type: plainText
            heading {
                heading: Description
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: BJ
            }
        )

        column PAGE_ID (
            type: plainText
            heading {
                heading: Page ID
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: BH
            }
        )

        column PAGE_TITLE (
            type: plainText
            heading {
                heading: Page Title
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: BI
            }
        )

        column REPORT_TYPE (
            type: plainText
            heading {
                heading: Report Type
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: BL
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Jira Sync Information
        }

        savedReport 150067037 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COMMENTS (
                sequence: 4
            )

            displayColumn DESCRIPTION (
                sequence: 3
            )

            displayColumn PAGE_ID (
                sequence: 1
            )

            displayColumn PAGE_TITLE (
                sequence: 2
            )

            displayColumn REPORT_TYPE (
                sequence: 5
            )

            sort (
                column: PAGE_ID
                sort {
                    sequence: 1
                }
            )

            sort (
                column: SYNC_IDENTIFIER
                sort {
                    direction: desc
                    sequence: 2
                }
            )

        )

    )

    button up (
        buttonName: UP
        label: Navigate Up
        layout {
            sequence: 10
            region: @breadcrumb
            slot: up
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
            ]
            icon: fa-arrow-up
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 10000
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    computation last-project-view (
        itemName: LAST_PROJECT_VIEW
        execution {
            sequence: 10
            point: afterHeader
        }
        computation {
            type: staticValue
            staticValue: 142
        }
    )

)

