                sqlQuery:
                    ```sql
                    select 1
                      from sp_activities
                     where id = :P129_ACTIVITY_ID
                       and private_yn = 'Y'
                    ```
            }
        )

        column PROJECT (
            reportColumnQueryId: 4
            derivedColumn: N
            type: link
            heading {
