    region details-3 (
        name: Details from activity
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                declare
                    x clob;
                begin
                x := 'No details provided.';
                for c1 in (select comments from sp_activities where id = :P129_ACTIVITY_ID) loop
                    x := c1.comments;
                end loop;
                return x;
                end;
                ```
            pageItemsToSubmit: P129_ACTIVITY_ID
        }
        layout {
            sequence: 120
            parentRegion: @details-2
            slot: regionBody
        }
        appearance {
