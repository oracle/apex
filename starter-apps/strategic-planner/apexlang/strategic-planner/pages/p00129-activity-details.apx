        }
        behavior {
            action: definedByDynamicAction
        }
        security {
            authorizationScheme: @contribution-rights
        }
    )

    button up (
        buttonName: UP
        label: Navigate Up
        layout {
            sequence: 20
            region: @breadcrumb
            slot: up
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
            ]
            icon: fa-arrow-up
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 102
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction contextual-info-dialog-close-refresh (
        name: after edit activity
        execution {
            sequence: 60
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @edit-other
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @activity
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh_1 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @details-3
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction links-in-comments-in-new-tab (
        name: links in comments in new tab
        execution {
            sequence: 80
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $('#COMMENTS a').attr('target','_blank');
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new-links-in-comments-in-new-tab (
        name: new links in comments in new tab
        execution {
            sequence: 90
        }
        when {
            event: apexafterrefresh
            selectionType: region
            region: @comments
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $('#COMMENTS a').attr('target','_blank');
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction on-comments-dialog-closed (
        name: on comments dialog closed
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @comments
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @comments
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction post-comment-and-do-alerts (
        name: post comment and do alerts
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @post-comment
        }

        action add-comment-and-send-alerts (
            name: Add Comment
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    sp_comment_util.add_activity_comment (
                        p_app_user_id  => :APP_USER_ID, 
                        p_comment      => :P129_COMMENT,
                        p_private_yn   => nvl(:P129_PRIVATE_YN,'N'),
                        p_activity_id  => :P129_ACTIVITY_ID,
                        p_image_ref_id => :P129_IMAGE_REF_ID );
                    
                    :P129_COMMENT      := null;
                    :P129_IMAGE_REF_ID := to_number(sys_guid(), 'XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX');
                    ```
                itemsToSubmit: [
                    P129_ACTIVITY_ID
                    P129_COMMENT
                    P129_PRIVATE_YN
                    P129_IMAGE_REF_ID
                ]
                itemsToReturn: [
                    P129_COMMENT
                    P129_IMAGE_REF_ID
                ]
                showProcessing: true
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @post-comment
            }
            execution {
                sequence: 10
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: button
                button: @post-comment
            }
            execution {
                sequence: 70
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: apex.message.ariaAlertMessage("Comment Added Successfully");
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @comments
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

    )

    computation p129-activity (
        itemName: P129_ACTIVITY
        execution {
            sequence: 10
            point: beforeHeader
        }
        computation {
            sqlQuery:
                ```sql
                select activity  
                  from sp_activities
                 where id = :P129_ACTIVITY_ID
                ```
        }
    )

)

