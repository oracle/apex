page 129 (
    name: Activity Details
    alias: ACTIVITY-DETAILS
    title: Activity Details
    pageGroup: @activities
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        fileUrls: #APP_FILES#js/spCommentImageSupport#MIN#.js
    }
    css {
        inline:
            ```css
            .sp-tag {
                padding: 2px 4px;
                display: inline-block;
                vertical-align: text-bottom;
                border-radius: 3px;
                background-color: rgba(0,0,0,.1);
                text-overflow: ellipsis;
                white-space: nowrap;
            }
            .sp-tags-container {
                display: flex;
                align-items: center;
                flex-wrap: wrap;
                gap: 4px;
                justify-content: flex-start;
            }
            
            .resize-region {
              resize: vertical;
              overflow: auto;
            }
            
            .a-CardView-iconWrap,
            .a-CardView-badge { align-self: flex-start; }
            
            .project-rds-region {
                background-color: rgb(219 204 175 / 20%);
            }
            .t-Body-title {
                --ut-palette-warning-shade: rgba(var(--oj-palette-neutral-rgb-160));
                --ut-component-background-color: rgba(var(--oj-palette-neutral-rgb-170)); 
                --ut-alert-horizontal-border-radius: 0;
            }
            ```
    }
    security {
        deepLinking: true
    }
    config {
        buildOption: @activity-planning
    }

    region activity (
        name: Activity
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.ID,
                       nvl(r.INITIATIVE_ID,i.id) initiative_id,
                       case when r.initiative_id is not null then (select initiative from sp_initiatives where id = r.initiative_id)
                            else i.initiative
                            end initiative,
                       (select project from sp_projects where id = r.project_id) project,
                       r.project_id,
                       (select case when first_name is not null or last_name is not null
                                    then first_name||' '||last_name
                                    else email
                                    end
                               from sp_team_members t where t.id = r.team_member_id) the_owner,
                       r.team_member_id,
                       s.activity_type,
                       decode(r.private_yn,'Y','Yes',null) private_comment,
                       r.start_date,
                       r.end_date,
                       case when r.end_date > to_date(:APP_SYSDATE,'DD-MON-YYYY')
                            then least(5, trunc(r.end_date) - trunc(r.end_date, 'iw') + 1)
                                 - least(5, to_date(:APP_SYSDATE,'DD-MON-YYYY') - trunc(to_date(:APP_SYSDATE,'DD-MON-YYYY'), 'iw') + 1)
                                 + (trunc(r.end_date, 'iw') - trunc(to_date(:APP_SYSDATE,'DD-MON-YYYY'), 'iw')) * 5 / 7
                       end weekdays_left,
                       r.updated
                  from sp_activities r,
                       sp_activity_types s,
                       SP_PROJECTS p, 
                       SP_INITIATIVES i
                 where r.id = :P129_ACTIVITY_ID
                   and r.activity_type_id = s.id
                   and r.project_id = p.id (+)
                   and p.initiative_id = i.id (+)
                ```
            pageItemsToSubmit: P129_ACTIVITY_ID
        }
        layout {
            sequence: 20
            parentRegion: @details
            slot: regionBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/contextual-info
            templateOptions: [
                #DEFAULT#
                t-ContextualInfo-label--stacked
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: showAll
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: Activity not found
        }

        column ACTIVITY_TYPE (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Activity Type
            }
            layout {
                sequence: 190
            }
        )

        column END_DATE (
            reportColumnQueryId: 11
            derivedColumn: N
            heading {
                heading: End Date
            }
            layout {
                sequence: 220
            }
            appearance {
                formatMask: DD-Mon-YYYY
            }
        )

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 140
            }
        )

        column INITIATIVE (
            reportColumnQueryId: 3
            derivedColumn: N
            type: link
            heading {
                heading: Initiative
            }
            layout {
                sequence: 170
            }
            link {
                target: {
                    page: 94
                    items: {
                        P94_INITIATIVE_ID: #INITIATIVE_ID#
                    }
                    clearCache: 94
                }
                linkText: #INITIATIVE#
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 from sp_activities
                     where id = :P129_ACTIVITY_ID
                       and (project_id is not null or initiative_id is not null)
                    ```
            }
        )

        column INITIATIVE_ID (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
