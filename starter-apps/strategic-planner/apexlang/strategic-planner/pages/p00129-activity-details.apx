    region additional-attributes (
        name: Additional Attributes
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select case when initiative_id is not null
                            then (select a.area from sp_areas a, sp_initiatives i    
                                   where a.id = i.area_id
                                     and i.id = c.initiative_id)
                            when project_id is not null
                            then (select a.area from sp_areas a, sp_initiatives i, sp_projects p
                                   where a.id = i.area_id
                                     and i.id = p.initiative_id
                                     and p.id = c.project_id)
                            end area,
                       lower(created_by) created_by,
                       created,
                       lower(updated_by) last_updated_by,
                       updated
                  from sp_activities c
                where id = :P129_ACTIVITY_ID
                ```
            pageItemsToSubmit: P129_INITIATIVE_ID
        }
        layout {
            sequence: 130
            slot: footer
