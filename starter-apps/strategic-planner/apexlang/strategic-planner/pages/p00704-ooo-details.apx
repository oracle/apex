    process create (
        name: Create
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                sp_event_util.create_event ( 
                    p_event_type_id  => :P704_EVENT_TYPE_ID, 
                    p_event_date     => case when :P704_RECURS = 'N' then to_date(:P704_EVENT_DATE,'DD-Mon-YYYY') else to_date(:P704_START_DATE,'DD-Mon-YYYY') end, 
                    p_event_name     => case when :P704_GENERAL_EVENT_YN = 'Y' then :P704_EVENT_NAME end, 
                    p_for_user_id    => case :P704_EVENT_FOR when 'E' 
                                                             then :P704_FOR_USER_ID
                                                             when 'M'
                                                             then :APP_USER_ID
                                                             end,
                    p_event_details  => :P704_EVENT_DETAILS, 
                    p_recur_freq     => case when :P704_RECURS = 'Y' then :P704_RECUR_FREQ end, 
                    p_recur_end_date => case when :P704_RECURS = 'Y' then to_date(:P704_END_DATE,'DD-Mon-YYYY') end ); 
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Event(s) created.
        }
        advanced {
