    process load-data-for-edit (
        name: Load data for edit
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                for c1 in (
                    select event_type_id,
                           (select general_event_yn from sp_event_types
                             where id = e.event_type_id) general_event_yn,
                           event_date,
                           event_name,
                           event_details,
                           for_user_id,
                           series_id,
                           created_by,
                           apex_util.get_since(created) created_since,
                           updated_by,
                           apex_util.get_since(updated) updated_since
                      from sp_events e
                     where id = :P704_ID
                ) loop
                    :P704_EVENT_TYPE_ID    := c1.event_type_id;
                    :P704_GENERAL_EVENT_YN := c1.general_event_yn;
                    :P704_EVENT_DETAILS    := c1.event_details;
                    :P704_EVENT_NAME       := c1.event_name;
                    :P704_CREATED_BY       := c1.created_by;
                    :P704_CREATED_SINCE    := c1.created_since;
                    :P704_UPDATED_BY       := c1.updated_by;
                    :P704_UPDATED_SINCE    := c1.updated_since;
                
                    if c1.for_user_id is null then
                       :P704_EVENT_FOR := 'A';
                    elsif sp_util.get_user_id(c1.created_by) = c1.for_user_id then
                        :P704_EVENT_FOR := 'M';
                    else   
                        :P704_EVENT_FOR := 'E';    
                    end if;
                
                    if c1.for_user_id is not null then
                        :P704_FOR_USER_ID := c1.for_user_id;
                        :P704_PREVIOUS_FOR_USER_ID := c1.for_user_id;
                    end if;
                
                    :P704_EVENT_DATE := c1.event_date;
                
                    if c1.series_id is not null then
                        for c2 in (
                            select recur_freq, start_date, end_date
                              from sp_event_series
                             where id = c1.series_id
                        ) loop
                            :P704_RECURS     := 'Y';
                            :P704_RECUR_FREQ := c2.recur_freq;
                            :P704_START_DATE := c2.start_date;
                            :P704_END_DATE   := c2.end_date;
                            :P704_SERIES_ID  := c1.series_id;
                        end loop;
                    end if;
                end loop;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 31842513680999726825
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P704_ID
        }
    )

    process load-quick-picks (
        name: Load Quick Picks
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                   l_cnt  number := 1;
                begin
                
                for c1 in (
                    select event_type, id
                      from sp_event_types
                     where active_yn = 'Y'
                 --      and general_event_yn = 'N'
                       and quick_pick_yn = 'Y'
                      order by event_type desc
                ) loop
                    if l_cnt = 1 then
                        :P704_QP1    := c1.event_type;
                        :P704_QP1_ID := c1.id;
                    elsif l_cnt = 2 then
                        :P704_QP2    := c1.event_type;
                        :P704_QP2_ID := c1.id;
                    elsif l_cnt = 3 then
                        :P704_QP3    := c1.event_type;
                        :P704_QP3_ID := c1.id;
                    elsif l_cnt = 4 then
                        :P704_QP4    := c1.event_type;
                        :P704_QP4_ID := c1.id;
                    elsif l_cnt = 5 then
                        :P704_QP5    := c1.event_type;
                        :P704_QP5_ID := c1.id;
                    end if;
                
                    l_cnt := l_cnt + 1;
                end loop;
                
                end;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 35903689271131405423
        }
    )

    process reload-ooo-summary-if-necessary (
        name: reload OOO Summary, if necessary
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_for_user_id  number;
                    l_updated_yn   varchar2(1);
                begin
                
                l_for_user_id := case :P704_EVENT_FOR when 'E' 
                                                      then :P704_FOR_USER_ID
                                                      when 'M'
                                                      then :APP_USER_ID
                                                      end;
                
                if :P704_PREVIOUS_FOR_USER_ID != l_for_user_id then
                    sp_event_util.load_one_ooo (
                        p_team_member_id => :P704_PREVIOUS_FOR_USER_ID,
                        p_updated_yn     => l_updated_yn );
                end if;
                
                if l_for_user_id is not null then
                    sp_event_util.load_one_ooo (
                        p_team_member_id => l_for_user_id,
                        p_updated_yn     => l_updated_yn );
                end if;
                
                end;
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 33518813618354200426
        }
    )

