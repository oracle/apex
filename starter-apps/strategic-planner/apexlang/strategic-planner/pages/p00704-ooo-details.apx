            sqlQuery:
                ```sql
                select 1
                  from sp_events e,
                       sp_event_series s
                 where e.id = :P704_ID
                   and e.series_id = s.id
                   and :P704_RECURS = 'Y'
                   and --( e.event_type_id != :P704_EVENT_TYPE_ID or
                        -- nvl(e.event_name,'~') != nvl(:P704_EVENT_NAME,'~') or
