page 10720 (
    name: Relation Types
    alias: RELATION-TYPES
    title: Relation Types
    pageGroup: @administrative-utilities
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
        cssClasses: rw-pillar--sienna
    }
    security {
        authorizationScheme: @administration-rights
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region relation-types (
        name: Relation Types
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       RELATION_TYPE,
                       relation_reverse,
                       decode(active_yn,'Y','Yes','N','No','Unknown') is_active,
                       CREATED,
                       lower(CREATED_BY) created_by,
                       UPDATED,
                       lower(UPDATED_BY) updated_by,
                       (select count(*) from sp_task_related where relation_type_id = rt.id ) usage
                  from SP_RELATION_TYPES RT
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 10721
                items: {
                    P10721_ID: \#ID#\
                }
                clearCache: 10721
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 87558614961311123385
        }

        column CREATED (
            type: plainText
            heading {
                heading: Created
            }
            layout {
                sequence: 5
            }
            appearance {
                formatMask: SINCE
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: E
            }
        )

        column CREATED_BY (
            type: plainText
            heading {
                heading: Created By
            }
            layout {
                sequence: 6
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column IS_ACTIVE (
            type: plainText
            heading {
                heading: Is Active
            }
            layout {
                sequence: 68
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: N
            }
        )

        column RELATION_REVERSE (
            type: plainText
            heading {
                heading: Relation Reverse
            }
            layout {
                sequence: 98
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: Q
            }
        )

        column RELATION_TYPE (
            type: plainText
            heading {
                heading: Relation Type
            }
            layout {
                sequence: 78
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: O
            }
        )

        column UPDATED (
            type: plainText
            heading {
                heading: Updated
            }
            layout {
                sequence: 7
            }
            appearance {
                formatMask: SINCE
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: G
            }
        )

        column UPDATED_BY (
            type: plainText
            heading {
                heading: Updated By
            }
            layout {
                sequence: 8
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        column USAGE (
            type: plainText
            heading {
                heading: Usage
                alignment: end
            }
            layout {
                sequence: 88
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: P
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Activity Types
        }

        savedReport 142010970 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn IS_ACTIVE (
                sequence: 3
            )

            displayColumn RELATION_REVERSE (
                sequence: 2
            )

            displayColumn RELATION_TYPE (
                sequence: 1
            )

            displayColumn UPDATED (
                sequence: 5
            )

            displayColumn USAGE (
                sequence: 4
            )

            sort (
                column: RELATION_TYPE
                sort {
                    sequence: 1
                }
            )

            sort (
                column: DISPLAY_SEQUENCE
                sort {
                    sequence: 2
                }
            )

            sort (
                column: ACTIVITIES
                sort {
                    direction: desc
                    sequence: 3
                }
            )

        )

    )

    region sql (
        name: SQL
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'insert into SP_RELATION_TYPES '||chr(10)||
                 '    (ID, RELATION_TYPE, RELATION_REVERSE, ACTIVE_YN) values ('||chr(10)||
                       id||', '||
                       ''''||RELATION_TYPE||''', '||
                       ''''||RELATION_REVERSE||''', '||
                       ''''||nvl(ACTIVE_YN,'Y')||''');' sql
                  from sp_relation_types 
                  order by relation_type
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--noUI
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }

        column SQL (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: SQL
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Add Relation Type
        layout {
            sequence: 10
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
                t-Button--iconRight
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 10721
                clearCache: 10721
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button up (
        buttonName: UP
        label: Navigate Up
        layout {
            sequence: 10
            region: @breadcrumb
            slot: up
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
            ]
            icon: fa-arrow-up
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 10000
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @relation-types
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @relation-types
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-on-dialog-closed (
        name: refresh on dialog closed
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @breadcrumb
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @relation-types
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

