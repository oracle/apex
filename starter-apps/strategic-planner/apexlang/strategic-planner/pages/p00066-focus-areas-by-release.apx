    pageItem P66_RELEASE (
        type: selectOne
        label {
            label: Release Train
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select unique release_train d, release_train r   
                  from sp_release_trains r
                 where release_type = 'FULL'
                   and exists (select 1 from sp_projects
                               where release_id = r.id
                                 and nvl(archived_yn,'N') = 'N'
                                 and duplicate_of_project_id is null)
                  order by 1
                ```
        }
        layout {
            sequence: 20
            region: @select-release
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
