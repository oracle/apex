            }
        )

        action native-set-value (
            action: setValue
            settings {
                suppressChangeEvent: true
            }
            affectedElements {
                selectionType: items
                items: P66_INITIATIVE_ID
            }
            execution {
                sequence: 10
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: region
                region: @rds
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-show_1 (
            action: show
            affectedElements {
                selectionType: region
                region: @chart
            }
            execution {
                sequence: 30
                fireWhenEventResultIs: false
            }
        )

        action native-show_2 (
            action: show
            affectedElements {
                selectionType: region
                region: @classic
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

    )

    dynamicAction when-select-release (
        name: when select release
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P66_RELEASE
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P66_RELEASE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    :P66_CURRENT_ID   := null;
                    :P66_CURRENT_NAME := null;
                    
                    :P66_N1_ID   := null;
                    :P66_N1_NAME := null;
                    
                    :P66_P1_ID   := null;
                    :P66_P1_NAME := null;
                    :P66_P2_ID   := null;
                    :P66_P2_NAME := null;
                    :P66_P3_ID   := null;
                    :P66_P3_NAME := null;
                    
                    :P66_INITIATIVE_ID := null;
                    
                    for c1 in (
                        select id, release, release_target_date, release_open_date
                          from sp_release_trains
                         where release_type = 'FULL'
                           and release_train = :P66_RELEASE
                           and release_open_completed = 'Y'
                           and release_completed = 'N'
                        union all                       -- added to catch no currently open
                        select null, null, null, null
                          from dual
                         order by release_target_date nulls last, release_open_date nulls last
                    ) loop
                        :P66_CURRENT_ID := c1.id;
                        :P66_CURRENT_NAME := c1.release;
                    
                        for c2 in (
                            select id, release
                              from sp_release_trains
                             where release_type = 'FULL'
                               and release_train = :P66_RELEASE
                               and release_completed = 'N'
                               and (id != c1.id or c1.id is null)
                               and nvl(c1.release_target_date,trunc(sysdate)) <= release_target_date
                             order by release_target_date nulls last, release_open_date nulls last
                        ) loop
                            :P66_N1_ID := c2.id;
                            :P66_N1_NAME := c2.release;
                            exit;
                        end loop;
                    
                        for c2 in (
                            select rownum, id, release
                              from (
                              select id, release
                                from sp_release_trains
                               where release_type = 'FULL'
                                 and release_train = :P66_RELEASE
                                 and release_open_completed = 'Y'
                                 and release_completed = 'Y'
                                 and (id != c1.id or c1.id is null)
                               order by release_target_date desc
                              )
                        ) loop
                            if c2.rownum = 1 then
                                :P66_P1_ID := c2.id;
                                :P66_P1_NAME := c2.release;
                            elsif c2.rownum = 2 then
                                :P66_P2_ID := c2.id;
                                :P66_P2_NAME := c2.release;
                            elsif c2.rownum = 3 then
                                :P66_P3_ID := c2.id;
                                :P66_P3_NAME := c2.release;
                            else exit;
                            end if;
                        end loop;
                    
                        exit;
                    end loop;
                    ```
                itemsToSubmit: P66_RELEASE
                itemsToReturn: [
                    P66_CURRENT_ID
                    P66_CURRENT_NAME
                    P66_N1_ID
                    P66_N1_NAME
                    P66_P1_ID
                    P66_P1_NAME
                    P66_P2_ID
                    P66_P2_NAME
                    P66_P3_ID
                    P66_P3_NAME
                    P66_INITIATIVE_ID
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @chart
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh_1 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @classic
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

)

