    pageItem P66_INITIATIVE_ID (
        type: selectOne
        label {
            label: Initiative
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select initiative d, id r   
                  from sp_initiatives i   
                 where i.id in (select p.initiative_id
                                  from sp_projects p,
                                       sp_release_trains r
                                 where p.release_id = r.id
                                   and r.release_train = :P66_RELEASE
                                   and nvl(p.archived_yn,'N') = 'N'
                                   and p.duplicate_of_project_id is null)
                 order by 1
                ```
        }
        cascadingLov {
            parentItems: P66_RELEASE
        }
        layout {
            sequence: 30
            region: @select-release
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
