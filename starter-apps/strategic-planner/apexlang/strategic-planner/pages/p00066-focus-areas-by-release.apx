page 66 (
    name: Focus Areas by Release
    alias: FOCUS-AREAS-BY-RELEASE
    title: Focus Areas by Release
    pageGroup: @users
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            .no-item-ui {
              --a-field-input-border-width: 0px;
              --a-field-input-background-color: transparent;
            }
            
            .overline {
              color: var(--ut-region-text-color, var(--ut-component-text-default-color));
            }
            
            .hide-report-total td[headers="FOCUS_AREA"] > strong {
                display: none;
            }
            ```
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region chart (
        name: Chart
        type: chart
        source {
            pageItemsToSubmit: P66_INITIATIVE_ID
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            footerText: * indicates the current Release
        }
        chartAppearance {
            stack: true
        }
        chartLayout {
            height: 400
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No data found
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(options) {
                
                    options.valueFormats.series = {
                        tooltipLabel: "Focus Area"
                    };
                
                    options.valueFormats.group = {
                        tooltipLabel: "Release"
                    };
                
                    options.valueFormats.value.tooltipLabel = "&NOMENCLATURE_PROJECT. Count";
                
                    return options;
                }
                ```
        }

        series data (
            name: data
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nvl(f.focus_area,'None Assigned') series,
                           t.release|| case when t.id = :P66_CURRENT_ID 
                                            then ' *'
                                            end label,
                           count(*) value
                      from sp_projects p,
                           sp_release_trains t,
                           sp_initiative_focus_areas f
                     where t.release_train = :P66_RELEASE
                       and p.release_id = t.id
                       and nvl(p.archived_yn,'N') = 'N'
                       and p.duplicate_of_project_id is null
                       and p.focus_area_id = f.id (+)
                       and t.release_type = 'FULL'
                       and t.id in (:P66_CURRENT_ID,:P66_N1_ID,:P66_P1_ID,:P66_P2_ID,:P66_P3_ID)
                       and p.initiative_id = nvl(:P66_INITIATIVE_ID,p.initiative_id)
                    group by t.id, t.release, f.focus_area
                    order by t.release, f.focus_area nulls last
                    ```
                pageItemsToSubmit: [
                    P66_RELEASE
                    P66_INITIATIVE_ID
                ]
            }
            columnMapping {
                seriesName: SERIES
                label: LABEL
                value: VALUE
            }
        )

        axis x (
            name: x
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
        )

    )

    region classic (
        name: Pivot Table
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.focus_area ob,
                       f.focus_area,
                       (select count(*)
                          from sp_projects
                         where nvl(archived_yn,'N') = 'N'
                           and duplicate_of_project_id is null
                           and release_id = :P66_P3_ID
                           and focus_area_id = f.id
                           and initiative_id = nvl(:P66_INITIATIVE_ID,initiative_id)) p3_cnt,
                       (select count(*)
                          from sp_projects
                         where nvl(archived_yn,'N') = 'N'
                           and duplicate_of_project_id is null
                           and release_id = :P66_P2_ID
                           and focus_area_id = f.id
                           and initiative_id = nvl(:P66_INITIATIVE_ID,initiative_id)) p2_cnt,
                       (select count(*)
                          from sp_projects
                         where nvl(archived_yn,'N') = 'N'
                           and duplicate_of_project_id is null
                           and release_id = :P66_P1_ID
                           and focus_area_id = f.id
                           and initiative_id = nvl(:P66_INITIATIVE_ID,initiative_id)) p1_cnt,
                       (select count(*)
                          from sp_projects
                         where nvl(archived_yn,'N') = 'N'
                           and duplicate_of_project_id is null
                           and release_id = :P66_CURRENT_ID
                           and focus_area_id = f.id
                           and initiative_id = nvl(:P66_INITIATIVE_ID,initiative_id)) current_cnt,
                       (select count(*)
                          from sp_projects
                         where nvl(archived_yn,'N') = 'N'
                           and duplicate_of_project_id is null
                           and release_id = :P66_N1_ID
                           and focus_area_id = f.id
                           and initiative_id = nvl(:P66_INITIATIVE_ID,initiative_id)) next_cnt
                  from sp_initiative_focus_areas f
                 where f.id in (select focus_area_id 
                                  from sp_projects
                                 where nvl(archived_yn,'N') = 'N'
                                   and duplicate_of_project_id is null
                                   and release_id in (:P66_CURRENT_ID, :P66_N1_ID, :P66_P1_ID, :P66_P2_ID, :P66_P3_ID)
                                   and initiative_id = nvl(:P66_INITIATIVE_ID,initiative_id))
                union all
                select null ob,
                       'None Assigned' focus_area,
                       (select count(*)
                          from sp_projects
                         where nvl(archived_yn,'N') = 'N'
                           and duplicate_of_project_id is null
                           and release_id = :P66_P3_ID
                           and focus_area_id is null
                           and initiative_id = nvl(:P66_INITIATIVE_ID,initiative_id)) p3_cnt,
                       (select count(*)
                          from sp_projects
                         where nvl(archived_yn,'N') = 'N'
                           and duplicate_of_project_id is null
                           and release_id = :P66_P2_ID
                           and focus_area_id is null
                           and initiative_id = nvl(:P66_INITIATIVE_ID,initiative_id)) p2_cnt,
                       (select count(*)
                          from sp_projects
                         where nvl(archived_yn,'N') = 'N'
                           and duplicate_of_project_id is null
                           and release_id = :P66_P1_ID
                           and focus_area_id is null
                           and initiative_id = nvl(:P66_INITIATIVE_ID,initiative_id)) p1_cnt,
                       (select count(*)
                          from sp_projects
                         where nvl(archived_yn,'N') = 'N'
                           and duplicate_of_project_id is null
                           and release_id = :P66_CURRENT_ID
                           and focus_area_id is null
                           and initiative_id = nvl(:P66_INITIATIVE_ID,initiative_id)) current_cnt,
                       (select count(*)
                          from sp_projects
                         where nvl(archived_yn,'N') = 'N'
                           and duplicate_of_project_id is null
                           and release_id = :P66_N1_ID
                           and focus_area_id is null
                           and initiative_id = nvl(:P66_INITIATIVE_ID,initiative_id)) next_cnt
                  from dual
                ```
            pageItemsToSubmit: P66_INITIATIVE_ID
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--noUI
