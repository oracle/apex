    dynamicAction when-change-initiative (
        name: when change initiative
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P66_INITIATIVE_ID
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @chart
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh_1 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @classic
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

    dynamicAction when-no-release-selected (
        name: when no release selected
        execution {
            sequence: 20
