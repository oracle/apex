    region team-member-notifications (
        name: Team Member Notifications
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       TEAM_MEMBER_ID,
                       (select first_name||' '||last_name
                          from sp_team_members
                         where id = n.team_member_id) team_member,
                       length(EMAIL_CONTENTS) view_email,
                       case when project_id is not null
                            then :NOMENCLATURE_PROJECT
                            when release_id is not null
                            then 'Release'
                            when initiative_id is not null
                            then :NOMENCLATURE_INITIATIVE
                            when init_focus_area_id is not null
                            then :NOMENCLATURE_INITIATIVE||' Focus Area'
                            when task_id is not null
                            then 'Milestone/Review/Task'
                            end notif_about_type,
                       case when project_id is not null
                            then (select project
                                    from sp_projects
                                   where id = n.project_id)
                            when release_id is not null
                            then (select release_train ||release 
                                    from sp_release_trains
                                   where id = n.release_id)
                            when initiative_id is not null
                            then (select initiative
                                    from sp_initiatives
                                   where id = n.initiative_id) 
                            when init_focus_area_id is not null
                            then (select i.initiative||' - '||fa.focus_area
                                    from sp_initiatives i,
                                         sp_initiative_focus_areas fa
                                   where fa.initiative_id = i.id
                                     and fa.id = n.init_focus_area_id)
                            when task_id is not null
                            then (select (select task_type from sp_task_types rt where rt.id = task_type_id)||
                                         case when task_sub_type_id is not null then ': ' end ||
                                         (select task_type from sp_task_types rt where rt.id = task_sub_type_id) ||
                                         case when task is not null then ' - '||task end
                                    from sp_tasks
                                   where id = n.task_id)
                            end notif_about,
                       PROJECT_ID,
                       task_id,
                       release_id,
                       initiative_id,
                       init_focus_area_id,
                       NOTIFICATION_PREF,
                       TITLE,
                       NOTIFICATION_TYPE,
                       DISMISSED_YN,
                       CREATED,
                       CREATED_BY,
                       UPDATED,
                       UPDATED_BY
                  from SP_TEAM_MEMBER_NOTIFICATIONS n
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
