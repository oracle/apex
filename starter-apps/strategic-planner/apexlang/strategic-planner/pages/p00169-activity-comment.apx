page 169 (
    name: Activity Comment
    alias: ACTIVITY-COMMENT
    title: Activity Comment
    pageGroup: @releases
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        resizable: false
    }
    javaScript {
        fileUrls: #APP_FILES#js/spCommentImageSupport#MIN#.js
    }
    security {
        authorizationScheme: @contribution-rights
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region task-comment (
        name: Activity Comment
        type: form
        source {
            location: localDatabase
            tableName: SP_ACTIVITY_COMMENTS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P169_ACTIVITY_ID (
        type: hidden
        layout {
            sequence: 20
            region: @task-comment
            slot: regionBody
        }
        source {
            formRegion: @task-comment
            column: ACTIVITY_ID
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P169_AUTHOR_ID (
        type: hidden
        layout {
            sequence: 100
            region: @task-comment
            slot: regionBody
        }
        source {
            formRegion: @task-comment
            column: AUTHOR_ID
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P169_BODY (
        type: richTextEditor
        label {
            label: Body
            alignment: left
        }
        settings {
            minHeight: 280
            allowCustomHtml: true
        }
        layout {
            sequence: 30
            region: @task-comment
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        advanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(options) {
                    return spCommentImageSupport.markdown.configEditor(options, {
                        apexUpload: {
                            // Application process name that that will handle the POST request when an image is dropped into
                            // text box
                            uploadApplicationProcess: 'POST_COMMENT_IMAGE',
                            // Pass in any data that you want in the POST process 
                            // Will be passed in as a JSON object and available in apex_application.g_x01
                            data: {
                                imageRefId: apex.item('P169_NEW_IMAGE_REF_ID').getValue()
                            }
                        }
                    });
                }
                ```
        }
        source {
            formRegion: @task-comment
            column: BODY
            dataType: clob
        }
        sessionState {
            dataType: clob
        }
    )

    pageItem P169_BODY_HTML (
        type: hidden
        layout {
            sequence: 70
            region: @task-comment
            slot: regionBody
        }
        source {
            formRegion: @task-comment
            column: BODY_HTML
            dataType: clob
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P169_BODY_NO_IMAGES (
        type: hidden
        layout {
            sequence: 80
            region: @task-comment
            slot: regionBody
        }
        source {
            formRegion: @task-comment
            column: BODY_NO_IMAGES
            dataType: clob
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P169_COMMENT_NBR (
        type: hidden
        layout {
            sequence: 60
            region: @task-comment
            slot: regionBody
        }
        source {
            formRegion: @task-comment
            column: COMMENT_NBR
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P169_CREATED (
        type: hidden
        layout {
            sequence: 110
            region: @task-comment
            slot: regionBody
        }
        source {
            formRegion: @task-comment
            column: CREATED
            dataType: date
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P169_CREATED_BY (
        type: hidden
        layout {
            sequence: 120
            region: @task-comment
            slot: regionBody
        }
        source {
            formRegion: @task-comment
            column: CREATED_BY
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P169_ID (
        type: hidden
        layout {
            sequence: 10
            region: @task-comment
            slot: regionBody
        }
        source {
            formRegion: @task-comment
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            restrictedChars: alphanumWithSpace
        }
    )

    pageItem P169_IMAGE_REF_ID (
        type: hidden
        layout {
            sequence: 90
            region: @task-comment
            slot: regionBody
        }
        source {
            formRegion: @task-comment
            column: IMAGE_REF_ID
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P169_NEW_IMAGE_REF_ID (
        type: hidden
        layout {
            sequence: 50
            region: @task-comment
            slot: regionBody
        }
        default {
            type: expression
            plsqlExpression: to_number(sys_guid(), 'XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX')
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P169_PRIVATE_YN (
        type: switch
        label {
            label: Private
            alignment: left
        }
        layout {
            sequence: 40
            region: @task-comment
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @task-comment
            column: PRIVATE_YN
            dataType: varchar2
        }
        default {
            type: static
            staticValue: N
        }
        security {
            restrictedChars: alphanumWithSpace
        }
    )

    pageItem P169_UPDATED (
        type: hidden
        layout {
            sequence: 130
            region: @task-comment
            slot: regionBody
        }
        source {
            formRegion: @task-comment
            column: UPDATED
            dataType: date
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P169_UPDATED_BY (
        type: hidden
        layout {
            sequence: 140
            region: @task-comment
            slot: regionBody
        }
        source {
            formRegion: @task-comment
            column: UPDATED_BY
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P169_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P169_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 90
        }
        advanced {
            executionMappingIdentifier: 2683268513333450762
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,DELETE
        }
    )

    process delete (
        name: delete
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                sp_comment_util.delete_activity_comment (
                    p_comment_id => :P169_ID );
                ```
        }
        execution {
            sequence: 80
        }
        successMessage {
            successMessage: Comment deleted.
        }
        error {
            errorMessage: Comment failed to be deleted.
        }
        advanced {
            executionMappingIdentifier: 2683267778388450761
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process initialize-form (
        name: Initialize form
        type: formInitialization
        formRegion: @task-comment
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 2683266823832450749
        }
    )

    process update (
        name: update
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                sp_comment_util.update_activity_comment (
                    p_comment_id   => :P169_ID,
                    p_comment      => :P169_BODY,
                    p_private_yn   => :P169_PRIVATE_YN,
                    p_image_ref_id => :P169_NEW_IMAGE_REF_ID );
                ```
        }
        execution {
            sequence: 70
        }
        successMessage {
            successMessage: Comment saved.
        }
        error {
            errorMessage: Comment failed to be saved.
        }
        advanced {
            executionMappingIdentifier: 2683267360209450761
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)

