page 10070 (
    name: Out of Office Event Types
    alias: OOO-EVENT-TYPES
    title: Out of Office Event Types
    pageGroup: @activities
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
        cssClasses: rw-pillar--sienna
    }
    security {
        authorizationScheme: @administration-rights
    }
    config {
        buildOption: @team-calendar
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region event-types (
        name: Event Types
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       event_type,
                       decode(general_event_yn,'Y','Yes','N','No',general_event_yn) general_event,
                       decode(quick_pick_yn,'Y','Yes','N','No',quick_pick_yn) quick_pick,
                       decode(active_yn,'Y','Yes','N','No',active_yn) active,
                       CREATED,
                       lower(CREATED_BY) created_by,
                       UPDATED,
                       lower(UPDATED_BY) updated_by,
                       (select count(*) from sp_events where event_type_id = e.id) events,
                       case when calendar_event_color is not null
                            then '<span style="color: '||apex_escape.html(calendar_event_color)||';">'||apex_escape.html(calendar_event_color)||'</span>'
                            end calendar_event_color,
                       case when icon_class is not null
                            then 'fa '||icon_class
                            end icon_class
                  from sp_event_types e
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 10071
                items: {
                    P10071_ID: \#ID#\
                }
                clearCache: 10071
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 89029450374908719372
        }

        column ACTIVE (
            type: plainText
            heading {
                heading: Active
            }
            layout {
                sequence: 60
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: U
            }
        )

        column CALENDAR_EVENT_COLOR (
            type: plainText
            heading {
                heading: Calendar Event Color
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: S
            }
            security {
                escapeSpecialChars: false
            }
        )

        column CREATED (
            type: plainText
            heading {
                heading: Created
            }
            layout {
                sequence: 80
            }
            appearance {
                formatMask: SINCE
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: E
            }
        )

        column CREATED_BY (
            type: plainText
            heading {
                heading: Created By
            }
            layout {
                sequence: 90
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column EVENTS (
            type: plainText
            heading {
                heading: Events
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: V
            }
        )

        column EVENT_TYPE (
            type: plainText
            heading {
                heading: Event Type
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: T
            }
        )

        column GENERAL_EVENT (
            type: plainText
            heading {
                heading: General Event
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: Y
            }
        )

        column ICON_CLASS (
            type: plainText
            heading {
                heading: Icon
            }
            layout {
                sequence: 40
            }
            columnFormatting {
                htmlExpression: "{if ICON_CLASS/}<span role=\"img\" class=\"#ICON_CLASS#\"></span>{endif/}"
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: W
            }
        )

        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column QUICK_PICK (
            type: plainText
            heading {
                heading: Quick Pick
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: Z
            }
        )

        column UPDATED (
            type: plainText
            heading {
                heading: Updated
            }
            layout {
                sequence: 100
            }
            appearance {
                formatMask: SINCE
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: G
            }
        )

        column UPDATED_BY (
            type: plainText
            heading {
                heading: Updated By
            }
            layout {
                sequence: 110
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Activity Types
        }

        savedReport 142010970 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ACTIVE (
                sequence: 7
            )

            displayColumn CALENDAR_EVENT_COLOR (
                sequence: 4
            )

            displayColumn EVENTS (
                sequence: 6
            )

            displayColumn EVENT_TYPE (
                sequence: 1
            )

            displayColumn GENERAL_EVENT (
                sequence: 2
            )

            displayColumn ICON_CLASS (
                sequence: 5
            )

            displayColumn QUICK_PICK (
                sequence: 3
            )

            displayColumn UPDATED (
                sequence: 8
            )

            sort (
                column: EVENT_TYPE
                sort {
                    sequence: 1
                }
            )

        )

    )

    region sql (
        name: SQL
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'insert into SP_EVENT_TYPES '||chr(10)||
                 '    (ID, EVENT_TYPE, GENERAL_EVENT_YN, QUICK_PICK_YN, CALENDAR_EVENT_COLOR, ICON_CLASS, ACTIVE_YN ) values ('||chr(10)||
                       id||', '||
                       ''''||EVENT_TYPE||''', '||
                       ''''||GENERAL_EVENT_YN||''', '||
                       ''''||QUICK_PICK_YN||''', '||
                       ''''||CALENDAR_EVENT_COLOR||''', '||
                       ''''||ICON_CLASS||''', '||
                       ''''||nvl(ACTIVE_YN,'Y')||''');' sql
                  from sp_event_types 
                  order by event_type
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--noUI
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }

        column SQL (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: SQL
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Add Event Type
        layout {
            sequence: 10
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
                t-Button--iconRight
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 10071
                clearCache: 10071
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button up (
        buttonName: UP
        label: Navigate Up
        layout {
            sequence: 10
            region: @breadcrumb
            slot: up
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
            ]
            icon: fa-arrow-up
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 10000
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @event-types
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @event-types
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @sql
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-on-dialog-closed (
        name: refresh on dialog closed
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @breadcrumb
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @event-types
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @sql
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

)

