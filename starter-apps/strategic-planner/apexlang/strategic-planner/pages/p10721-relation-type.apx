page 10721 (
    name: Relation Type
    alias: RELATION-TYPE
    title: Relation Type
    pageGroup: @administrative-utilities
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
        resizable: false
    }
    security {
        authorizationScheme: @administration-rights
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region relation-type (
        name: Relation Type
        type: form
        source {
            location: localDatabase
            tableName: SP_RELATION_TYPES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P10721_ACTIVE_YN (
        type: switch
        label {
            label: Active?
            alignment: left
        }
        layout {
            sequence: 40
            region: @relation-type
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @relation-type
            column: ACTIVE_YN
            dataType: varchar2
        }
    )

    pageItem P10721_CREATED (
        type: hidden
        layout {
            sequence: 50
            region: @relation-type
            slot: regionBody
        }
        source {
            formRegion: @relation-type
            column: CREATED
            dataType: date
            queryOnly: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P10721_CREATED_BY (
        type: hidden
        layout {
            sequence: 60
            region: @relation-type
            slot: regionBody
        }
        source {
            formRegion: @relation-type
            column: CREATED_BY
            dataType: varchar2
            queryOnly: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P10721_ID (
        type: hidden
        layout {
            sequence: 10
            region: @relation-type
            slot: regionBody
        }
        source {
            formRegion: @relation-type
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P10721_RELATION_REVERSE (
        type: textField
        label {
            label: Relation Reverse
            alignment: left
        }
        layout {
            sequence: 30
            region: @relation-type
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 60
        }
        source {
            formRegion: @relation-type
            column: RELATION_REVERSE
            dataType: varchar2
        }
        help {
            helpText: Used to describe the reverse of the relation. If the Relation is "Blocked By" then the reverse would be "Blocks". E.g. 'Task A is blocked by Task B' then 'Task B Blocks Task A'.  If no Reverse Relation is provided, the Relation will be used in both directions (e.g. 'Task A Depends On Task B' and 'Task B Depends On Task A').
        }
    )

    pageItem P10721_RELATION_TYPE (
        type: textField
        label {
            label: Relation Type
            alignment: left
        }
        layout {
            sequence: 20
            region: @relation-type
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
            maxLength: 60
        }
        source {
            formRegion: @relation-type
            column: RELATION_TYPE
            dataType: varchar2
        }
    )

    pageItem P10721_UPDATED (
        type: hidden
        layout {
            sequence: 70
            region: @relation-type
            slot: regionBody
        }
        source {
            formRegion: @relation-type
            column: UPDATED
            dataType: date
            queryOnly: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P10721_UPDATED_BY (
        type: hidden
        layout {
            sequence: 80
            region: @relation-type
            slot: regionBody
        }
        source {
            formRegion: @relation-type
            column: UPDATED_BY
            dataType: varchar2
            queryOnly: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P10721_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P10721_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P10721_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 36460180735557778869
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-manage-relation-type (
        name: Initialize form Manage Relation Type
        type: formInitialization
        formRegion: @relation-type
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 36460179668301778867
        }
    )

    process process-form-manage-relation-type (
        name: Process form Manage Relation Type
        type: formAutoRowProcessing
        formRegion: @relation-type
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Action Processed
        }
        advanced {
            executionMappingIdentifier: 36460180025523778868
        }
        security {
            authorizationScheme: @administration-rights
        }
    )

)

