page 31 (
    name: Activities Report
    alias: ACTIVITIES-REPORT
    title: Activities
    pageGroup: @reporting
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    help {
        helpText: "All Activities with this application.  Activities can be optionally associated with &NOMENCLATURE_INITIATIVES. or &NOMENCLATURE_PROJECTS. and typically describe work done or to be done. "
    }
    config {
        buildOption: @activity-planning
    }

    region activities-report (
        name: Activities
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ap.id, 
                       ap.project_id,
                       at.activity_type,
                       ap.activity,
                       ap.comments details,
                       ap.start_date,
                       ap.end_date,
                       to_char(ap.start_date,'Day DD-Mon-YYYY')||' to '||to_char(ap.end_date,'Day DD-Mon-YYYY') TIMELINE,
                       ap.end_date - ap.start_date days,
                       round(ap.end_date - sysdate) days_remaining,
                       ap.url,
                       tm.first_name||' '||tm.last_name owner,
                       tm.id team_member_id,
                       decode(ap.private_yn,'Y','Yes','No') private,
                       --
                       --
                       apex_util.get_since(ap.updated) last_updated,
                       (select count(*) from sp_activity_comments 
                         where activity_id = ap.id
                           and (nvl(private_yn,'N') = 'N' or author_id = :APP_USER_ID)) comment_cnt,
                       --
                       -- project related
                       --
                       decode(ap.project_id,null,null,(select project              from sp_projects p where p.id = ap.project_id and p.ARCHIVED_YN = 'N' and p.DUPLICATE_OF_PROJECT_ID is null)) project,
                       decode(ap.project_id,null,null,(select PROJECT_SIZE         from sp_projects p where p.id = ap.project_id and p.ARCHIVED_YN = 'N' and p.DUPLICATE_OF_PROJECT_ID is null)) PROJECT_SIZE,
                       decode(ap.project_id,null,null,(select friendly_identifier  from sp_projects p where p.id = ap.project_id and p.ARCHIVED_YN = 'N' and p.DUPLICATE_OF_PROJECT_ID is null)) friendly_identifier,
                       decode(ap.project_id,null,null,(select PROJECT_URL_NAME     from sp_projects p where p.id = ap.project_id and p.ARCHIVED_YN = 'N' and p.DUPLICATE_OF_PROJECT_ID is null)) PROJECT_URL_NAME,
                       --
                       -- release
                       --
                       case when ap.project_id is null
                            then null
                            else (select RELEASE_TRAIN||' '||RELEASE
                                    from SP_RELEASE_TRAINS rt 
                                   where rt.id = (select release_id 
                                                    from sp_projects p 
                                                   where p.id = ap.project_id))
                            end release,
                       --
                       -- optional initiative
                       --
                       decode(ap.initiative_id,null,null,
                                               (select initiative from sp_initiatives where id = ap.initiative_id)) initiative,
                       --
                       -- tags
                       --
                       tm.tags team_member_tags,
                       ap.tags activity_tags,
                       decode(ap.project_id,null,null,(select tags from sp_projects p where p.id = ap.project_id and p.ARCHIVED_YN = 'N')) project_tags,
                       --
                       -- timeframe
                       --
                       decode(trunc(sysdate),trunc(ap.end_date),'Current',
                       decode(trunc(sysdate),trunc(ap.start_date),'Current',
                           decode(
                               greatest( trunc(sysdate), ap.start_date ),
                               ap.start_date,
                               'Future',
                               decode(greatest( trunc(sysdate), ap.end_date), ap.end_date, 'Current','Past')))) timeframe,
                       --
                        ap.updated,
                        ap.created
                from sp_activities ap,
                     sp_activity_types at,
                     sp_team_members tm
                where 
                      (nvl(ap.private_yn,'N') = 'N' or ap.team_member_id = :APP_USER_ID) and
                      ap.activity_type_id = at.id and
                      ap.team_member_id = tm.id
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        genAI {
            naturalLanguageSupport: true
            reportContext: All Activities, along with the owner, timeframe and Project and Release, if appropriate.
        }
        actionsMenu {
            flashback: false
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 4022582097328773846
        }

        column ACTIVITY (
            type: link
            heading {
                heading: Activity
            }
            layout {
                sequence: 46
            }
            link {
                target: {
                    page: 140
                    items: {
                        P140_ID: #ID#
                    }
                    clearCache: 140
                    action: resetPagination
                }
                linkText: #ACTIVITY#
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: AB
            }
        )

