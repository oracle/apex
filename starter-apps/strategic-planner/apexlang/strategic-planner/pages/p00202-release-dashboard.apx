    button actions (
        buttonName: actions
        label: Actions
        layout {
            sequence: 10
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: #DEFAULT#
            icon: fa-ellipsis-v
        }
        behavior {
            type: menu
        }

        menu refresh (
            label: Refresh
            layout {
                sequence: 60
            }
            behavior {
                target: {
                    page: 202
                    action: resetPagination
                }
            }
            appearance {
                icon: fa-refresh
            }
        )

        menu release-calendar (
            label: Release Calendar
            layout {
                sequence: 30
            }
            behavior {
                target: {
                    page: 203
                    items: {
                        P203_RELEASE_ID: &P202_RELEASE_ID.
                    }
                    clearCache: 203
                    action: resetPagination
                }
            }
            appearance {
                icon: fa-calendar-o
            }
        )

        menu release-home (
            label: Release Home
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 117
                    items: {
                        P117_RELEASE_ID: &P202_RELEASE_ID.
                    }
                    action: resetPagination
                }
            }
            appearance {
                icon: fa-ship
            }
        )

        menu reset (
            label: Reset
            layout {
                sequence: 70
            }
            behavior {
                target: {
                    page: 202
                    items: {
                        P202_RELEASE_ID: &P202_RELEASE_ID.
                    }
                    clearCache: 202
                    action: resetRegions
                }
            }
            appearance {
                icon: fa-undo-alt
            }
        )

        menu sep1 (
            type: separator
            layout {
                sequence: 20
            }
        )

        menu sep2 (
            type: separator
            layout {
                sequence: 50
            }
        )

        menu view-history (
            label: View History
            layout {
                sequence: 40
            }
            behavior {
                target: {
                    page: 14
                    items: {
                        P14_RELEASE_ID: &P202_RELEASE_ID.
                    }
                    clearCache: 14
                    action: resetPagination
                }
            }
            appearance {
                icon: fa-clock-o
            }
        )

    )

    button up (
        buttonName: UP
        label: Navigate Up
        layout {
            sequence: 20
            region: @breadcrumb
            slot: up
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
            ]
            icon: fa-arrow-up
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 117
                items: {
                    P117_RELEASE_ID: &P202_RELEASE_ID.
                }
                clearCache: 117
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction when-change-focus-area (
        name: when change focus area
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P202_FOCUS_AREA_BY
        }
        clientSideCondition {
            type: item=value
            item: P202_FOCUS_AREA_BY
            value: P
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: region
                region: @fa-by-est-days
            }
            execution {
                sequence: 20
            }
        )

        action native-hide_1 (
            action: hide
            affectedElements {
                selectionType: region
                region: @fa-by-count
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: region
                region: @fa-by-count
            }
            execution {
                sequence: 10
            }
        )

        action native-show_1 (
            action: show
            affectedElements {
                selectionType: region
                region: @fa-by-est-days
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    dynamicAction when-change-merge-by (
        name: when change merge by
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P202_TARGET_COMPLETE_BY
        }
        clientSideCondition {
            type: item=value
            item: P202_TARGET_COMPLETE_BY
            value: M
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: region
                region: @target-complete-by-week
            }
            execution {
                sequence: 20
            }
        )

        action native-hide_1 (
            action: hide
            affectedElements {
                selectionType: region
                region: @target-complete-by-month
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: region
                region: @target-complete-by-month
            }
            execution {
                sequence: 10
            }
        )

        action native-show_1 (
            action: show
            affectedElements {
                selectionType: region
                region: @target-complete-by-week
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    computation p202-release (
        itemName: P202_RELEASE
        execution {
            sequence: 30
            point: beforeHeader
        }
        computation {
            sqlQuery: select release_train||' '||release d from sp_release_trains where id = :P202_RELEASE_ID
        }
    )

)

