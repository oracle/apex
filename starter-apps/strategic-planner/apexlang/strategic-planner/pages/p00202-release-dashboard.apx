    region fa-by-count (
        name: project count
        type: chart
        layout {
            sequence: 30
            parentRegion: @by-focus-area
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--noUI
                t-Region--scrollBody
            ]
        }
        chartAppearance {
            stack: true
            stackLabel: true
        }
        chartLayout {
            height: 400
        }
        performance {
            lazyLoading: true
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(options) {
                
                    options.valueFormats.series = {
                        tooltipLabel: "Priority"
                    };
                
                    options.valueFormats.group = {
                        tooltipLabel: "Focus Area"
                    };
                
                    options.valueFormats.value.tooltipLabel = "&NOMENCLATURE_PROJECT. Count";
                
                    return options;
                }
                ```
        }

        series data (
            name: data
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nvl(f.focus_area,'{None Assigned}') label,
                           'P'||r.priority series, 
                           count(*) value
                      from sp_projects p,
                           sp_release_trains t,
                           sp_project_priorities r,
                           sp_initiative_focus_areas f
                     where t.id = :P202_RELEASE_ID
                       and p.release_id = t.id
                       and nvl(p.archived_yn,'N') = 'N'
                       and p.duplicate_of_project_id is null
                       and p.priority_id = r.id
                       and p.focus_area_id = f.id (+)
                    group by f.focus_area, r.priority
                    order by f.focus_area nulls last
                    ```
            }
            columnMapping {
                seriesName: SERIES
                label: LABEL
                value: VALUE
                labelTooltip: LABEL
            }
        )

        axis x (
            name: x
        )

        axis y (
            name: y
            title: &NOMENCLATURE_PROJECT. Count
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
        )

    )

    region fa-by-est-days (
        name: estimated days
        type: chart
        layout {
            sequence: 40
            parentRegion: @by-focus-area
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--noUI
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            footerText: Weighted count multiplies each &NOMENCLATURE_PROJECT. by the effort in days associated with its identified size.
        }
        chartAppearance {
            stack: true
            stackLabel: true
        }
        chartLayout {
            height: 400
        }
        performance {
            lazyLoading: true
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(options) {
                
                    options.valueFormats.series = {
                        tooltipLabel: "Priority"
                    };
                
                    options.valueFormats.group = {
                        tooltipLabel: "Focus Area"
                    };
                
                    options.valueFormats.value.tooltipLabel = "Estimated Effort in Days";
                
                    return options;
                }
                ```
        }

        series data (
            name: data
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select label, series, sum(effort_days) value
                      from
                    (
                    with min_size as
                        (select min(effort_days) min_days
                           from sp_project_sizes
                          where include_yn = 'Y')
                    select f.focus_area,
                           nvl(f.focus_area,'{None Assigned}') label,
                           'P'||r.priority series, 
                           nvl(s.effort_days,m.min_days) effort_days
                      from sp_projects p,
                           sp_release_trains t,
                           sp_project_priorities r,
                           sp_initiative_focus_areas f,
                           sp_project_sizes s,
                           min_size m
                     where t.id = :P202_RELEASE_ID
                       and p.release_id = t.id
                       and nvl(p.archived_yn,'N') = 'N'
                       and p.duplicate_of_project_id is null
                       and p.priority_id = r.id
                       and p.project_size = s.project_size (+)
                       and p.focus_area_id = f.id (+)
                    )
                    group by focus_area, label, series
                    order by focus_area nulls last
                    ```
            }
            columnMapping {
                seriesName: SERIES
                label: LABEL
                value: VALUE
                labelTooltip: LABEL
            }
        )

        axis x (
            name: x
        )

        axis y (
            name: y
            title: Estimated Days
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
        )

    )

