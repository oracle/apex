    region comment-report (
        name: Comment Report
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pc.ID,
                       -- Display Columns
                       tm.initials user_icon,
                       apex_util.get_since(pc.created) comment_date,
                       tm.first_name || ' ' || tm.last_name user_name,
                       --
                       pc.comment_nbr,
                       pc.body_html comment_text,
                       null actions,
                       decode(pc.private_yn,null,null,'N',null,'Y',' Private Comment') private_comment_label,
                       ' ' attribute_1,
                       ' ' attribute_2,
                       ' ' attribute_3,
                       ' ' attribute_4,
                       'u-color-'||ora_hash(pc.created_by,45) icon_modifier,
                
                       -- Data Columns
                       pc.BODY,
                       pc.BODY_HTML,
                       --
                       pc.CREATED,
                       pc.CREATED_BY,
                       pc.UPDATED,
                       pc.UPDATED_BY,
                       tm.id team_member_id
                  from SP_ACTIVITY_COMMENTS pc, 
                       sp_team_members tm
                where pc.author_id = tm.id (+)
                  and pc.activity_id = :P140_ID
                  and (nvl(pc.private_yn,'N') = 'N' or lower(pc.created_by) = lower(:app_user) )
                order by created desc
                ```
        }
        layout {
            sequence: 50
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: COMMENTS
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/comments
            templateOptions: [
                #DEFAULT#
                t-Comments--chat
            ]
        }
        messages {
            whenNoDataFound: No Comments
        }

        column ACTIONS (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Actions
                alignment: center
            }
            layout {
                sequence: 170
            }
            sorting {
                sortable: false
