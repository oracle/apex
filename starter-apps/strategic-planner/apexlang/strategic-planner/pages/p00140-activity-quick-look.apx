            type: hidden
            layout {
                sequence: 110
            }
        )

        column UPDATED_BY (
            reportColumnQueryId: 19
            derivedColumn: N
            heading {
                heading: Updated By
                alignment: center
            }
            layout {
                sequence: 120
            }
            sorting {
                sortable: false
            }
        )

        column USER_ICON (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: User Icon
                alignment: center
            }
            layout {
                sequence: 130
            }
            sorting {
                sortable: false
            }
        )

        column USER_NAME (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: User Name
                alignment: center
            }
            layout {
                sequence: 150
            }
            columnFormatting {
                htmlExpression: Comment #COMMENT_NBR#, #USER_NAME#
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P140_ID (
        type: hidden
        layout {
            sequence: 10
            region: @activity
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            restrictedChars: alphanumWithSpace
        }
    )

    button close (
        buttonName: Close
        label: Close
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button details (
        buttonName: Details
        label: View Details
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-package
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 129
                items: {
                    P129_ACTIVITY_ID: &P140_ID.
                }
                clearCache: 129
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction close (
        name: close
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @close
        }

        action native-dialog-close (
            action: closeDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

