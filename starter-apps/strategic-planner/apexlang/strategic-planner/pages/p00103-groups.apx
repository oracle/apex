page 103 (
    name: Groups
    alias: GROUPS
    title: Groups
    pageGroup: @groups
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    help {
        helpText: Groups defined to group &NOMENCLATURE_USERS. together.  Each &NOMENCLATURE_USER. in the group is identified as full or part time and each group can have members identified as a Leader of that group (there can be more than one).  This allows viewing all the &NOMENCLATURE_PROJECTS. assigned to a group.
    }
    config {
        buildOption: @groups
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
            cssClasses: has-header-actions
        }
    )

    region groups (
        name: Groups
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select g.ID,
                       g.GROUP_NAME,
                       g.DESCRIPTION,
                       g.group_tag,
                       --
                       -- tracking columns
                       --
                       g.CREATED,
                       g.CREATED_BY,
                       g.UPDATED,
                       g.UPDATED_BY,
                       --
                       -- members
                       --
                       (select count(*) 
                       from SP_GROUP_MEMBERS gm, 
                            SP_TEAM_MEMBERS tm 
                       where tm.id = gm.TEAM_MEMBER_ID and 
                             gm.group_id = g.id and 
                             nvl(tm.IS_CURRENT_YN,'Y') = 'Y') group_members,
                       --
                       -- full time
                       --
                       (select count(*) 
                        from SP_GROUP_MEMBERS gm, 
                             SP_TEAM_MEMBERS tm 
                        where tm.id = TEAM_MEMBER_ID and 
                              gm.group_id = g.id and 
                              gm.full_time_yn = 'Y' and 
                              tm.IS_CURRENT_YN = 'Y') full_time,
                       --
                       -- laeders
                       --
                       (select count(*) 
                        from SP_GROUP_MEMBERS gm, 
                             SP_TEAM_MEMBERS tm 
                        where tm.id = TEAM_MEMBER_ID and 
                              gm.group_id = g.id and 
                              gm.group_leader_yn = 'Y' and 
                              tm.IS_CURRENT_YN = 'Y') group_Leaders
                  from SP_GROUPS g
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 150
                items: {
                    P150_ID: \#ID#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            authorizationScheme: @contribution-rights
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 8987502047894338702
        }

        column CREATED (
            type: plainText
            heading {
                heading: Created
            }
            layout {
                sequence: 5
            }
            appearance {
                formatMask: SINCE
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: E
            }
        )

        column CREATED_BY (
            type: plainText
            heading {
                heading: Created By
            }
            layout {
                sequence: 6
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column DESCRIPTION (
            type: plainText
            heading {
                heading: Description
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column FULL_TIME (
            type: plainText
            heading {
                heading: Full Time
                alignment: end
            }
            layout {
