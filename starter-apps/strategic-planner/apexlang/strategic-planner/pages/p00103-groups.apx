        )

        column GROUP_NAME (
            type: link
            heading {
                heading: Group Name
            }
            layout {
                sequence: 2
            }
            link {
                target: {
                    page: 151
                    items: {
                        P151_GROUP_ID: #ID#
                    }
                    action: resetPagination
                }
                linkText: #GROUP_NAME#
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column GROUP_TAG (
            type: plainText
            heading {
                heading: Group Tag
            }
            layout {
