            }
            advanced {
                endUserAlias: G
            }
        )

        column UPDATED_BY (
            type: plainText
            heading {
                heading: Updated By
            }
            layout {
                sequence: 8
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Groups
        }

        savedReport 89875274 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100
            }

            displayColumn FULL_TIME (
                sequence: 4
            )

            displayColumn GROUP_LEADERS (
                sequence: 5
            )

            displayColumn GROUP_MEMBERS (
                sequence: 3
            )

            displayColumn GROUP_NAME (
