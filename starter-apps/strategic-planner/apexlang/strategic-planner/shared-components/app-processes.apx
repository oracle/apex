appProcess get-doc-links (
    name: get_doc_links
    source {
        plsqlCode:
            ```plsql
            sys.htp.p (
                sp_comment_util.get_doc_links (
                    p_search          => apex_application.g_x01,
                    p_scope           => apex_application.g_x02,
                    p_object_id       => apex_application.g_x03 ) );
            ```
    }
    execution {
        sequence: 1
        point: ajaxCallback
    }
    security {
        authorizationScheme: mustNotBePublicUser
    }
)

appProcess get-edit-project-url (
    name: get_edit_project_url
    source {
        plsqlCode:
            ```plsql
            DECLARE
              l_url VARCHAR2(32767);
            BEGIN
              l_url := apex_util.prepare_url(
                         apex_page.get_url(
                           p_page        => 24,
                           p_clear_cache => '24',
                           p_items       => 'P24_ID',
                           p_values      => :P3_PROJECT_ID
                         )
                       );
            
              apex_json.initialize_clob_output;
              apex_json.open_object;
              apex_json.write('url', l_url);
              apex_json.close_object;
              htp.p(apex_json.get_clob_output);
              apex_json.free_output;
            END;
            ```
    }
    execution {
        sequence: 1
        point: ajaxCallback
    }
    security {
        authorizationScheme: mustNotBePublicUser
    }
)

