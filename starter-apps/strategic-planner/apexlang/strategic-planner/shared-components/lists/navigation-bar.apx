list navigation-bar (
    name: Navigation Bar

    entry about-this-app (
        label: About this App
        icon {
            imageIconCssClasses: fa-info
        }
        layout {
            sequence: 50
            parentEntry: @app-user-first-name
        }
        link {
            target: {
                page: 10820
            }
        }
        config {
            buildOption: @about-page
        }
    )

    entry administration (
        label: Administration
        icon {
            imageIconCssClasses: fa-users
        }
        layout {
            sequence: 75
            parentEntry: @app-user-first-name
        }
        link {
            target: {
                page: 10000
                action: resetPagination
            }
        }
        security {
            authorizationScheme: @administration-rights
        }
    )

    entry alerts (
        label: Alerts
        icon {
            imageIconCssClasses: fa-bell
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 2
                clearCache: 2
            }
        }
        userDefinedAttributes {
            2: icon-only
            4: Alerts
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from sp_team_member_notifications
                 where team_member_id = :APP_USER_ID
                   and dismissed_yn = 'N'
                   and instr(':'||notification_pref||':',':APP:') > 0
                ```
        }
    )

    entry app-user-first-name (
        label: &APP_USER_FIRST_NAME.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
    )

    entry approval-requests (
        label: Approval Requests
        icon {
            imageIconCssClasses: fa-workflow
        }
        layout {
            sequence: 15
        }
        link {
            target: {
                page: 132
            }
        }
        userDefinedAttributes {
            2: icon-only
            4: Approval Requests
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                :APPROVALS_PENDING_CNT > 0 or
                :APPROVALS_MORE_INFO_CNT > 0
                ```
        }
        config {
            buildOption: @approvals
        }
    )

    entry feedback (
        label: Feedback
        icon {
            imageIconCssClasses: fa-comment-o
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 12120
                items: {
                    P12120_PAGE_ID: &APP_PAGE_ID.
                }
                clearCache: 12120
            }
        }
        userDefinedAttributes {
            2: icon-only
        }
        serverSideCondition {
            type: expression
            plsqlExpression: apex_util.feedback_enabled
        }
        security {
            authorizationScheme: @reader-rights
        }
        config {
            buildOption: @feedback
        }
    )

    entry list_item (
        label: ---
        layout {
            sequence: 45
            parentEntry: @app-user-first-name
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
    )

    entry list_item-2 (
        label: ---
        layout {
            sequence: 5
            parentEntry: @app-user-first-name
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
    )

    entry list_item-3 (
        label: ---
        layout {
            sequence: 78
            parentEntry: @app-user-first-name
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
    )

    entry my-activities (
        label: My Activities
        icon {
            imageIconCssClasses: fa-badge-check
        }
        layout {
            sequence: 4
            parentEntry: @app-user-first-name
        }
        link {
            target: {
                page: 102
                items: {
                    P102_PERSON: I&APP_USER_FIRST_LAST_NAME.
                }
                clearCache: 102
            }
        }
        config {
            buildOption: @activity-planning
        }
    )

    entry my-approval-configuration (
        label: My Approval Configuration
        icon {
            imageIconCssClasses: fa-workflow
        }
        layout {
            sequence: 17
            parentEntry: @app-user-first-name
        }
        link {
            target: {
                page: 147
                clearCache: 147
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from sp_initiative_approval_chain c,
                       sp_initiative_approvals a
                 where a.id = c.initiative_approval_id
                   and c.team_member_id = :APP_USER_ID
                   and a.active_yn = 'Y'
                ```
        }
        config {
            buildOption: @approvals
        }
    )

    entry my-favorite-nomenclature-projects (
        label: My Favorite &NOMENCLATURE_PROJECTS.
        icon {
            imageIconCssClasses: fa-heart
        }
        layout {
            sequence: 2
            parentEntry: @app-user-first-name
        }
        link {
            target: {
                page: 23
                items: {
                    P23_FAVORITE: Yes
                }
                clearCache: 23
            }
        }
    )

    entry my-nomenclature-projects (
        label: My &NOMENCLATURE_PROJECTS.
        icon {
            imageIconCssClasses: fa-package
        }
        layout {
            sequence: 1
            parentEntry: @app-user-first-name
        }
        link {
            target: {
                page: 113
                clearCache: 113
            }
        }
    )

    entry my-profile (
        label: My Profile
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 12
            parentEntry: @app-user-first-name
        }
        link {
            target: {
                page: 5
                items: {
                    P5_ID: &APP_USER_ID.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            type: itemIsNotNull
            item: APP_USER_ID
        }
    )

    entry my-subscriptions (
        label: My Subscriptions
        icon {
            imageIconCssClasses: fa-sliders
        }
        layout {
            sequence: 15
            parentEntry: @app-user-first-name
        }
        link {
            target: {
                page: 139
                clearCache: 139
            }
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                :APP_USER_ID is not null and
                apex_util.get_build_option_status (
                    p_application_id    => :APP_ID,
                    p_build_option_name => 'Email Configured') = 'INCLUDE' and
                apex_util.get_build_option_status (
                    p_application_id    => :APP_ID,
                    p_build_option_name => 'Subscriptions') = 'INCLUDE'
                ```
        }
    )

    entry my-tasks (
        label: My Tasks
        icon {
            imageIconCssClasses: fa-clipboard-list
        }
        layout {
            sequence: 3
            parentEntry: @app-user-first-name
        }
        link {
            target: {
                page: 65
                items: {
                    IR_ASSIGNED_TO_OWNER_ID: " &APP_USER_ID."
                }
                clearCache: [
                    65
                    CIR
                    RIR
                ]
            }
        }
    )

    entry recent-projects (
        label: Recent Projects
        icon {
            imageIconCssClasses: fa-folder-clock
        }
        layout {
            sequence: 1
            subentriesList: @recent-projects
        }
        userDefinedAttributes {
            2: icon-only
            4: Recent Projects
        }
    )

    entry sign-out (
        label: Sign Out
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 90
            parentEntry: @app-user-first-name
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
    )

)

