list feedback (
    name: Feedback
    config {
        buildOption: @feedback
    }

    entry user-feedback (
        label: User Feedback
        icon {
            imageIconCssClasses: fa-comment-o
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 12123
                clearCache: 12123
            }
        }
        userDefinedAttributes {
            1: Report of all feedback submitted by application users
        }
    )

)

