appComputation app-sysdate (
    itemName: APP_SYSDATE
    execution {
        sequence: 20
        point: afterAuthentication
    }
    computation {
        type: functionBody
        plsqlFunctionBody:
            ```plsql
            declare
                l_systimestamp  timestamp with local time zone  := trunc(systimestamp at time zone 'UTC');
            begin
                for c1 in (
                    select systimestamp at time zone timezone user_sysdate
                      from sp_team_members
                     where email = lower(:APP_USER)
                       and timezone is not null
                ) loop
                    l_systimestamp := c1.user_sysdate;
                end loop;
            
                return to_char(l_systimestamp, 'DD-MON-YYYY');
            end;
            ```
    }
)

appComputation app-sysdate-2 (
    itemName: APP_SYSDATE
    execution {
        sequence: 20
        point: beforeHeader
    }
    computation {
        type: functionBody
        plsqlFunctionBody:
            ```plsql
            declare
                l_systimestamp  timestamp with local time zone  := trunc(systimestamp at time zone 'UTC');
            begin
                for c1 in (
                    select systimestamp at time zone timezone user_sysdate
                      from sp_team_members
                     where email = lower(:APP_USER)
                       and timezone is not null
                ) loop
                    l_systimestamp := c1.user_sysdate;
                end loop;
            
                return to_char(l_systimestamp, 'DD-MON-YYYY');
            end;
            ```
    }
    serverSideCondition {
        type: currentPage=page
        page: 1
    }
)

appComputation app-user-first-last-name (
    itemName: APP_USER_FIRST_LAST_NAME
    execution {
        sequence: 20
        point: beforeHeader
    }
    computation {
        type: sqlQuerySingleValue
        sqlQuery:
            ```sql
            select first_name||' '||last_name 
              from sp_team_members 
             where id = :APP_USER_ID
            ```
    }
    serverSideCondition {
        type: expression
        plsqlExpression:
            ```plsql
            :APP_USER_ID is not null and
            :APP_USER_FIRST_LAST_NAME is null
            ```
    }
)

appComputation app-user-first-name (
    itemName: APP_USER_FIRST_NAME
    execution {
        sequence: 20
        point: beforeHeader
    }
    computation {
        type: functionBody
        plsqlFunctionBody:
            ```plsql
            for c1 in (
                select first_name
                  from sp_team_members 
                 where id = :APP_USER_ID
                   and first_name is not null
            ) loop
                return c1.first_name;
            end loop;
            -- in case user is not in team_members (or first name is null)
            return lower(:APP_USER);
            ```
    }
    serverSideCondition {
        type: expression
        plsqlExpression: :APP_USER_ID is not null and :APP_USER_FIRST_NAME is null
    }
)

appComputation app-user-id (
    itemName: APP_USER_ID
    execution {
        sequence: 1
        point: beforeHeader
    }
    computation {
        type: sqlQuerySingleValue
        sqlQuery: select id from sp_team_members t where t.email = lower(:APP_USER)
    }
    serverSideCondition {
        type: itemIsNull
        item: APP_USER_ID
    }
)

appComputation approvals-more-info-cnt (
    itemName: APPROVALS_MORE_INFO_CNT
    execution {
        sequence: 10
        point: beforeHeader
    }
    computation {
        type: functionBody
        plsqlFunctionBody: return sp_approvals.more_info_pending_cnt (p_team_member_id => :APP_USER_ID);
    }
    serverSideCondition {
        type: itemIsNotNull
        item: APP_USER_ID
    }
    config {
        buildOption: @approvals
    }
)

