appComputation complete-task-status-ids (
    itemName: COMPLETE_TASK_STATUS_IDS
    execution {
        sequence: 10
    }
    computation {
        type: sqlQuerySingleValue
        sqlQuery:
            ```sql
            select ':'||listagg(id, ':' on overflow truncate '' without count)||':'
              from sp_task_statuses
             where indicates_complete_yn = 'Y'
            ```
    }
    comments {
        comments: should never have enough task statuses to need the overflow, but in place to avoid error - just in case
    }
)

appComputation home-page-display (
    itemName: HOME_PAGE_DISPLAY
    execution {
        sequence: 10
        point: beforeHeader
    }
    computation {
        type: functionBody
        plsqlFunctionBody:
            ```plsql
            declare
                l_display  varchar2(255) := ':ACT:INIT:PROJ:REL:';
            begin
                for c1 in (
                    select ':'||
                           case when hp_my_activities_yn = 'Y' then 'ACT:' end ||
                           case when hp_my_initiatives_yn = 'Y' then 'INIT:' end ||
                           case when hp_my_projects_yn = 'Y' then 'PROJ:' end ||
                           case when hp_my_fav_projects_yn = 'Y' then 'FAV:' end ||
                           case when hp_my_open_releases_yn = 'Y' then 'REL:' end display
                      from sp_team_members
                     where id = :APP_USER_ID
                ) loop
                    l_display := c1.display;
                end loop;
            
                return l_display;
            end;
            ```
    }
    serverSideCondition {
        type: itemIsNull
        item: HOME_PAGE_DISPLAY
    }
)

appComputation is-admin (
    itemName: IS_ADMIN
    execution {
        sequence: 10
        point: afterAuthentication
    }
    computation {
        type: functionBody
        plsqlFunctionBody:
            ```plsql
            if APEX_AUTHORIZATION.IS_AUTHORIZED (p_authorization_name => 'Administration Rights') then
               return 'Y';
            else return 'N';
            end if;
            ```
    }
)

