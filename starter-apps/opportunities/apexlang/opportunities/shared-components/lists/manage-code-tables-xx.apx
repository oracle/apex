list manage-code-tables-xx (
    name: Manage Code Tables XX

    entry agreement-types (
        label: Agreement Types
        icon {
            imageIconCssClasses: fa-handshake-o
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 58
            }
        }
        userDefinedAttributes {
            1: Manage the various agreement types that will be used throughout the application.
        }
        security {
            authorizationScheme: @administration-rights
        }
        config {
            buildOption: @agreements
        }
    )

    entry agreements (
        label: Agreements
        icon {
            imageIconCssClasses: fa-handshake-o
        }
