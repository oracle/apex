list p120-actions (
    name: p120_actions

    entry add-question (
        label: Add Question
        icon {
            imageIconCssClasses: fa-plus
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 112
                items: {
                    P112_SESSION_ID: &P120_SESSION_ID.
                }
                clearCache: 112
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from qask_sessions
                 where id = :P120_SESSION_ID
                   and session_status = 'STAGED'
                   and owner = lower(:APP_USER)
                ```
        }
    )

    entry copy-session (
        label: Copy Session
        icon {
            imageIconCssClasses: fa-copy
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 115
                items: {
                    P115_ID: &P120_SESSION_ID.
                }
                clearCache: 115
            }
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                  from qask_sessions
                 where id = :P120_SESSION_ID
                   and session_status in ('STAGED','CLOSED')
                   and owner = lower(:APP_USER)
                ```
        }
    )

    entry delete-session (
        label: Delete Session
        icon {
            imageIconCssClasses: fa-trash-o
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 116
                items: {
                    P116_SESSION_ID: &P120_SESSION_ID.
                }
                clearCache: 116
            }
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                qask_util.get_session_status(p_session_id => :P120_SESSION_ID) in ('STAGED','CLOSED') and
                qask_util.get_session_owner(p_session_id => :P120_SESSION_ID) = :APP_USER
                ```
        }
    )

)

