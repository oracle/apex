list navigation-bar (
    name: Navigation Bar

    entry about (
        label: About
        icon {
            imageIconCssClasses: fa-info-circle-o
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 10
            }
        }
        serverSideCondition {
            type: userIsPublicUser
        }
    )

    entry about-2 (
        label: About
        icon {
            imageIconCssClasses: fa-info-circle-o
        }
        layout {
            sequence: 40
            parentEntry: @app-user
        }
        link {
            target: {
                page: 10
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry administration (
        label: Administration
        icon {
            imageIconCssClasses: fa-wrench
        }
        layout {
            sequence: 50
            parentEntry: @app-user
        }
        link {
            target: {
                page: 10000
            }
        }
        security {
            authorizationScheme: @administrator
        }
    )

    entry app-user (
        label: &APP_USER.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry list_item (
        label: ---
        layout {
            sequence: 30
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry sign-out (
        label: Sign Out
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 70
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

)

