lov active-and-staged-poles (
    name: ACTIVE AND STAGED POLES
    source {
        type: legacySqlQuery
        sqlQuery:
            ```sql
            select
                poll_name dv, 
                id        rv
            from
                eba_qpoll_polls p
            where
                status_id > 1
            order by
                1
            ```
    }
)

