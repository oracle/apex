list code-tables (
    name: Code Tables

    entry build-options (
        label: Build Options
        icon {
            imageIconCssClasses: fa-gear
        }
        layout {
            sequence: 50
        }
        link {
            target: {
                page: 2
                action: resetPagination
            }
        }
        userDefinedAttributes {
            1: Manage the status of build options. Build options allow application functionality to be included or excluded from an application.  Use build options to factor your application.
            2: &P4_BUILD_OPTION_CNT.
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select null
                  from apex_application_build_options
                 where application_id = :APP_ID
                ```
        }
    )

    entry manage-sample-data (
        label: Manage Sample Data
        icon {
            imageIconCssClasses: fa-database
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 32
            }
        }
        userDefinedAttributes {
            1: This application ships with sample data. You can remove or recreate sample data using this administrative page.
        }
    )

    entry notifications (
        label: Notifications
        icon {
            imageIconCssClasses: fa-tag
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 30
            }
        }
        userDefinedAttributes {
            1: Manage notification messages displayed on the home page of this application.  Use notifications to alert application users of important information.
            2: &P4_NOTIFICATION_CNT.
        }
    )

    entry remove-extraneous-characters (
        label: Remove Extraneous Characters
        icon {
            imageIconCssClasses: fa-gear
        }
        layout {
            sequence: 80
        }
        link {
            target: {
                page: 15
                clearCache: 15
            }
        }
        userDefinedAttributes {
            1: Allows the removal of leading, non-displayed characters from Respondent email addresses.
        }
        config {
            buildOption: @enable-scrubbing-respondent-emails
        }
    )

    entry rename-application (
        label: Rename Application
        icon {
            imageIconCssClasses: fa-pencil
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 8
                action: resetPagination
            }
        }
        userDefinedAttributes {
            1: Change the application name, displayed on the top left of each page, to one of your choosing.  By default, the application name is "&APP_NAME.".
        }
    )

    entry theme-style (
        label: Theme Style
        icon {
            imageIconCssClasses: fa-desktop
        }
        layout {
            sequence: 90
        }
        link {
            target: {
                page: 20
                action: resetPagination
            }
        }
        userDefinedAttributes {
            1: Set application user interface theme style for all users.
        }
    )

)

