list navigation-menu (
    name: Navigation Menu

    entry administration (
        label: Administration
        icon {
            imageIconCssClasses: fa-gear
        }
        layout {
            sequence: 80
        }
        isCurrent {
            type: pages
            pages: [
                6
                7
                8
                15
            ]
        }
        link {
            target: {
                page: 15
            }
        }
    )

    entry calendar-and-dynamic-actions (
        label: Calendar and Dynamic Actions
        icon {
            imageIconCssClasses: fa-calendar-check-o
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 50
            }
        }
    )

    entry calendar-and-javascript (
        label: Calendar and Javascript
        icon {
            imageIconCssClasses: fa-code
        }
