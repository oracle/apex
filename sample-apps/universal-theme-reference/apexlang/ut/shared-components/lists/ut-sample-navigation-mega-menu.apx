list ut-sample-navigation-mega-menu (
    name: UT - Sample Navigation Mega Menu

    entry menu-item (
        label: Menu Item 1
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 10
        }
        isCurrent {
            type: never
        }
        link {
            target: {
                type: url
                url: #
            }
        }
    )

    entry menu-item-2 (
        label: Menu Item 2
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 20
        }
        isCurrent {
            type: always
        }
        link {
            target: {
                type: url
                url: #
            }
        }
    )

    entry menu-item-3 (
        label: Menu Item 3
