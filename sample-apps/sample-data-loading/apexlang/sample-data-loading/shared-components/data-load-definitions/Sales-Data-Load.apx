dataLoadDefinition Sales_Data_Load (
    name: Sales Data Load
    target {
        tableName: EBA_DEMO_LOAD_SALES
        loadingMethod: replace
    }
    errorHandling {
        whenOnError: logErrorIntoCollection
        name: SALES_DATA_LOAD_ERR
    }
    advanced {
        commitInterval: 200
    }
    dataProfile {
        name: Sales Data Load
        format: csv
    }
    advanced {
        encoding: iso-8859-1
        csvEnclosedBy: "
    }

    dataProfileColumn country (
        columnName: COUNTRY
        source {
            sequence: 2
            dataType: varchar2
            maxLength: 255
        }
        parsing {
            selector: COUNTRY
        }
    )

    dataProfileColumn item-type (
        columnName: ITEM_TYPE
        source {
            sequence: 3
            dataType: varchar2
            maxLength: 50
        }
        parsing {
            selector: ITEM_TYPE
        }
    )

    dataProfileColumn order-date (
        columnName: ORDER_DATE
        source {
            sequence: 6
            dataType: date
        }
        parsing {
            selector: ORDER_DATE
            formatMask: MM"/"DD"/"RR
            hasTimeZone: false
        }
    )

    dataProfileColumn order-id (
        columnName: ORDER_ID
        source {
            sequence: 7
            dataType: number
        }
        parsing {
            selector: ORDER_ID
        }
    )

    dataProfileColumn order-priority (
        columnName: ORDER_PRIORITY
        source {
            sequence: 5
            dataType: varchar2
            maxLength: 1
        }
        parsing {
            selector: ORDER_PRIORITY
        }
    )

    dataProfileColumn region (
        columnName: REGION
        source {
            sequence: 1
            dataType: varchar2
            maxLength: 255
        }
        parsing {
            selector: REGION
        }
    )

    dataProfileColumn sales-channel (
        columnName: SALES_CHANNEL
        source {
            sequence: 4
            dataType: varchar2
            maxLength: 50
        }
        parsing {
            selector: SALES_CHANNEL
        }
    )

    dataProfileColumn ship-date (
        columnName: SHIP_DATE
        source {
            sequence: 8
            dataType: date
        }
        parsing {
            selector: SHIP_DATE
            formatMask: MM"/"DD"/"RR
            hasTimeZone: false
        }
    )

    dataProfileColumn total-cost (
        columnName: TOTAL_COST
        source {
            sequence: 13
            dataType: number
        }
        parsing {
            selector: TOTAL_COST
            decimalChar: .
        }
    )

    dataProfileColumn total-profit (
        columnName: TOTAL_PROFIT
        source {
            sequence: 14
            dataType: number
        }
        parsing {
            selector: TOTAL_PROFIT
            decimalChar: .
        }
    )

    dataProfileColumn total-revenue (
        columnName: TOTAL_REVENUE
        source {
            sequence: 12
            dataType: number
        }
        parsing {
            selector: TOTAL_REVENUE
            decimalChar: .
        }
    )

    dataProfileColumn unit-cost (
        columnName: UNIT_COST
        source {
            sequence: 11
            dataType: number
        }
        parsing {
            selector: UNIT_COST
            decimalChar: .
        }
    )

    dataProfileColumn unit-price (
        columnName: UNIT_PRICE
        source {
            sequence: 10
            dataType: number
        }
        parsing {
            selector: UNIT_PRICE
            decimalChar: .
        }
    )

    dataProfileColumn units-sold (
        columnName: UNITS_SOLD
        source {
            sequence: 9
            dataType: number
        }
        parsing {
            selector: UNITS_SOLD
        }
    )

)

