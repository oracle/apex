list navigation-menu (
    name: Navigation Menu

    entry administration (
        label: Administration
        icon {
            imageIconCssClasses: fa-gear
        }
        layout {
            sequence: 50
        }
        link {
            target: {
                page: 9
            }
        }
    )

    entry background-load (
        label: Background Load
        icon {
            imageIconCssClasses: fa-clock-o
        }
        layout {
            sequence: 130
            parentEntry: @data-loading
        }
        isCurrent {
            type: pages
            pages: [
                17
                18
            ]
        }
        link {
            target: {
                page: 17
                clearCache: 17
            }
        }
    )

    entry csv-load (
        label: CSV Load
        icon {
            imageIconCssClasses: fa-file-csv
        }
        layout {
            sequence: 100
            parentEntry: @data-loading
        }
        link {
            target: {
                page: 11
                clearCache: 11
            }
        }
    )

    entry data-loading (
        label: Data Loading
        icon {
            imageIconCssClasses: fa-database-arrow-up
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 10
            }
        }
    )

    entry home (
        label: Home
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 10
        }
        isCurrent {
            type: pages
            pages: [
                1
                6
                8
            ]
        }
        link {
            target: {
                page: 1
            }
        }
    )

    entry legacy-data-loading (
        label: Legacy Data Loading
        icon {
            imageIconCssClasses: fa-archive
        }
        layout {
            sequence: 150
            parentEntry: @data-loading
        }
        isCurrent {
            type: pages
            pages: [
                21
                22
                23
                24
            ]
        }
        link {
            target: {
                page: 21
            }
        }
    )

    entry manual-data-loading (
        label: Manual Data Loading
        icon {
            imageIconCssClasses: fa-wrench
        }
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 30
                clearCache: 32
            }
        }
    )

    entry multiple-file-type-load (
        label: Multiple File Type Load
        icon {
            imageIconCssClasses: fa-files-o
        }
        layout {
            sequence: 120
            parentEntry: @data-loading
        }
        isCurrent {
            type: pages
            pages: 16
        }
        link {
            target: {
                page: 16
                clearCache: 16
            }
        }
    )

    entry pl-sql-data-load (
        label: PL/SQL Data Load
        layout {
            sequence: 90
            parentEntry: @manual-data-loading
        }
        link {
            target: {
                page: 32
            }
        }
    )

    entry pl-sql-parser (
        label: PL/SQL Parser
        layout {
            sequence: 80
            parentEntry: @manual-data-loading
        }
        link {
            target: {
                page: 31
            }
        }
    )

    entry reset-data (
        label: Reset Data
        layout {
            sequence: 60
            parentEntry: @administration
        }
        link {
            target: {
                page: 8
            }
        }
    )

    entry theme-style (
        label: Theme Style
        layout {
            sequence: 70
            parentEntry: @administration
        }
        isCurrent {
            type: pages
            pages: 7
        }
        link {
            target: {
                page: 7
            }
        }
    )

    entry transformation-and-lookup (
        label: Transformation and Lookup
        icon {
            imageIconCssClasses: fa-dynamic-content
        }
        layout {
            sequence: 110
            parentEntry: @data-loading
        }
        link {
            target: {
                page: 15
                clearCache: 15
            }
        }
    )

)

