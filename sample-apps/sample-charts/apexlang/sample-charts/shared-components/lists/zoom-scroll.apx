list zoom-scroll (
    name: Zoom & Scroll

    entry line-chart-time-axis-page (
        label: Line Chart (Time Axis) - Page 15
        icon {
            imageIconCssClasses: fa-line-chart
        }
        layout {
            sequence: 15
        }
        link {
            target: {
                page: 15
            }
        }
        userDefinedAttributes {
            1:
                ```
                This example demonstrates:
                a) a Line chart rendering DateTime information on the x-axis, using the Time Axis Type attribute
                b) reset Zoom option - resetting the viewport settings of the chart xAxis
                ```
        }
    )

    entry stock-page (
        label: Stock - Page 7
        icon {
            imageIconCssClasses: fa-stock-chart
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 7
            }
        }
        userDefinedAttributes {
            1: This example demonstrates a Donut chart with custom labels defined
        }
    )

)

