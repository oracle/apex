list chart-links (
    name: Chart Links

    entry linking-to-interactive-grid-bar-chart-series-name-column-mapping-pg (
        label: Linking to Interactive Grid - Bar Chart (Series Name Column Mapping), pg 9
        icon {
            imageIconCssClasses: fa-link
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 9
            }
        }
        userDefinedAttributes {
            1: This example demonstrates linking from a chart to an Interactive Grid, using the Interactive Grid URL Filtering support introduced in APEX 20.1.
        }
    )

    entry linking-to-interactive-grid-pie-pg (
        label: Linking to Interactive Grid - Pie, pg 4
        icon {
            imageIconCssClasses: fa-link
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 4
            }
        }
        userDefinedAttributes {
            1: This example demonstrates linking from a chart to an Interactive Grid, using the Interactive Grid URL Filtering support introduced in APEX 20.1.
        }
    )

    entry master-detail-chart-links-page (
        label: Master Detail Chart Links - Page 4
        icon {
            imageIconCssClasses: fa-link
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 4
            }
        }
        userDefinedAttributes {
            1: This example demonstrates linking from one chart to another chart, using the chart Link attribute.
        }
    )

)

