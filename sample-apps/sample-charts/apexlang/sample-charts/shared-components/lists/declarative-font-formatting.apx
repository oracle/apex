                page: 25
            }
        }
        userDefinedAttributes {
            1: This example demonstrates the styling of the y-axis title
        }
    )

    entry line-chart-declarative-font-formatting-page (
        label: Line Chart ( Declarative Font Formatting ) - Page 15
