list js-customizations (
    name: JS Customizations

    entry area-chart-legend-javascript-code-customization-page (
        label: Area Chart ( Legend JavaScript Code Customization ) - Page 2
        icon {
            imageIconCssClasses: fa-area-chart
        }
        layout {
            sequence: 50
        }
        link {
            target: {
                page: 2
            }
        }
        userDefinedAttributes {
            1: This example demonstrates an Area chart with custom icons used in the legend, based on Static Application Files.
        }
    )

