list formatting-values (
    name: Formatting Values

    entry area-chart-y-axis-value-formatting-page (
        label: Area Chart (Y-Axis Value Formatting) - Page 2
        icon {
            imageIconCssClasses: fa-area-chart
        }
        layout {
            sequence: 15
        }
        link {
            target: {
                page: 2
            }
        }
        userDefinedAttributes {
            1: This example demonstrates an Area chart with numeric formatting of the y-axis values, using the y-axis Format attribute
        }
    )

    entry bar-chart-stacked-percent-page (
        label: Bar Chart (Stacked Percent) - Page 9
        icon {
            imageIconCssClasses: fa-bar-chart
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 9
            }
        }
        userDefinedAttributes {
            1: This example demonstrates a Bar chart with percent formatting applied to the y-axis values, via the y-axis Format attribute
        }
    )

    entry bubble-page (
        label: Bubble - Page 11
        icon {
            imageIconCssClasses: fa-bubble-chart
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 11
            }
        }
        userDefinedAttributes {
            1: This example demonstrates a Bubble chart with percent formatting of the x and y axis values, using their respective axis-level Format attribute
        }
    )

    entry donut-chart-sorting-page (
        label: Donut Chart (Sorting) - Page 4
        icon {
            imageIconCssClasses: fa-donut-chart
        }
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 4
            }
        }
        userDefinedAttributes {
            1: This example demonstrates a Donut chart with decimal formatting of the values, using the chart attribute Format
        }
    )

    entry line-chart-time-axis-page (
        label: Line Chart (Time Axis) - Page 15
        icon {
            imageIconCssClasses: fa-eur
        }
        layout {
            sequence: 70
        }
        link {
            target: {
                page: 15
            }
        }
        userDefinedAttributes {
            1: This example demonstrates a Line chart with currency formatting of the y-axis values, and Date formatting of the x-axis values, using their respective axis-level attribute Format
        }
    )

    entry range-page (
        label: Range - Page 23
        icon {
            imageIconCssClasses: fa-range-chart-bar
        }
        layout {
            sequence: 50
        }
        link {
            target: {
                page: 23
            }
        }
        userDefinedAttributes {
            1: This example demonstrates a Range chart with decimal formatting of the y-axis values, using the y-axis attribute Format
        }
    )

    entry stock-page (
        label: Stock - Page 7
        icon {
            imageIconCssClasses: fa-stock-chart
        }
        layout {
            sequence: 60
        }
        link {
            target: {
                page: 7
            }
        }
        userDefinedAttributes {
            1: This example demonstrates a Stock chart with currency formatting of the y-axis values, and Date formatting of the x-axis values, using their respective axis-level attribute Format
        }
    )

)

