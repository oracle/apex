list navigation-menu (
    name: Navigation Menu

    entry administration (
        label: Administration
        icon {
            imageIconCssClasses: fa-gear
        }
        layout {
            sequence: 110
        }
        link {
            target: {
                page: 17
            }
        }
        security {
            authorizationScheme: mustNotBePublicUser
        }
    )

    entry area (
        label: Area
        icon {
            imageIconCssClasses: fa-area-chart
        }
        layout {
            sequence: 10
        }
        isCurrent {
            type: pages
            pages: 2
        }
        link {
            target: {
                page: 2
            }
        }
    )

    entry bar (
        label: Bar
        icon {
            imageIconCssClasses: fa-bar-chart
        }
