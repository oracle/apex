list y2-axis (
    name: Y2 Axis

    entry bar-chart-dual-y-axis-with-custom-labels-page (
        label: Bar Chart (Dual Y Axis with custom Labels) - Page 9
        icon {
            imageIconCssClasses: fa-bar-chart
        }
        layout {
            sequence: 15
        }
        link {
            target: {
                page: 9
            }
        }
        userDefinedAttributes {
            1: This example demonstrates a Bar Chart with a y2 Axis, and dual-axis setting
        }
    )

    entry line-with-area-chart-data-labels-line-styles-page (
        label: Line with Area Chart (Data Labels & Line Styles) - Page 18
        icon {
            imageIconCssClasses: fa-line-area-chart
        }
        layout {
            sequence: 25
        }
        link {
            target: {
                page: 18
            }
        }
        userDefinedAttributes {
            1: This example demonstrates a Line with Area Chart with a y2 Axis
        }
    )

)

