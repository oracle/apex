list navigation-menu (
    name: Navigation Menu

    entry appraisal-history (
        label: Appraisal History
        icon {
            imageIconCssClasses: fa-server-clock
        }
        layout {
            sequence: 35
        }
        isCurrent {
            type: pages
            pages: 29
        }
        link {
            target: {
                page: 29
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry employees (
        label: Employees
        icon {
            imageIconCssClasses: fa-users-alt
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 8
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry home (
        label: Home
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 1
        }
        link {
            target: {
                page: 1
            }
        }
    )

    entry laptop-order-management (
