lov workflow-console-lov-initiated (
    name: WORKFLOW_CONSOLE.LOV.INITIATED
    source {
        location: staticValues
    }

    entry last-24-hours (
        sequence: 2
        display: Last 24 hours
        return: 1|24
    )

    entry last-30-days (
        sequence: 4
        display: Last 30 days
        return: 168|720
    )

    entry last-7-days (
        sequence: 3
        display: Last 7 days
        return: 24|168
    )

    entry last-hour (
        sequence: 1
        display: Last hour
        return: |1
    )

    entry older-than-30-days (
        sequence: 5
        display: Older than 30 days
        return: 720|
    )

)

