app SAMPLE-FORMS (
    name: Oracle APEX Forms Patterns
    version: 26.2.0
    logo {
        type: text
        text: Oracle APEX Forms Patterns
    }
    navigation {
        homeUrl: {
            page: 10
        }
        loginUrl: {
            page: LOGIN
        }
    }
    navigationMenu {
        listTemplate: @/side-navigation-menu
        templateOptions: [
            #DEFAULT#
            js-defaultCollapsed
            js-navCollapsed--hidden
            t-TreeNav--styleB
        ]
        list: @navigation-menu
    }
    navigationBar {
        list: @navigation-bar
        listTemplate: @/navigation-bar
        templateOptions: #DEFAULT#
    }
    userInterface {
        currentTheme: @universal-theme
        globalPage: 0
        addBuiltWithApexToFooter: false
    }
    appFormatMasks {
        date: DS
        timestamp: DS
        timestampTimeZone: DS
    }
    css {
        fileUrls: #APP_FILES#forms-patterns.css
    }
    authentication {
        scheme: @no-auth
    }
    security {
        embedInFrames: allowSameOrigin
    }
    sessionManagement {
        maxSessionLength: 28800
        maxSessionIdleTime: 3600
    }
    runtime {
        allowFeedback: true
    }
)

