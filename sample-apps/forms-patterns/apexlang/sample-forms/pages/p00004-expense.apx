page 4 (
    name: Expense
    alias: EXPENSE
    title: Expense
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        width: 760
        chained: false
    }
    help {
        helpText:
            ```html
            <h3>When to use</h3>
            <p>Use this drawer to add or edit a child record while retaining the parent report's form context.</p>
            <h3>About this form</h3>
            <p>Select the Expense Report and Category, then enter the Expense Date, Merchant, optional Description, Amount, and Reimbursable choice. The amount uses the parent report's currency: positive values represent expenses, negative values represent refunds, and zero is valid.</p>
            <h3>How the components work together</h3>
            <p>Add Expense passes the current report identifier into the drawer. Native select lists provide report and category lookups. Form Initialization loads an existing line, and Automatic Row Processing saves its fields. The Close Dialog process returns to the report form after a successful save.</p>
            <p>Cancel closes the drawer without saving its edits. Delete asks for confirmation and removes the expense line and its attached receipts. A line saved here remains saved even if you later cancel unsaved edits on the parent report.</p>
            ```
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 30
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region form (
        name: Expense
        type: form
        source {
            location: localDatabase
            tableName: SFM_EXPENSE_REPORT_LINES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
    )

    pageItem P4_AMOUNT (
        type: numberField
        label {
            label: Amount (refunds are negative)
            alignment: left
        }
        settings {
            minValue: -9999999999.99
            maxValue: 9999999999.99
        }
        layout {
            sequence: 70
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            formatMask: FM9G999G999G990D00
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: AMOUNT
            dataType: number
        }
        help {
            helpText: Enter positive expenses, negative refunds, or zero. Use the currency of the parent expense report.
        }
    )

    pageItem P4_CATEGORY_ID (
        type: selectList
        label {
            label: Category
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery: select category_name d, category_id r from sfm_expense_categories order by category_name
            displayExtraValues: false
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 30
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: CATEGORY_ID
            dataType: number
        }
        help {
            helpText: Provide the category for this expense.
        }
    )

    pageItem P4_DESCRIPTION (
        type: textarea
        label {
            label: Description
            alignment: left
        }
        layout {
            sequence: 60
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 80
            height: 6
        }
        validation {
            maxLength: 500
        }
        source {
            formRegion: @form
            column: DESCRIPTION
            dataType: varchar2
        }
        help {
            helpText: Provide the description for this expense.
        }
    )

    pageItem P4_EXPENSE_DATE (
        type: datePicker
        label {
            label: Expense Date
            alignment: left
        }
        layout {
            sequence: 40
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            formatMask: YYYY-MM-DD
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: EXPENSE_DATE
            dataType: date
        }
        help {
            helpText: Provide the expense date for this expense.
        }
    )

    pageItem P4_MERCHANT (
        type: textField
        label {
            label: Merchant
            alignment: left
        }
        layout {
            sequence: 50
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 150
        }
        source {
            formRegion: @form
            column: MERCHANT
            dataType: varchar2
        }
        help {
            helpText: Provide the merchant for this expense.
        }
    )

    pageItem P4_REIMBURSABLE_YN (
        type: selectList
        label {
            label: Reimbursable
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Yes;Y,No;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: REIMBURSABLE_YN
            dataType: varchar2
        }
        default {
            type: static
            staticValue: Y
        }
        help {
            helpText: Provide the reimbursable for this expense.
        }
    )

    pageItem P4_REPORT_ID (
        type: selectList
        label {
            label: Expense Report
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery: select report_title || ' (' || currency_code || ')' d, report_id r from sfm_expense_reports order by report_title
            displayExtraValues: false
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 20
            region: @form
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @form
            column: REPORT_ID
            dataType: number
        }
        help {
            helpText: Provide the expense report for this expense.
        }
    )

    pageItem P4_REPORT_LINE_ID (
        type: hidden
        layout {
            sequence: 10
            region: @form
            slot: regionBody
        }
        source {
            formRegion: @form
            column: REPORT_LINE_ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button apply-changes (
        buttonName: APPLY-CHANGES
        label: Save Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P4_REPORT_LINE_ID
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P4_REPORT_LINE_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--primary
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: Delete this record and its dependent sample records?
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P4_REPORT_LINE_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 731000403
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,APPLY-CHANGES,DELETE
        }
    )

    process initialize (
        name: Initialize Expense
        type: formInitialization
        formRegion: @form
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 731000401
        }
    )

    process save (
        name: Save Expense
        type: formAutoRowProcessing
        formRegion: @form
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Expense saved.
        }
        advanced {
            executionMappingIdentifier: 731000402
        }
    )

)

