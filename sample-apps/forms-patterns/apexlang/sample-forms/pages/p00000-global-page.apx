page 0 (
    name: Global Page

    region help-region (
        name: Help Region
        type: staticContent
        layout {
            sequence: 10
            slot: dialogsDrawersAndPopups
        }
        appearance {
            template: @/inline-popup
            templateOptions: [
                #DEFAULT#
                js-dialog-autoheight
                js-popup-callout
                js-dialog-size600x400
            ]
        }
        advanced {
            customAttributes: data-parent-element="#HELP"
        }
    )

    region help-text (
        name: Help Text
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                declare
                l_text clob;
                begin
                    for c1 in (
                        select help_text
                          from apex_application_pages
                         where page_id        = :APP_PAGE_ID
                           and application_id = :APP_ID )
                    loop
                        if c1.help_text is null then
                            l_text := 'No help is available for this page.';
                        elsif regexp_like(ltrim(c1.help_text), '^<', 'i') then
                            l_text := l_text || apex_application.do_substitutions(c1.help_text);
                        else
                            l_text := l_text || '<p>' || apex_application.do_substitutions(c1.help_text) || '</p>';
                        end if;
                    end loop;
                
                    return l_text;
                end;
                ```
        }
        layout {
            sequence: 20
            parentRegion: @help-region
            slot: regionBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: u-text-body-sm
        }
    )

    button help_1 (
        buttonName: HELP
        label: Help
        layout {
            sequence: 20
            slot: beforeNavigationBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--simple
                t-Button--iconLeft
            ]
            cssClasses: u-color-1
            icon: fa-question-circle-o
        }
        behavior {
            action: triggerAction
        }
        advanced {
            htmlDomId: HELP
        }

        triggerAction native-open-region (
            action: openRegion
            affectedElements {
                selectionType: region
                region: @help-region
            }
            execution {
                sequence: 20
            }
        )

        triggerAction native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @help-text
            }
            execution {
                sequence: 10
            }
        )

    )

)

