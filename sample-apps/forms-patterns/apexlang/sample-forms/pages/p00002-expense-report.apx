            templateOptions: #DEFAULT#
            formatMask: YYYY-MM-DD
        }
        source {
            formRegion: @form
            column: TRAVEL_END
            dataType: date
        }
        help {
            helpText: Choose the last travel date. It cannot be before Travel Start.
        }
    )

    pageItem P2_TRAVEL_START (
        type: datePicker
        label {
            label: Travel Start
            alignment: left
        }
        layout {
            sequence: 160
            region: @trip
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            formatMask: YYYY-MM-DD
        }
        source {
            formRegion: @form
            column: TRAVEL_START
            dataType: date
        }
        help {
            helpText: Optional travel start for this fictional expense report.
        }
    )

    button add-expense (
        buttonName: ADD_EXPENSE
        label: Add Expense
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 4
                items: {
                    P4_REPORT_ID: &P2_REPORT_ID.
                }
                clearCache: 4
            }
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P2_REPORT_ID
        }
    )

    button apply-changes (
        buttonName: APPLY-CHANGES
        label: Save
        layout {
            sequence: 50
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P2_REPORT_ID
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 60
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P2_REPORT_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: Delete this record and its dependent sample records?
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P2_REPORT_ID
        }
    )

    validation travel-dates (
        name: Travel dates in order
        execution {
            sequence: 10
        }
        validation {
            plsqlExpression:
                ```plsql
                :P2_TRAVEL_START is null or :P2_TRAVEL_END is null
                or to_date(:P2_TRAVEL_END,'YYYY-MM-DD') >= to_date(:P2_TRAVEL_START,'YYYY-MM-DD')
                ```
        }
        error {
            errorMessage: Travel End must be on or after Travel Start.
            associatedItem: @P2_TRAVEL_END
        }
    )

    process initialize (
        name: Initialize Expense Report
        type: formInitialization
        formRegion: @form
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 731000201
        }
    )

    process save (
        name: Save Expense Report
        type: formAutoRowProcessing
        formRegion: @form
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Expense Report saved.
        }
        advanced {
            executionMappingIdentifier: 731000202
        }
    )

    branch (
        name: Return to expense reports
        execution {
            sequence: 50
        }
        behavior {
            target: {
                page: 1
                clearCache: 2
            }
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,APPLY-CHANGES,DELETE
        }
    )

)

