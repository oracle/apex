page 2 (
    name: Expense Report
    alias: EXPENSE-REPORT
    title: Expense Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    help {
        helpText:
            ```html
            <h3>When to use</h3>
            <p>Use a full-page form when a record has enough fields to benefit from named sections and more space than a modal provides.</p>
            <h3>About this form</h3>
            <p>The native section selector offers Show All, Report and Employee, Trip Details, Accounting and Approval Contact, and Justification and Reimbursement. The fields demonstrate required text, email and phone inputs, dates, lookup choices, a CLOB-backed justification longer than 32 KB, and signed advances or credits. Travel End must be on or after Travel Start when both dates are provided.</p>
            <h3>How the components work together</h3>
            <ul>
            <li><strong>Form Initialization:</strong> Uses the hidden report identifier to load a record.</li>
            <li><strong>Form region and native items:</strong> Bind fields to the report table and apply their validation settings.</li>
            <li><strong>Automatic Row Processing and a page branch:</strong> Save the record and return to the report list after Create, Save, or Delete.</li>
            </ul>
            <p>Cancel returns without saving report-field edits. Add Expense is available for a saved report and opens a drawer with that report selected. Saving an expense is separate from saving the report; canceling the report does not undo an expense already saved in the drawer.</p>
            <p>Delete requires confirmation and also removes the report's expense lines and receipts. Status and Policy Reviewed are demonstration fields; no approval or payment workflow is executed.</p>
            ```
    }

    region approval (
        name: Justification and Reimbursement
        type: staticContent
        layout {
            sequence: 42
            slot: body
        }
        appearance {
            template: @/content-block
            templateOptions: [
                #DEFAULT#
                t-ContentBlock--h3
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region buttons (
        name: Expense Report
        type: staticContent
        layout {
            sequence: 22
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useRegionTitle
            ]
        }
    )

    region coding (
        name: Accounting and Approval Contact
        type: staticContent
        layout {
            sequence: 32
            slot: body
        }
        appearance {
            template: @/content-block
            templateOptions: [
                #DEFAULT#
                t-ContentBlock--h3
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region form (
        name: Report and Employee
        type: form
        source {
            location: localDatabase
            tableName: SFM_EXPENSE_REPORTS
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/content-block
            templateOptions: [
                #DEFAULT#
                t-ContentBlock--h3
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
        }
    )

    region sections (
        name: Sections
        type: regionDisplaySelector
        layout {
            sequence: 32
            slot: breadcrumbBar
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: rds
        }
    )

    region trip (
        name: Trip Details
        type: staticContent
        layout {
            sequence: 12
            slot: body
        }
        appearance {
            template: @/content-block
            templateOptions: [
                #DEFAULT#
                t-ContentBlock--h3
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P2_ADVANCE_AMOUNT (
        type: numberField
        label {
            label: Advance or Credit
            alignment: left
        }
        settings {
            minValue: -9999999999.99
            maxValue: 9999999999.99
        }
        layout {
            sequence: 190
            region: @approval
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            formatMask: FM9G999G999G990D00
        }
        source {
            formRegion: @form
            column: ADVANCE_AMOUNT
            dataType: number
        }
        help {
            helpText: Enter a positive advance or a negative credit, in the report currency. Zero is valid.
        }
    )

    pageItem P2_BUSINESS_JUSTIFICATION (
        type: textarea
        label {
            label: Business Justification
            alignment: left
        }
        layout {
            sequence: 80
            region: @approval
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 80
            height: 6
        }
        source {
            formRegion: @form
            column: BUSINESS_JUSTIFICATION
            dataType: clob
        }
        sessionState {
            dataType: clob
            storage: session
        }
        help {
            helpText: Explain the business purpose. This CLOB-backed field supports text longer than 32 KB.
        }
    )

