list navigation-menu (
    name: Navigation Menu

    entry advanced (
        label: FP-03 - Advanced Form
        icon {
            imageIconCssClasses: fa-list-alt
        }
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 1
            }
        }
    )

    entry attachment (
        label: FP-02 - Form with Attachment
        icon {
            imageIconCssClasses: fa-paperclip
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 5
            }
        }
    )

    entry grid (
        label: FP-04 - Editable Grid
        icon {
            imageIconCssClasses: fa-table-edit
        }
        layout {
            sequence: 50
        }
        link {
            target: {
                page: 11
            }
        }
    )

    entry home (
        label: Home
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 10
            }
        }
    )

    entry simple (
        label: FP-01 - Simple Form
        icon {
            imageIconCssClasses: fa-edit
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 7
            }
        }
    )

)

