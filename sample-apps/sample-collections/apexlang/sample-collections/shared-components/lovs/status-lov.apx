lov status-lov (
    name: STATUS LOV
    source {
        location: staticValues
    }

    entry deleted (
        sequence: 1
        display: Deleted
        return: D
    )

    entry new (
        sequence: 2
        display: New
        return: N
    )

    entry original (
        sequence: 3
        display: Original
        return: O
    )

    entry updated (
        sequence: 4
        display: Updated
        return: U
    )

)

