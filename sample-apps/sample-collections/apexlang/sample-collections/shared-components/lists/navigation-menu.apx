list navigation-menu (
    name: Navigation Menu

    entry administration (
        label: Administration
        icon {
            imageIconCssClasses: fa-gear
        }
        layout {
            sequence: 19
        }
        isCurrent {
            type: pages
            pages: [
                5
                35
                36
                39
            ]
        }
        link {
            target: {
                page: 35
            }
        }
    )

    entry api-examples (
        label: API Examples
        icon {
            imageIconCssClasses: fa-keyboard-o
        }
        layout {
            sequence: 9
        }
        isCurrent {
            type: pages
            pages: 12
        }
        link {
            target: {
                page: 12
            }
        }
    )

    entry basic-collections (
        label: Basic Collections
        icon {
            imageIconCssClasses: fa-archive
        }
        layout {
            sequence: 2
        }
        isCurrent {
            type: pages
            pages: [
                1
                3
            ]
        }
        link {
            target: {
                page: 1
            }
        }
    )

    entry data-synchronization (
        label: Data Synchronization
        icon {
            imageIconCssClasses: fa-spinner
        }
        layout {
            sequence: 6
        }
        isCurrent {
            type: pages
            pages: [
                6
                7
            ]
        }
        link {
            target: {
                page: 6
            }
        }
    )

    entry home (
        label: Home
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 1
        }
        isCurrent {
            type: pages
            pages: [
                8
                100
            ]
        }
        link {
            target: {
                page: 100
            }
        }
    )

)

