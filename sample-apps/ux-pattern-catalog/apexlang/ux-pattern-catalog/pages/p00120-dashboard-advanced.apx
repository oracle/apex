    region content-row (
        name: Status List
        type: themeTemplateComponent/contentRow
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select *
                from (
                    select
                        level as seq,
                        case mod(level - 1, 5)
                            when 0 then 'Task'
                            when 1 then 'Document'
                            when 2 then 'Approval'
                            when 3 then 'Dataset'
                            else 'Configuration'
                        end as overline,
                        'Dashboard Item ' || level as title,
                        'Representative workflow item ' || level as description,
                        case mod(level - 1, 5)
                            when 0 then 'fa-clipboard-list'
                            when 1 then 'fa-file-text-o'
                            when 2 then 'fa-user-check'
                            when 3 then 'fa-database'
                            else 'fa-cogs'
                        end as icon,
                        case mod(level - 1, 5)
                            when 0 then 'Complete'
                            when 1 then 'In Progress'
                            when 2 then 'Needs Review'
                            when 3 then 'Available'
                            else 'Updated'
                        end as badge,
                        case mod(level - 1, 5)
                            when 0 then 'success'
                            when 1 then 'warning'
                            when 2 then 'danger'
                            when 3 then 'info'
                            else 'success'
                        end as badge_state,
                        null as badge_icon
                    from dual
                    connect by level <= 7
                )
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        comments {
            comments:
                ```
                Intent: Shows a prioritized set of operational or workflow items that support the dashboard summary.
                Pattern role: Supporting status list.
                AI guidance: Keep rows concise and scannable. Use badges only when status needs to be visible at a glance, and keep badge value, state, and icon semantically aligned.
                ```
        }
        componentAppearance {
            display: report
        }
        settings {
            overline: &OVERLINE.
            title: &TITLE.
            displayAvatar: true
            displayBadge: true
        }
        plugin-avatar {
            icon: &ICON. fa-lg
            shape: noShape
        }
        plugin-badge {
            label: Badge
            value: BADGE
            state: BADGE_STATE
            style: subtle
            columnWidth: auto
            position: end
            alignment: center
        }
        plugin-appearance {
            applyThemeColors: false
        }

        column BADGE (
            layout {
                sequence: 50
            }
            source {
                databaseColumn: BADGE
                dataType: varchar2
            }
        )

        column BADGE_ICON (
            layout {
                sequence: 70
            }
            source {
                databaseColumn: BADGE_ICON
                dataType: varchar2
            }
        )

        column BADGE_STATE (
            layout {
                sequence: 60
            }
            source {
                databaseColumn: BADGE_STATE
                dataType: varchar2
            }
        )

        column DESCRIPTION (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: DESCRIPTION
                dataType: varchar2
            }
        )

        column ICON (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: ICON
                dataType: varchar2
            }
        )

        column OVERLINE (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: OVERLINE
                dataType: varchar2
            }
        )

        column SEQ (
            layout {
                sequence: 80
            }
            source {
                databaseColumn: SEQ
                dataType: number
            }
        )

        column TITLE (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: TITLE
                dataType: varchar2
            }
        )

    )

    region content-row-2 (
        name: Section Summary
        type: themeTemplateComponent/contentRow
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select *
                from (
                    select
                        level as seq,
                        'Section ' || level as title,
                        case mod(level - 1, 5)
                            when 0 then 'Trend overview'
                            when 1 then 'Data snapshot'
                            when 2 then 'Team summary'
                            when 3 then 'Review status'
                            else 'System settings'
                        end as description,
                        case mod(level - 1, 5)
                            when 0 then 'fa-line-chart'
                            when 1 then 'fa-database'
                            when 2 then 'fa-users'
                            when 3 then 'fa-shield'
                            else 'fa-cogs'
                        end as icon,
                        case mod(level - 1, 5)
                            when 0 then '12 metrics'
                            when 1 then 'Updated 10m ago'
                            when 2 then '4 groups'
                            when 3 then '2 reviews'
                            else '5 settings'
                        end as meta,
                        null as badge,
                        null as badge_state,
                        null as badge_icon
                    from dual
                    connect by level <= 4
                )
                ```
        }
        layout {
            sequence: 60
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
        }
        comments {
            comments:
                ```
                Intent: Orients users to related sections represented by the advanced dashboard.
                Pattern role: Supporting section summary.
                AI guidance: Use this region for lightweight navigation or context across dashboard areas. Keep descriptions brief and avoid duplicating the status list.
                ```
        }
        componentAppearance {
            display: report
        }
        settings {
            title: &TITLE.
            description: &DESCRIPTION.
            miscellaneous: &META.
            displayAvatar: true
        }
        plugin-avatar {
            icon: &ICON.
            size: extraSmall
        }
        plugin-appearance {
            style: compact
        }

        column BADGE (
            layout {
                sequence: 50
            }
            source {
                databaseColumn: BADGE
                dataType: varchar2
            }
        )

        column BADGE_ICON (
            layout {
                sequence: 70
            }
            source {
                databaseColumn: BADGE_ICON
                dataType: varchar2
            }
        )

        column BADGE_STATE (
            layout {
                sequence: 60
            }
            source {
                databaseColumn: BADGE_STATE
                dataType: varchar2
            }
        )

        column DESCRIPTION (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: DESCRIPTION
                dataType: varchar2
            }
        )

        column ICON (
            layout {
                sequence: 40
