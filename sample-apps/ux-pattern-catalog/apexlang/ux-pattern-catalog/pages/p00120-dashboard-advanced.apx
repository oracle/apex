                    ```sql
                    select 'Series A' label, 30 value from sys.dual
                    union all
                    select 'Series B' label, 20 value from sys.dual
                    union all
                    select 'Series C' label, 34 value from sys.dual
                    union all
                    select 'Series D' label, 6  value from sys.dual
                    order by 1 desc
                    ```
