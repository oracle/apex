        comments {
            comments:
                ```
                Intent: Frames the advanced dashboard and provides the page-level action area.
                Pattern role: Dashboard heading and action container.
                AI guidance: Keep the description short and production-like. Do not use this region for visible pattern documentation.
                ```
        }
    )

    region metric-cards (
        name: Metric Cards
        type: themeTemplateComponent/metricCard
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                    'fa-line-chart'    icon,
                    'Primary KPI'      label,
                    84200              metric_value,
                    'Trend'            badge,
                    '+12%'             badge_value,
                    'success'          badge_state,
                    'fa-trend-up'      badge_icon
                from sys.dual
                union all
                select
                    'fa-bar-chart'     icon,
                    'Secondary KPI'    label,
                    12800              metric_value,
                    'Trend'            badge,
                    '+320 units'       badge_value,
                    'success'          badge_state,
                    'fa-trend-up'      badge_icon
                from sys.dual
                union all
                select
                    'fa-area-chart'    icon,
                    'Trend KPI'        label,
                    64                 metric_value,
                    'Trend'            badge,
                    '20m faster'       badge_value,
                    'success'          badge_state,
                    'fa-trend-up'      badge_icon
                from sys.dual
                union all
                select
                    'fa-dashboard'     icon,
                    'Status KPI'       label,
                    348                metric_value,
                    'Trend'            badge,
                    '-14 items'        badge_value,
                    'danger'           badge_state,
                    'fa-trend-down'    badge_icon
                from sys.dual
                ```
        }
        orderBy {
            type: staticValue
            orderByClause: BADGE_VALUE
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: [
                #DEFAULT#
                margin-bottom-md
            ]
            cssClasses: app-MetricCards
        }
        accessibility {
            landmarkType: region
        }
        comments {
            comments:
                ```
                Intent: Presents the highest-priority dashboard measures for immediate scanning before deeper analysis.
                Pattern role: Primary KPI summary.
                AI guidance: Keep metrics comparable in importance. Badge value, badge state, and badge icon should be semantically aligned. Format key values for quick scanning and avoid turning this region into a dense report.
                Implementation note: The app-MetricCards CSS class scopes page-level CSS to this region.
                ```
        }
        componentAppearance {
            display: report
        }
        settings {
            metric: &METRIC_VALUE.
            metricCssClasses: u-text-subheading-md
            meta: &LABEL.
            layout: 4Columns
        }
        plugin-avatar {
            displayAvatar: true
            icon: &ICON.
            style: subtle
            position: inline
        }
        plugin-badge {
            displayBadge: true
            label: Trend
            value: BADGE_VALUE
            state: BADGE_STATE
            icon: &BADGE_ICON.
            style: subtle
            shape: rounded
        }

        column BADGE (
            layout {
                sequence: 50
            }
            source {
                databaseColumn: BADGE
                dataType: varchar2
            }
        )

        column BADGE_ICON (
            layout {
                sequence: 80
            }
            source {
                databaseColumn: BADGE_ICON
                dataType: varchar2
            }
        )

        column BADGE_STATE (
            layout {
                sequence: 70
            }
            source {
                databaseColumn: BADGE_STATE
                dataType: varchar2
            }
        )

        column BADGE_VALUE (
            layout {
                sequence: 60
            }
            source {
                databaseColumn: BADGE_VALUE
                dataType: varchar2
            }
        )

        column ICON (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: ICON
                dataType: varchar2
            }
        )

        column LABEL (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: LABEL
                dataType: varchar2
            }
        )

        column METRIC_VALUE (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: METRIC_VALUE
                dataType: number
            }
            appearance {
                formatMask: 999G999G999G999G999G999G990
            }
        )

    )

    region metric-cards_1 (
        name: Metric Cards Stacked
        type: themeTemplateComponent/metricCard
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                    'fa-pyramid-chart'     icon,
                    'Adoption'         label,
                    78                 metric_value,
                    'Growth'           badge,
                    '+8.4%'            badge_value,
                    'success'          badge_state,
                    'fa-arrow-up'      badge_icon
                from sys.dual
                union all
                select
                    'fa-random'        icon,
                    'Throughput'       label,
                    1.42               metric_value,
                    'Change'           badge,
                    '+96 items'        badge_value,
                    'success'          badge_state,
                    'fa-arrow-up'      badge_icon
                from sys.dual
                union all
                select
                    'fa-traffic-light-stop' icon,
                    'Latency'          label,
                    32                 metric_value,
                    'Risk'             badge,
                    '14m slower'       badge_value,
                    'danger'           badge_state,
                    'fa-arrow-down'    badge_icon
                from sys.dual
                union all
                select
                    'fa-tasks-alt'          icon,
                    'Open Issues'      label,
                    6                  metric_value,
                    'Watch'            badge,
                    '2 delayed'    badge_value,
                    'danger'           badge_state,
                    'fa-exclamation-circle' badge_icon
                from sys.dual
                ```
        }
        orderBy {
            type: staticValue
            orderByClause: BADGE_VALUE
        }
        layout {
            sequence: 110
            slot: body
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: [
                #DEFAULT#
                margin-bottom-md
            ]
            cssClasses: app-MetricCards
        }
        accessibility {
            landmarkType: region
        }
        comments {
            comments:
                ```
                Intent: Provides a compact secondary KPI set alongside detailed dashboard visuals.
                Pattern role: Secondary KPI summary.
                AI guidance: Use stacked metric cards when space is constrained or when the metrics support a nearby visualization. Keep badge semantics aligned with the represented measure.
                Implementation note: The app-MetricCards CSS class scopes page-level CSS to this region.
                ```
        }
        componentAppearance {
            display: report
        }
        settings {
            metric: &METRIC_VALUE.
            metricCssClasses: u-text-subheading-md
            meta: &LABEL.
            layout: stacked
        }
        plugin-avatar {
            displayAvatar: true
            icon: &ICON.
            style: subtle
            position: inline
        }
        plugin-badge {
            displayBadge: true
            label: Trend
            value: BADGE_VALUE
            state: BADGE_STATE
            icon: &BADGE_ICON.
            style: subtle
            shape: rounded
        }

        column BADGE (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: BADGE
                dataType: varchar2
            }
        )

        column BADGE_ICON (
            layout {
                sequence: 70
            }
            source {
                databaseColumn: BADGE_ICON
                dataType: varchar2
            }
        )

        column BADGE_STATE (
            layout {
                sequence: 60
            }
            source {
                databaseColumn: BADGE_STATE
                dataType: varchar2
            }
        )

        column BADGE_VALUE (
            layout {
                sequence: 50
            }
            source {
                databaseColumn: BADGE_VALUE
                dataType: varchar2
            }
        )

        column ICON (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: ICON
                dataType: varchar2
            }
        )

        column LABEL (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: LABEL
                dataType: varchar2
            }
        )

        column METRIC_VALUE (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: METRIC_VALUE
                dataType: number
            }
            appearance {
                formatMask: 999G999G999G999G999G999G990
            }
        )

    )

    region stock-chart (
        name: Stock Chart
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select *
                from (
                    select
                        trunc(sysdate) - (24 - level) as trade_date,
                        round(100 + (level * 0.8) + (sin(level / 2.3) * 6), 2) as open_value,
                        round(103 + (level * 0.75) + (sin(level / 2.0) * 7), 2) as close_value,
                        round(
                            greatest(
                                100 + (level * 0.8) + (sin(level / 2.3) * 6),
                                103 + (level * 0.75) + (sin(level / 2.0) * 7)
                            ) + 1 + mod(level, 4),
                            2
                        ) as high_value,
                        round(
                            least(
                                100 + (level * 0.8) + (sin(level / 2.3) * 6),
                                103 + (level * 0.75) + (sin(level / 2.0) * 7)
                            ) - 1 - mod(level, 3),
                            2
                        ) as low_value,
                        12000 + (level * 240) + round(abs(sin(level / 1.4)) * 3800) as volume_value
                    from dual
                    connect by level <= 24
                )
                order by trade_date
                ```
        }
        layout {
            sequence: 90
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        config {
            buildOption: @commented-out
        }
        comments {
            comments:
                ```
                Intent: Preserves a specialized financial-style comparison option for advanced dashboard variants.
                Pattern role: Optional specialized chart.
                AI guidance: Use only when open, high, low, close, and volume values are part of the user task. Treat this as an optional specialized dashboard variation, not a default chart for general-purpose dashboards.
                ```
        }
        chart {
            type: stock
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function( options ) {
                
                    options.styleDefaults = $.extend( true, {}, options.styleDefaults, {
                        colors: [
                            'rgba(66, 81, 191, 0.5)',
                            'rgba(95, 185, 181, 0.5)'
                        ]
                    });
                
                    return options;
                }
                ```
        }

        series series-1 (
            name: Series 1
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: TRADE_DATE
                open: OPEN_VALUE
                low: LOW_VALUE
                high: HIGH_VALUE
                close: CLOSE_VALUE
                volume: VOLUME_VALUE
            }
            label {
                show: true
            }
        )

        axis x (
            name: x
            title: X Axis Label
            majorTicks {
                show: false
            }
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Y Axis Label
            value {
                format: decimal
                decimalPlaces: 0
                baselineScaling: min
            }
            majorTicks {
                show: false
            }
            minorTicks {
                show: false
            }
        )

    )

    region time-series (
        name: Time Series
        type: chart
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        comments {
            comments:
                ```
                Intent: Shows how related measures change over a recent period.
                Pattern role: Comparative time-series trend.
                AI guidance: Use for time-based comparison where direction, volatility, and relative movement matter. Keep the series count low and labels readable.
                ```
        }
        chart {
            type: lineWithArea
        }
        chartAppearance {
            stack: true
        }
        chartLayout {
            height: 180
        }
        settings {
            timeAxisType: enabled
            zoomAndScroll: live
        }
        overview {
            show: false
        }
        legend {
            position: bottom
        }

        series series-1 (
            name: Series 1
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select trunc(sysdate) - 23 + (level - 1) as label,
                           round(
                               65
                               + (level * 0.7)
                               + (sin(level / 0.9) * 22)
                               + (cos(level / 1.7) * 15)
                               + case
                                   when level between 3 and 4 then 28
                                   when level between 6 and 8 then -24
                                   when level between 10 and 11 then 34
                                   when level between 13 and 15 then -30
                                   when level between 17 and 19 then 26
                                   when level between 21 and 22 then -22
                                   when level = 24 then 18
                                   else 0
                                 end,
                               1
                           ) as value
                    from sys.dual
                    connect by level <= 48
                    order by label
                    ```
            }
            orderBy {
                type: staticValue
                orderByClause: 1
            }
            columnMapping {
                label: LABEL
                value: VALUE
            }
            appearance {
                color: #3f8efc
            }
            line {
                width: 2
                type: curved
            }
        )

        series series-2 (
            name: Series 2
            execution {
                sequence: 20
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select trunc(sysdate) - 23 + (level - 1) as label,
                           round(
                               65
                               + (level * 0.7)
                               + (sin(level / 0.9) * 22)
                               + (cos(level / 1.7) * 15)
                               + (sin(level * 2.8) * 7)    -- pseudo-random noise
                               + (cos(level * 3.9) * 4)    -- more noise
                               + case
                                   when level between 3 and 4 then 18
                                   when level between 6 and 8 then -14
                                   when level between 10 and 11 then 24
                                   when level between 13 and 15 then -18
                                   when level between 17 and 19 then 16
                                   when level between 21 and 22 then -12
                                   when level = 24 then 10
                                   else 0
                                 end,
                               1
                           ) as value
                    from sys.dual
                    connect by level <= 48
                    order by label;
                    ```
            }
            columnMapping {
                label: LABEL
                value: VALUE
            }
            line {
                style: dashed
                width: 2
                type: curved
            }
        )

        axis x (
            name: x
            value {
                format: dateShort
            }
            majorTicks {
                show: auto
            }
            tickLabel {
                position: inside
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
            }
            majorTicks {
                show: false
            }
            minorTicks {
                show: false
            }
        )

    )

    button actions-menu (
        buttonName: ACTIONS_MENU
        label: Actions Menu
        layout {
            sequence: 40
