                sequence: 10
            }
            source {
                databaseColumn: ITEM_ID
                dataType: number
                primaryKey: true
            }
        )

        column LAST_UPDATED (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: LAST_UPDATED
                dataType: date
            }
            appearance {
                formatMask: SINCE
            }
        )

        column STATUS (
            layout {
                sequence: 60
            }
            source {
                databaseColumn: STATUS
                dataType: varchar2
            }
        )

        column TITLE (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: TITLE
                dataType: varchar2
            }
        )

    )

