    pageItem P1100_SELECTED_ITEM_ID (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @list-selection
            slot: regionBody
        }
        comments {
            comments: Stores the canonical selected-item context used by the detail-region queries. Changes to this item refresh all dependent regions marked with .js-item-refresh.
        }
    )

    pageItem P1100_SELECTED_ITEM_ID_UI (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @list-selection
            slot: regionBody
        }
        comments {
            comments: Stores the current primary-key selection maintained by the Content Row component. Changes to this item are synchronized into P1100_SELECTED_ITEM_ID.
        }
    )

    dynamicAction initialize-selection (
        name: Initialize Selection
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: "apex.region(\"list_selection_region\").setSelectedValues([\"1\"]);"
            }
            execution {
                sequence: 10
            }
        )

    )

)

