            }
            appearance {
                formatMask: SINCE
            }
        )

        column ROW_STATE (
            layout {
                sequence: 130
            }
            source {
                databaseColumn: ROW_STATE
                dataType: varchar2
            }
        )

        column STATUS (
            layout {
                sequence: 140
            }
            source {
                databaseColumn: STATUS
                dataType: varchar2
            }
        )

        column TITLE (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: TITLE
                dataType: varchar2
            }
        )

        action action (
            position: titleLink
            layout {
                sequence: 10
            }
            behavior {
                type: redirectUrl
                targetUrl: #
            }
        )

        action reject (
            position: primaryActions
            template: button
            label: Reject
            layout {
                sequence: 30
            }
            behavior {
                type: redirectUrl
                targetUrl: #
            }
            serverSideCondition {
                type: item=value
                item: ROW_STATE
                value: PENDING_APPROVAL
            }
        )

        action review (
            position: primaryActions
            template: button
            label: Approve
            layout {
                sequence: 20
            }
            behavior {
                type: redirectUrl
                targetUrl: #
            }
            appearance {
                hot: true
            }
            serverSideCondition {
                type: item=value
                item: ROW_STATE
                value: PENDING_APPROVAL
            }
        )

        action review_2 (
            position: primaryActions
            template: button
            label: Review
            layout {
                sequence: 40
            }
            behavior {
                type: redirectUrl
                targetUrl: #
            }
            serverSideCondition {
                type: item=value
                item: ROW_STATE
                value: NEEDS_REVIEW
            }
        )

    )

