    button view-details-popup (
        buttonName: VIEW_DETAILS_POPUP
        label: View Details
        layout {
            sequence: 20
            region: @chart-2
            slot: edit
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: [
                #DEFAULT#
                t-Button--link
            ]
            icon: fa-external-link
        }
        behavior {
            action: redirectUrl
            targetUrl: #
        }
    )

