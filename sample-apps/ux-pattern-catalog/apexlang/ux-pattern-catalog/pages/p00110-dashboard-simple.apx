    region chart-3 (
        name: Pie Chart
        type: chart
        layout {
            sequence: 60
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        comments {
            comments:
                ```
                Intent: Shows a simple proportional breakdown across a small number of categories.
                Pattern role: Part-to-whole summary.
                AI guidance: Use only when there are a few meaningful categories and approximate proportion is more important than precise comparison.
                ```
        }
        chart {
            type: pie
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }

        series series-1 (
            name: Series 1
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select 'Series A' label, 18 value from sys.dual
                    union all
                    select 'Series B' label, 34 value from sys.dual
                    union all
                    select 'Series C' label, 21 value from sys.dual
                    union all
                    select 'Series D' label, 27 value from sys.dual
                    order by 1
                    ```
            }
            orderBy {
                type: staticValue
                orderByClause: 1
            }
            columnMapping {
                label: LABEL
                value: VALUE
            }
            label {
                show: true
            }
            performance {
                maxRowsToProcess: 20
            }
