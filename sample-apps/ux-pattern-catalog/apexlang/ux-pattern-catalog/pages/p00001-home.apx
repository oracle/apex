page 1 (
    name: Home
    alias: HOME
    title: Oracle APEX UX Pattern Catalog
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            ## Purpose
            
            Provide context for the Oracle APEX UX Pattern Catalog and direct users to reusable page patterns organized around common application tasks. This is a catalog landing page, not a pattern to copy.
            
            ## When to Use
            
            Use as the catalog landing page when users need orientation, a starting point, and clear paths to browse the available pattern groups.
            
            ## When to Avoid
            
            Avoid using this structure as a general application dashboard or as a substitute for task-focused navigation.
            
            ## AI Guidance
            
            Preserve the page's pattern-first structure, generic terminology, accessible labels, semantic formatting, and clear action hierarchy. Keep documentation in metadata rather than visible instructional text.
                        
            ```
    }

    region apex-ux-pattern-catalog (
        name: Reusable APEX UX Patterns
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>This application provides reusable reference patterns for common Oracle APEX application experiences. Each pattern demonstrates recommended page structure, interaction design, and documented design intent that can be adapted across a wide range of applications.</p>
                
                <p>The catalog focuses on reusable UX patterns rather than a specific business domain, making it valuable for <strong>developers, designers, and AI coding assistants</strong> building modern Oracle APEX applications.</p>
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/content-block
            templateOptions: [
                #DEFAULT#
                t-ContentBlock--h1
                t-Region--removeHeader js-removeLandmark
                margin-bottom-md
            ]
        }
    )

    region catalog-information (
        name: Catalog Information
        type: staticContent
        source {
            htmlCode: This catalog is domain-neutral and self-contained. Pages use portable sample data and document design intent through APEX metadata rather than visible instructional content.
        }
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @/content-block
            templateOptions: [
                #DEFAULT#
                t-ContentBlock--h1
                t-ContentBlock--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
    )

    region for-apex-developers (
        name: Quick Start
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                    'fa-cards' as icon_class,
                    'Explore Patterns' as title,
                    'Browse common application page patterns organized by user task.' as description
                from sys.dual
                union all
                select
                    'fa-lightbulb-o' as icon_class,
                    'Learn the Principles' as title,
                    'Understand the design decisions and UX conventions that shape every pattern.' as description
                from sys.dual
                union all
                select
                    'fa-magic' as icon_class,
                    'Adapt and Reuse' as title,
                    'Use these patterns as a starting point for new Oracle APEX applications and AI-generated solutions.' as description
                from sys.dual
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/content-block
            templateOptions: [
                #DEFAULT#
                t-ContentBlock--h3
                margin-top-md
            ]
        }
        componentAppearance {
            gridColumns: 3
        }
        title {
            column: TITLE
        }
        body {
            column: DESCRIPTION
        }
        iconAndBadge {
            iconSource: iconClass
            iconCssClasses: fa &ICON_CLASS.
            iconPosition: top
        }
    )

    region patterns (
        name: Browse Pattern Categories
        type: themeTemplateComponent/contentRow
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                    'fa-dashboard' as icon_class,
                    'Dashboards' as title,
                    'Summarize status, highlight exceptions, and guide users toward meaningful follow-up actions.' as description,
                    'dashboards' as page_alias
                from sys.dual
                union all
                select
                    'fa-mouse-pointer' as icon_class,
                    'Browse and Search' as title,
                    'Help users find, filter, compare, and open records using the right browsing experience for the task.' as description,
                    'browse-search' as page_alias
                from sys.dual
                union all
                select
                    'fa-id-card-o' as icon_class,
                    'Item Details' as title,
                    'Inspect one record with the right amount of context, supporting information, and follow-up action.' as description,
                    'item-details' as page_alias
                from sys.dual
                union all
                select
                    'fa-forms' as icon_class,
                    'Data Entry' as title,
                    'Create and update information with form patterns that match the complexity, context, and confidence required by the task.' as description,
                    'data-entry' as page_alias
                from sys.dual
                union all
                select
                    'fa-files-o' as icon_class,
                    'Master Detail' as title,
                    'Work across parent and child records with layouts that preserve context, support comparison, and keep related actions close to the data.' as description,
                    'master-detail' as page_alias
                from sys.dual
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/content-block
            templateOptions: [
                #DEFAULT#
                t-ContentBlock--h3
                t-ContentBlock--lightBG
            ]
        }
        componentAppearance {
            display: report
        }
        settings {
            title: &TITLE.
            description: &DESCRIPTION.
            displayAvatar: true
        }
        plugin-avatar {
            icon: &ICON_CLASS. fa-2x u-opacity-50
            shape: noShape
        }
        plugin-appearance {
            applyThemeColors: false
        }

        column DESCRIPTION (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: DESCRIPTION
                dataType: varchar2
            }
        )

        column ICON_CLASS (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: ICON_CLASS
                dataType: varchar2
            }
        )

        column PAGE_ALIAS (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: PAGE_ALIAS
                dataType: varchar2
            }
        )

        column TITLE (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: TITLE
                dataType: varchar2
            }
        )

        action action (
            position: titleLink
            layout {
                sequence: 10
            }
            behavior {
                type: redirectUrl
                targetUrl: f?p=&APP_ID.:&PAGE_ALIAS.:&SESSION.::&DEBUG.::::
            }
            serverSideCondition {
                type: itemIsNotNull
                item: PAGE_ALIAS
            }
        )

    )

    region reusable-apex-ux-patterns (
        name: Reusable UX Patterns
        type: staticContent
        layout {
            sequence: 90
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: #DEFAULT#
        }
        image {
            fileUrl: #APP_FILES#icons/app-icon-192.png
        }
    )

)

