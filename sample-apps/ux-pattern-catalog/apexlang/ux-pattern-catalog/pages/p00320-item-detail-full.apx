    region files (
        name: Files
        type: themeTemplateComponent/contentRow
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /*
                File list guidance for AI:
                
                1. Use the file title as the human-readable label users scan first.
                2. Preserve the real filename separately so users can identify the downloadable or stored asset.
                3. Use a file-extension icon to reinforce the file format without requiring a separate file-type label.
                4. Keep file size and last-updated date as separate values for quick scanning.
                5. Use the badge for access level because it communicates what users can do with the file.
                6. Map each access label to one consistent semantic state.
                7. Preserve a mix of file formats, access levels, sizes, and update dates so the pattern demonstrates realistic variation.
                */
                
                -- Content row query for files associated with an item.
                select 'fa-file-pdf-o'          as file_icon,
                       'Planning brief'         as file_title,
                       'planning-brief-v3.pdf'  as file_name,
                       '2.4 MB'                 as file_size,
                       sysdate - 2              as last_updated,
                       'Shared'                 as file_access,
                       'info'                   as file_access_state
                  from sys.dual
                union all
                select 'fa-file-archive-o'      as file_icon,
                       'Reference image set'    as file_title,
                       'reference-images.zip'   as file_name,
                       '18.7 MB'                as file_size,
                       sysdate - 5              as last_updated,
                       'Restricted'             as file_access,
                       'warning'                as file_access_state
                  from sys.dual
                union all
                select 'fa-file-excel-o'        as file_icon,
                       'Review notes'           as file_title,
                       'review-notes.xlsx'      as file_name,
                       '860 KB'                 as file_size,
                       sysdate - 7              as last_updated,
                       'Shared'                 as file_access,
                       'info'                   as file_access_state
                  from sys.dual
                union all
                select 'fa-file-word-o'         as file_icon,
                       'Requirements summary'   as file_title,
                       'requirements-summary.docx' as file_name,
                       '1.1 MB'                 as file_size,
                       sysdate - 9              as last_updated,
                       'Shared'                 as file_access,
                       'info'                   as file_access_state
                  from sys.dual
                union all
                select 'fa-file-pdf-o'          as file_icon,
                       'Decision log'           as file_title,
                       'decision-log.pdf'       as file_name,
                       '640 KB'                 as file_size,
                       sysdate - 14             as last_updated,
                       'Private'                as file_access,
                       'danger'                 as file_access_state
                  from sys.dual
                union all
                select 'fa-file-text-o'         as file_icon,
                       'Source data extract'    as file_title,
                       'source-data-extract.csv' as file_name,
                       '4.8 MB'                 as file_size,
                       sysdate - 21             as last_updated,
                       'Restricted'             as file_access,
                       'warning'                as file_access_state
                  from sys.dual
                union all
                select 'fa-file-powerpoint-o'   as file_icon,
                       'Previous plan'          as file_title,
                       'previous-plan.pptx'     as file_name,
                       '6.2 MB'                 as file_size,
                       sysdate - 60             as last_updated,
                       'Private'                as file_access,
                       'danger'                 as file_access_state
                  from sys.dual;
                
                ```
        }
        orderBy {
            type: staticValue
            orderByClause: 1
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/content-block
            templateOptions: [
                #DEFAULT#
                t-ContentBlock--h3
                t-ContentBlock--lightBG
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            display: report
        }
        settings {
            title: &FILE_TITLE.
            description: &FILE_NAME. (&FILE_SIZE.)
            miscellaneous: &LAST_UPDATED.
            displayAvatar: true
            displayBadge: true
        }
        plugin-avatar {
            icon: &FILE_ICON. fa-lg
            shape: noShape
        }
        plugin-badge {
            label: Status
            value: FILE_ACCESS
            state: FILE_ACCESS_STATE
            style: subtle
            alignment: center
        }
        plugin-appearance {
            applyThemeColors: false
            style: compact
        }

        column FILE_ACCESS (
            layout {
                sequence: 60
            }
            source {
                databaseColumn: FILE_ACCESS
                dataType: varchar2
            }
        )

        column FILE_ACCESS_STATE (
            layout {
                sequence: 70
            }
            source {
                databaseColumn: FILE_ACCESS_STATE
                dataType: varchar2
            }
        )

