    region flex-container (
        name: Flex Container
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @comments
            slot: regionBody
        }
        appearance {
            template: @/item-container
            templateOptions: [
                #DEFAULT#
                margin-top-md
            ]
        }
    )

    region item-detail-tabs (
        name: Item Detail Tabs
        type: regionDisplaySelector
        layout {
            sequence: 60
            slot: masterDetail
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
            cssClasses: app-ItemDetailTabs
        }
    )

    region item-header (
        name: Item Details – Full
        type: staticContent
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: [
                #DEFAULT#
                t-HeroRegion--hideIcon
                margin-right-lg
            ]
        }
        comments {
            comments:
                ```
                Intent: Establishes the identity and current state of the item before users inspect details or take action.
                
                Pattern role: Item detail header with contextual information.
                
                AI guidance: Keep the most important identity, ownership, status, impact, and timing information near the item title. Use contextual information for quick scanning rather than a full attribute report. Map status values to supported semantic states such as success, warning, danger, or info. Keep badge value, state, label, and styling semantically aligned. Use relative time only when it is useful for recency; use an explicit date when the exact date matters.
                ```
        }
    )

    region item-summary-details (
        name: Summary
        type: staticContent
        source {
            htmlCode: This record represents a standard item that is being reviewed, tracked, or acted on. The summary explains the current state, expected outcome, and any context needed before taking action.
        }
        layout {
            sequence: 50
            slot: masterDetail
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
            cssClasses: margin-md
        }
        comments {
            comments:
                ```
                Intent: Gives users concise narrative context about what the item represents and why it matters.
                
                Pattern role: Item summary narrative.
                
                AI guidance: Keep the summary short, generic, and decision-relevant. Explain the item's current purpose, state, or expected outcome without adding instructional or tutorial text. Move detailed attributes, history, and related records into their dedicated regions.
                ```
        }
    )

    region key-facts (
        name: Item Properties 1
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Record Owner' as owner,
                       'Standard Category' as category,
                       'On Track' as status,
                       'success' as status_state,
                       sysdate - 1/24 as last_updated,
                       'High' as impact,
                       'danger' as impact_state,
                       sysdate + 14 as target_date
                  from dual;
                ```
        }
        layout {
            sequence: 30
            parentRegion: @item-header
            slot: searchFieldAndSmartFilters
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
            cssClasses: app-ContextualInfo
        }
        comments {
            comments:
                ```
                Intent: Presents the highest-value item facts for quick assessment before users take action.
                
                Pattern role: Contextual information summary.
                
                AI guidance: Keep this region limited to ownership, classification, status, impact, recency, and timing information that users need for quick decisions. Keep visible values and their semantic state columns aligned. Use supported state values such as success, warning, danger, or info. Expose target timing when it materially affects the user’s decision; otherwise remove the unused supporting column.
                ```
        }
        componentAppearance {
            template: @/contextual-info
            templateOptions: [
                #DEFAULT#
                t-ContextualInfo--hideNulls
                t-ContextualInfo-label--stacked
                t-Report--hideNoPagination
            ]
        }

        column CATEGORY (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Category
            }
            layout {
                sequence: 30
            }
        )

        column IMPACT (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Impact
            }
            layout {
                sequence: 80
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    {with/}
                      LABEL:=Impact
                      VALUE:=#IMPACT#
                      STATE:=#IMPACT_STATE#
                      LABEL_DISPLAY:=N
                      STYLE:=t-Badge--subtle
                      SIZE:=t-Badge--sm
                    {apply THEME$BADGE/}
                    ```
            }
            serverSideCondition {
                type: never
            }
        )

        column IMPACT_STATE (
            reportColumnQueryId: 7
            derivedColumn: N
            type: hidden
            layout {
                sequence: 90
            }
        )

        column LAST_UPDATED (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Last Updated
            }
            layout {
                sequence: 50
            }
            appearance {
                formatMask: SINCE
            }
        )

        column OWNER (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Owner
            }
            layout {
                sequence: 20
            }
        )

        column STATUS (
            reportColumnQueryId: 3
            derivedColumn: N
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    {with/}
                      LABEL:=Status
                      VALUE:=#STATUS#
                      STATE:=#STATUS_STATE#
                      LABEL_DISPLAY:=Y
                      STYLE:=t-Badge--subtle margin-top-xs
                      SIZE:=t-Badge--md
                    {apply THEME$BADGE/}
                    ```
            }
        )

        column STATUS_STATE (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hidden
            layout {
                sequence: 70
            }
        )

        column TARGET_DATE (
            reportColumnQueryId: 8
            derivedColumn: N
            type: hidden
            layout {
                sequence: 60
            }
        )

    )

    region metric-cards (
        name: Key Metrics
        type: themeTemplateComponent/metricCard
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                    'fa-line-chart'    icon,
                    'Primary KPI'      label,
                    84200              metric_value
                from sys.dual
                union all
                select
                    'fa-bar-chart'     icon,
                    'Secondary KPI'    label,
                    12800              metric_value
                from sys.dual
                union all
                select
                    'fa-area-chart'    icon,
                    'Trend KPI'        label,
                    64                 metric_value
                from sys.dual
                union all
                select
                    'fa-dashboard'     icon,
                    'Status KPI'       label,
                    348                metric_value
                from sys.dual
                ```
        }
        layout {
            sequence: 30
            slot: rightSideColumn
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
            cssClasses: app-MetricCards
        }
        serverSideCondition {
            type: never
        }
        comments {
            comments:
                ```
                Intent: Highlights a small number of measures that help users assess the current item quickly.
                
                Pattern role: Item-level KPI summary.
                
                AI guidance: Use only the most relevant measures for this item, generally two to four cards. Keep metrics comparable in importance and avoid turning the region into a dense report. Format large values with thousands separators and use consistent units. If badges or icons are added, keep their value, state, and icon semantically aligned.
                ```
        }
        componentAppearance {
            display: report
        }
        settings {
            metric: &METRIC_VALUE.
            metricCssClasses: u-text-subheading-md
            meta: &LABEL.
            layout: stacked
        }
        plugin-avatar {
            displayAvatar: true
            icon: &ICON.
            style: subtle
            position: inline
        }
        plugin-advanced {
            itemCssClasses: margin-none
        }

        column ICON (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: ICON
                dataType: varchar2
            }
        )

        column LABEL (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: LABEL
                dataType: varchar2
            }
        )

        column METRIC_VALUE (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: METRIC_VALUE
                dataType: number
            }
            appearance {
                formatMask: 999G999G999G999G999G999G990
            }
        )

    )

    region people (
        name: People
        type: themeTemplateComponent/contentRow
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /*
                People list guidance for AI:
                
                1. Use the person's name as the primary identifying value.
                2. Derive initials from PERSON_NAME with APEX_STRING.GET_INITIALS when a photo is unavailable.
                3. Derive AVATAR_COLOR_CLASS from PERSON_NAME with ORA_HASH so the same person keeps the same color.
                4. Keep the person's role and department as separate attributes; do not concatenate them.
                5. Use availability as the badge meaning because it communicates whether the person can engage with the item.
                6. Map each availability label to one consistent semantic state.
                7. Use LAST_UPDATED as a real date value and apply presentation formatting in the component mapping.
                */
                
                -- Query for people associated with an item.
                with people as (
                    select 'Jordan Lee'          as person_name,
                           'Owner'               as person_role,
                           'Product Operations'  as person_department,
                           'Available'           as person_status,
                           'success'             as person_status_state,
                           sysdate               as last_updated
                      from sys.dual
                    union all
                    select 'Morgan Patel'        as person_name,
                           'Contributor'         as person_role,
                           'Engineering'         as person_department,
                           'Busy'                as person_status,
                           'warning'             as person_status_state,
                           sysdate - 1           as last_updated
                      from sys.dual
                    union all
                    select 'Casey Nguyen'        as person_name,
                           'Reviewer'            as person_role,
                           'Quality Assurance'   as person_department,
                           'Available'           as person_status,
                           'success'             as person_status_state,
                           sysdate - 3           as last_updated
                      from sys.dual
                    union all
                    select 'Avery Ross'          as person_name,
                           'Editor'              as person_role,
                           'Design'              as person_department,
                           'Busy'                as person_status,
                           'warning'             as person_status_state,
                           sysdate - 5           as last_updated
                      from sys.dual
                    union all
                    select 'Taylor Singh'        as person_name,
                           'Viewer'              as person_role,
                           'Planning'            as person_department,
                           'Away'                as person_status,
                           'info'                as person_status_state,
                           sysdate - 7           as last_updated
                      from sys.dual
                    union all
                    select 'Riley Brooks'        as person_name,
                           'Approver'            as person_role,
                           'Finance'             as person_department,
                           'Offline'             as person_status,
                           'danger'              as person_status_state,
                           sysdate - 14          as last_updated
                      from sys.dual
                    union all
                    select 'Kai Morgan'          as person_name,
                           'Coordinator'         as person_role,
                           'Operations'          as person_department,
                           'Available'           as person_status,
                           'success'             as person_status_state,
                           sysdate - 21          as last_updated
                      from sys.dual
                )
                select apex_string.get_initials(person_name) as person_initials,
                       person_name,
                       person_role,
                       person_department,
                       person_status,
                       person_status_state,
                       last_updated,
                       'u-color-' || to_char(ora_hash(person_name, 10)) as avatar_color_class
                  from people;
                
                ```
        }
        orderBy {
            type: staticValue
            orderByClause: 1
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/content-block
            templateOptions: [
                #DEFAULT#
                t-ContentBlock--h3
                t-ContentBlock--lightBG
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            display: report
        }
        settings {
            title: &PERSON_NAME.
            description: &PERSON_DEPARTMENT. &middot; &PERSON_ROLE.
            miscellaneous: &LAST_UPDATED.
            displayAvatar: true
            displayBadge: true
        }
        plugin-avatar {
            type: initials
            initials: PERSON_INITIALS
            shape: circular
            size: extraSmall
            cssClasses: &AVATAR_COLOR_CLASS.
        }
        plugin-badge {
            label: Status
            value: PERSON_STATUS
            state: PERSON_STATUS_STATE
            style: subtle
            alignment: center
        }
        plugin-appearance {
            applyThemeColors: false
            style: compact
        }

        column AVATAR_COLOR_CLASS (
            layout {
                sequence: 90
            }
            source {
                databaseColumn: AVATAR_COLOR_CLASS
                dataType: varchar2
            }
        )

        column LAST_UPDATED (
            layout {
                sequence: 80
            }
            source {
                databaseColumn: LAST_UPDATED
                dataType: date
            }
            appearance {
                formatMask: SINCE
            }
        )

        column PERSON_DEPARTMENT (
            layout {
                sequence: 70
            }
            source {
                databaseColumn: PERSON_DEPARTMENT
                dataType: varchar2
            }
        )

        column PERSON_INITIALS (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: PERSON_INITIALS
                dataType: varchar2
            }
        )

        column PERSON_NAME (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: PERSON_NAME
                dataType: varchar2
            }
        )

        column PERSON_ROLE (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: PERSON_ROLE
                dataType: varchar2
            }
        )

        column PERSON_STATUS (
            layout {
                sequence: 50
            }
            source {
                databaseColumn: PERSON_STATUS
                dataType: varchar2
            }
        )

        column PERSON_STATUS_STATE (
            layout {
                sequence: 60
            }
            source {
                databaseColumn: PERSON_STATUS_STATE
                dataType: varchar2
            }
        )

        action action (
            position: titleLink
            layout {
                sequence: 10
            }
            behavior {
                type: redirectUrl
                targetUrl: #
            }
        )

        action edit (
            position: primaryActions
            template: button
            label: Edit Person
            layout {
                sequence: 20
            }
            behavior {
                type: redirectUrl
                targetUrl: #
            }
            appearance {
                displayType: icon
                icon: fa-edit
                cssClasses: t-Button--noUI
            }
        )

    )

    region related-information (
        name: Related Information
        type: themeTemplateComponent/contentRow
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'fa-users'                     as icon,
                       'People'                      as title,
                       'Associated people and owners' as description,
                       4                             as item_count,
                       'PEOPLE'                      as page_alias
                  from sys.dual
                union all
                select 'fa-file-o'                   as icon,
                       'Files'                       as title,
                       'Documents and attachments'   as description,
                       12                            as item_count,
                       'FILES'                       as page_alias
                  from sys.dual
                union all
                select 'fa-comments-o'               as icon,
                       'Comments'                    as title,
                       'Discussion and feedback'     as description,
                       18                            as item_count,
                       'COMMENTS'                    as page_alias
                  from sys.dual
                union all
                select 'fa-sitemap'                  as icon,
                       'Child Records'               as title,
                       'Associated child records'    as description,
                       6                             as item_count,
                       'CHILD_RECORDS'               as page_alias
                  from sys.dual
                union all
                select 'fa-link'                     as icon,
                       'Related Records'             as title,
                       'Connected business entities' as description,
                       3                             as item_count,
                       'RELATED_RECORDS'             as page_alias
                  from sys.dual;
                ```
        }
        layout {
            sequence: 20
            slot: rightSideColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: never
        }
        comments {
            comments:
                ```
                Intent: Provides compact entry points to related information without overwhelming the item summary.
                
                Pattern role: Related-content navigation list.
                
                AI guidance: Keep rows concise and use the description to clarify what the related area contains. Use the badge to show the number of related items when that count is meaningful. Row titles should navigate to the corresponding related area or item-level detail. Keep this region focused on navigation and summary; use a full report or dedicated page for extensive related data.
                
                Implementation note: Each row represents a navigation entry to a related-information area. Replace the placeholder action target with the destination represented by PAGE_ALIAS, passing the current item context and selected related-information category.
                ```
        }
        componentAppearance {
            display: report
        }
        settings {
            title: &TITLE.
            displayAvatar: true
            displayBadge: true
        }
        plugin-avatar {
            icon: &ICON.
            shape: noShape
        }
        plugin-badge {
            label: Related Item Count
            value: ITEM_COUNT
            style: subtle
            columnWidth: auto
            position: end
            alignment: center
        }
        plugin-appearance {
            applyThemeColors: false
            style: compact
            hideBorders: true
        }

        column DESCRIPTION (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: DESCRIPTION
                dataType: varchar2
            }
        )

        column ICON (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: ICON
                dataType: varchar2
            }
        )

        column ITEM_COUNT (
            layout {
                sequence: 70
            }
            source {
                databaseColumn: ITEM_COUNT
                dataType: number
            }
        )

        column PAGE_ALIAS (
            layout {
                sequence: 60
            }
            source {
                databaseColumn: PAGE_ALIAS
                dataType: varchar2
            }
        )

        column TITLE (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: TITLE
                dataType: varchar2
            }
        )

        action action (
            position: titleLink
            layout {
                sequence: 10
            }
            behavior {
                type: redirectUrl
                targetUrl: #
            }
        )

    )

