page 320 (
    name: Item Detail – Full
    alias: ITEM-DETAIL-FULL
    title: Item Detail – Full
    appearance {
        pageTemplate: @/marquee
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            /* Keep contextual information compact and make its status badges easy to scan. */
            .app-ContextualInfo {
              --ut-contextualinfo-item-label-stacked-margin-y: 0;
              --ut-badge-font-weight: 600;
            }
            
            /* Establish visual hierarchy between featured, standard, and compact activity rows. */
            .app-ActivityTimeline .is-standard {
              --ut-cr-title-font-weight: 600;
            }
            
            .app-ActivityTimeline .is-compact {
              --ut-cr-title-font-size: 0.875rem;
              --ut-cr-title-font-weight: 400;
            }
            
            .app-ItemDetailTabs .a-RDS-list {padding-block-start: 0;}
            ```
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```html
            ## Purpose
            
            Demonstrates an item detail summary pattern for inspecting one record quickly before taking action. The page combines item context, a concise summary, key details, supporting metrics, related information, and recent activity.
            
            ## When to Use
            
            Use when users need a scan-first view of one item and a small number of clear next actions. This pattern works well when users need current state, ownership, timing, supporting context, and links to related information in one place.
            
            ## When to Avoid
            
            Avoid when users need to compare many records, perform complex filtering, edit large amounts of data, or complete a multi-step workflow. Use a sectioned, tabbed, or master-detail pattern when the item has substantially more information or deeper related tasks.
            
            ## AI Guidance
            
            Preserve the item-detail hierarchy: item identity and context first, primary and secondary actions next, followed by summary information, supporting details, related information, and activity. Keep the terminology generic and domain-neutral. Keep summaries concise and decision-relevant. Use semantic state values consistently for badges and status indicators. Keep primary actions prominent, secondary actions subordinate, and lower-frequency actions in the overflow menu. Do not add visible instructional text to the page. Use component comments to explain region intent, action hierarchy, data mappings, and custom behavior.
            ```
    }

    region activity-2 (
        name: Activity
        type: themeTemplateComponent/contentRow
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /*
                Activity timeline guidance for AI:
                
                1. The timeline should show the meaningful payload of the event at a glance.
                2. Attribute changes should use the title to describe the new value or state.
                3. File events should name the file in the title so the user can identify it immediately.
                4. Comment events should surface the comment text itself; the title can be the comment body, or the description can carry it if the title is a short summary.
                5. Use the description only when it adds useful context such as previous value, author, or a short supporting note.
                6. Keep some rows title-only to demonstrate that not every activity needs a description.
                7. Keep the mix of row shapes so the timeline can represent simple and rich events.
                */
                
                select 'Today' as activity_group,
                       10 as display_sequence,
                       sysdate - interval '1' hour as activity_time,
                       'Maya Chen' as actioned_by,
                       'Updated' as action_type,
                       null as badge_label,
                       'Status changed to On Track' as title,
                       'Previous status: Needs Review' as description,
                       'fa-check-circle-o u-success-text' as icon_class,
                       'is-featured' as row_class,
                       1 as id
                  from sys.dual
                union all
                select 'Today',
                       20,
                       sysdate - interval '4' hour,
                       'Jordan Lee',
                       'Reviewed',
                       null,
                       'Review completed',
                       'Next step confirmed for the current owner',
                       'fa-check-circle-o u-success-text',
                       'is-standard',
                       2
                  from sys.dual
                union all
                select 'This Week',
                       30,
                       trunc(sysdate) - 2 + (9/24),
                       'Maya Chen',
                       'Commented',
                       null,
                       'We should confirm the owner before moving this forward.',
                       'Comment added to the current record',
                       'fa-comments-o u-info-text',
                       'is-standard',
                       3
                  from sys.dual
                union all
                select 'This Week',
                       40,
                       trunc(sysdate) - 3 + (14/24),
                       'Jordan Lee',
                       'Adjusted',
                       null,
                       'Target Date set to October 1',
                       'Previous target date: September 18',
                       'fa-calendar-o u-info-text',
                       'is-standard',
                       4
                  from sys.dual
                union all
                select 'Earlier',
                       50,
                       trunc(sysdate) - 7 + (11/24),
                       null,
                       null,
                       null,
                       'Ownership assigned to Avery Smith for ongoing follow-up',
                       null,
                       'fa-user u-info-text',
                       'is-compact',
                       5
                  from sys.dual
                union all
                select 'Earlier',
                       60,
                       trunc(sysdate) - 9 + (10/24),
                       null,
                       null,
                       null,
                       'Standard Intake linked to support the current record',
                       null,
                       'fa-link u-info-text',
                       'is-compact',
                       6
                  from sys.dual
                union all
                select 'Earlier',
                       70,
                       trunc(sysdate) - 10 + (12/24),
                       null,
                       null,
                       null,
                       'Reference removed after duplicate values were identified',
                       null,
                       'fa-minus-circle-o u-danger-text',
                       'is-compact',
                       7
                  from sys.dual
                union all
                select 'Earlier',
                       80,
                       trunc(sysdate) - 11 + (16/24),
                       null,
                       null,
                       null,
                       'Initial record created and prepared for first review',
                       null,
                       'fa-plus-circle-o u-info-text',
                       'is-compact',
                       8
                  from sys.dual;
                ```
        }
        orderBy {
            type: staticValue
            orderByClause: display_sequence, activity_group
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/content-block
            templateOptions: [
                #DEFAULT#
                t-ContentBlock--h3
                t-ContentBlock--lightBG
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        comments {
            comments:
                ```
                Intent: Shows meaningful changes, decisions, comments, and events associated with the current item.
                
                Pattern role: Activity timeline.
                
                AI guidance: Make the event title carry the meaningful payload at a glance. Attribute changes should describe the new value or state. File events should identify the file. Comment events should surface the comment text. Use the description only for useful supporting context such as a previous value, author, or note. Keep some rows title-only and retain a mix of featured, standard, and compact rows to demonstrate different event shapes. Use featured rows for especially important events and compact rows for lower-detail history.
                ```
        }
        componentAppearance {
            display: report
            cssClasses: app-ActivityTimeline
        }
        settings {
            overline:
                ```html
                {if ACTIONED_BY/}
                    &ACTIONED_BY.{if ACTION_TYPE/} &middot; &ACTION_TYPE.{endif/}
                {elseif ACTION_TYPE/}
                    &ACTION_TYPE.
                {endif/}
                ```
            title: &TITLE.
            description: &DESCRIPTION.
            miscellaneous: &ACTIVITY_TIME.
            displayAvatar: true
            itemCssClasses: &ROW_CLASS.
        }
        plugin-avatar {
            icon: &ICON_CLASS.
            shape: noShape
            size: small
        }
        plugin-grouping {
            title: <div class="u-text-uppercase u-text-muted-color u-text-body-xs u-text-bold">&ACTIVITY_GROUP.</div>
        }
        plugin-appearance {
            applyThemeColors: false
        }

        column ACTIONED_BY (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: ACTIONED_BY
                dataType: varchar2
            }
        )

        column ACTION_TYPE (
            layout {
                sequence: 50
            }
            source {
                databaseColumn: ACTION_TYPE
                dataType: varchar2
            }
        )

        column ACTIVITY_GROUP (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: ACTIVITY_GROUP
                dataType: varchar2
            }
            appearance {
                group: true
            }
        )

        column ACTIVITY_TIME (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ACTIVITY_TIME
                dataType: date
            }
        )

        column BADGE_LABEL (
            layout {
                sequence: 60
            }
            source {
                databaseColumn: BADGE_LABEL
                dataType: varchar2
            }
        )

        column DESCRIPTION (
            layout {
                sequence: 80
            }
            source {
                databaseColumn: DESCRIPTION
                dataType: varchar2
            }
        )

        column DISPLAY_SEQUENCE (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: DISPLAY_SEQUENCE
                dataType: number
            }
        )

        column ICON_CLASS (
            layout {
                sequence: 90
            }
            source {
                databaseColumn: ICON_CLASS
                dataType: varchar2
            }
        )

        column ID (
            layout {
                sequence: 110
            }
            source {
                databaseColumn: ID
                dataType: number
                primaryKey: true
            }
        )

        column ROW_CLASS (
            layout {
                sequence: 100
            }
            source {
                databaseColumn: ROW_CLASS
                dataType: varchar2
            }
        )

        column TITLE (
            layout {
                sequence: 70
            }
            source {
                databaseColumn: TITLE
                dataType: varchar2
            }
        )

    )

    region child-records (
        name: Related Records
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /*
                Child record table guidance for AI:
                
                1. Use the child record name as the primary identifying value and make it linkable when detail navigation is available.
                2. Use the type to distinguish common child-record roles such as tasks, reviews, approvals, and deliverables.
                3. Use the owner to show accountability for each child record.
                4. Use status as a badge and map each status label to one consistent semantic state.
                5. Use DUE_DATE as a real date value and apply presentation formatting in the report column mapping.
                6. Keep the column set compact so the table demonstrates text, classification, ownership, badge, and date components without becoming dense.
                */
                
                -- Tabular query for child records belonging to an item.
                select 'Prepare requirements summary' as child_record_name,
                       'Task'                      as child_record_type,
                       'Jordan Lee'                as owner_name,
                       'In Progress'               as child_record_status,
                       'warning'                   as child_record_status_state,
                       sysdate + 3                 as due_date
                  from sys.dual
                union all
                select 'Confirm review participants' as child_record_name,
                       'Review'                     as child_record_type,
                       'Morgan Patel'               as owner_name,
                       'Not Started'                as child_record_status,
                       'info'                       as child_record_status_state,
                       sysdate + 7                  as due_date
                  from sys.dual
                union all
                select 'Approve delivery plan'      as child_record_name,
                       'Approval'                   as child_record_type,
                       'Casey Nguyen'               as owner_name,
                       'Blocked'                    as child_record_status,
                       'danger'                     as child_record_status_state,
                       sysdate + 5                  as due_date
                  from sys.dual
                union all
                select 'Publish final summary'      as child_record_name,
                       'Deliverable'                as child_record_type,
                       'Avery Ross'                 as owner_name,
                       'Complete'                   as child_record_status,
                       'success'                    as child_record_status_state,
                       sysdate - 2                  as due_date
                  from sys.dual
                union all
                select 'Schedule follow-up review'  as child_record_name,
                       'Follow-up'                  as child_record_type,
                       'Taylor Singh'               as owner_name,
                       'In Progress'                as child_record_status,
                       'warning'                    as child_record_status_state,
                       sysdate + 14                 as due_date
                  from sys.dual
                order by 6
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/content-block
            templateOptions: [
                #DEFAULT#
                t-ContentBlock--h3
                t-ContentBlock--lightBG
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--inline
            ]
        }

        column CHILD_RECORD_NAME (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                heading: Name
            }
            layout {
                sequence: 20
            }
            link {
                target: {
                    type: url
                    url: #
                }
                linkText: #CHILD_RECORD_NAME#
                linkAttributes: class="u-text-bold"
            }
            sorting {
                sortable: false
            }
        )

        column CHILD_RECORD_STATUS (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Status
            }
            layout {
                sequence: 60
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    {with/}
                      LABEL:=Status
                      VALUE:=#CHILD_RECORD_STATUS#
                      STATE:=#CHILD_RECORD_STATUS_STATE#
                      LABEL_DISPLAY:=N
                      STYLE:=t-Badge--subtle t-Badge--circle
                      SIZE:=t-Badge--md
                    {apply THEME$BADGE/}
                    ```
            }
            sorting {
                sortable: false
            }
        )

        column CHILD_RECORD_STATUS_STATE (
            reportColumnQueryId: 5
            derivedColumn: N
            type: hidden
            layout {
                sequence: 70
            }
        )

        column CHILD_RECORD_TYPE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Type
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column DUE_DATE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Due
            }
            layout {
                sequence: 80
            }
            appearance {
                formatMask: SINCE
            }
            sorting {
                sortable: false
            }
        )

        column OWNER_NAME (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Owner
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

    )

    region comments (
        name: Comments
        type: themeTemplateComponent/comments
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /*
                Comments query guidance for AI:
                
                1. Keep COMMENT_TEXT realistic and concise; each sample comment should stay below 250 characters.
                2. Keep the comment text separate from the author, date, and direction.
                3. Derive USER_INITIALS from USERNAME with APEX_STRING.GET_INITIALS.
                4. Derive AVATAR_COLOR_CLASS from USERNAME with ORA_HASH so repeated authors keep the same color.
                5. Use COMMENT_DATE as a real date value and apply presentation formatting in the component mapping.
                6. Use MESSAGE_DIRECTION to distinguish inbound and outbound communication; outbound messages represent the current user.
                7. Keep the sample to four people and eight messages so repeated authors demonstrate consistent avatar colors.
                */
                
                -- Query for comments associated with an item.
                with comments as (
                    select 'I updated the summary with the latest ownership notes. Please confirm the final reviewer before I send it for approval.' as comment_text,
                           'Shakira Raymond'                                                                                              as username,
                           sysdate - 1 + (10 / 24)                                                                                        as comment_date,
                           'outbound'                                                                                                     as message_direction
                      from sys.dual
                    union all
                    select 'We should confirm the owner before moving this forward.' as comment_text,
                           'Maya Chen'                                           as username,
                           trunc(sysdate) - 2 + (9 / 24)                          as comment_date,
                           'inbound'                                              as message_direction
                      from sys.dual
                    union all
                    select 'The revised requirements are ready for review. I clarified the acceptance criteria and added the dependency notes from yesterday''s discussion.' as comment_text,
                           'Shakira Raymond'                                                                                                           as username,
                           sysdate - 6                                                                                                                 as comment_date,
                           'outbound'                                                                                                                  as message_direction
                      from sys.dual
                    union all
                    select 'Thanks. I reviewed the changes and added two questions about the handoff timing. The rest of the summary looks good to me.' as comment_text,
                           'Morgan Patel'                                                                                                      as username,
                           sysdate - 3                                                                                                           as comment_date,
                           'inbound'                                                                                                             as message_direction
                      from sys.dual
                    union all
                    select 'The supporting file has been updated with the latest figures. Please use the new version for the review meeting.' as comment_text,
                           'Casey Nguyen'                                                                                                 as username,
                           sysdate - 4                                                                                                    as comment_date,
                           'inbound'                                                                                                      as message_direction
                      from sys.dual
                    union all
                    select 'I can take the follow-up review. I will confirm the open items with the team and share an update before the end of the week.' as comment_text,
                           'Maya Chen'                                                                                                             as username,
                           sysdate - 7                                                                                                             as comment_date,
                           'inbound'                                                                                                               as message_direction
                      from sys.dual
                    union all
                    select 'The final decision is recorded in the summary. No additional changes are needed unless the ownership or delivery date changes.' as comment_text,
                           'Morgan Patel'                                                                                                                 as username,
                           sysdate - 12                                                                                                                   as comment_date,
                           'inbound'                                                                                                                      as message_direction
                      from sys.dual
                    union all
                    select 'I added the meeting notes and linked the supporting document. The remaining question is whether the current due date still holds.' as comment_text,
                           'Casey Nguyen'                                                                                                                 as username,
                           sysdate - 15                                                                                                                   as comment_date,
                           'inbound'                                                                                                                      as message_direction
                      from sys.dual
                )
                select comment_text,
                       username,
                       apex_string.get_initials(username) as user_initials,
                       comment_date,
                       message_direction,
                       'u-color-' || to_char(ora_hash(username, 10)) as avatar_color_class
                  from comments;
                
                ```
        }
        orderBy {
            type: staticValue
            orderByClause: 4
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/content-block
            templateOptions: [
                #DEFAULT#
                t-ContentBlock--padded
                t-ContentBlock--h3
                t-ContentBlock--lightBG
            ]
            renderComponents: belowContent
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            display: report
        }
        settings {
            commentText: COMMENT_TEXT
            userName: USERNAME
            date: COMMENT_DATE
            style: chatSpeechBubbles
            alignment: &MESSAGE_DIRECTION.
        }
        plugin-avatar {
            type: initials
            initials: USER_INITIALS
            shape: circular
            cssClasses: &AVATAR_COLOR_CLASS.
        }

        column AVATAR_COLOR_CLASS (
            layout {
                sequence: 60
            }
            source {
                databaseColumn: AVATAR_COLOR_CLASS
                dataType: varchar2
            }
        )

        column COMMENT_DATE (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: COMMENT_DATE
                dataType: date
            }
            appearance {
                formatMask: SINCE
            }
        )

        column COMMENT_TEXT (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: COMMENT_TEXT
                dataType: varchar2
            }
        )

        column MESSAGE_DIRECTION (
            layout {
                sequence: 50
            }
            source {
                databaseColumn: MESSAGE_DIRECTION
                dataType: varchar2
            }
        )

        column USERNAME (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: USERNAME
                dataType: varchar2
            }
        )

        column USER_INITIALS (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: USER_INITIALS
                dataType: varchar2
            }
        )

    )

    region details (
        name: Item Properties 2
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'REC-1001' as reference,
                       'Standard Intake' as source,
                       'Summary Record' as type,
                       'Tracked, Reviewable' as tags
                  from dual;
                ```
        }
        layout {
            sequence: 10
            parentRegion: @summary-container
            slot: regionBody
            rowCssClasses: u-gap-0
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
        comments {
            comments:
                ```
                Intent: Presents supporting item attributes in compact value-and-attribute groups.
                
                Pattern role: Attribute-pair detail layout.
                
                AI guidance: Group related attributes together and order them according to the decisions users need to make. Keep labels concise and values consistently formatted. Format percentages, dates, durations, counts, and units for scanning. Use separate groups when the item has distinct categories of supporting information, such as classification versus ownership and timing.
                ```
        }
        componentAppearance {
            template: @/value-attribute-pairs-column
            templateOptions: [
                #DEFAULT#
                t-AVPList--leftAligned
            ]
        }

        column REFERENCE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Reference
            }
            layout {
                sequence: 10
            }
        )

        column SOURCE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Source
            }
            layout {
                sequence: 20
            }
        )

        column TAGS (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Tags
            }
            layout {
                sequence: 60
            }
        )

        column TYPE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Type
            }
            layout {
                sequence: 30
            }
        )

    )

