    region time-series (
        name: Revenue Trend Series
        type: chart
        layout {
            sequence: 40
            slot: body
            columnSpan: 8
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        comments {
            comments:
                ```
                Intent: Shows actual and target revenue over time as a second executive trend view.
                Pattern role: Revenue trend comparison.
                AI guidance: Use the same period definition and value formatting as the primary revenue chart. Include this region only when the additional trend perspective supports a distinct executive question.
                ```
        }
        chart {
            type: line
        }
        chartLayout {
            height: 250
        }
        multiSeriesChartData {
            fillGapsInChartData: false
        }
        settings {
            timeAxisType: enabled
        }

        series series-1 (
            name: Actual
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    WITH revenue_data AS (
                        SELECT DATE '2026-01-01' AS month_date, 68.2 AS actual_value FROM dual
                        UNION ALL SELECT DATE '2026-02-01', 71.4 FROM dual
                        UNION ALL SELECT DATE '2026-03-01', 74.8 FROM dual
                        UNION ALL SELECT DATE '2026-04-01', 73.1 FROM dual
                        UNION ALL SELECT DATE '2026-05-01', 76.9 FROM dual
                        UNION ALL SELECT DATE '2026-06-01', 79.3 FROM dual
                        UNION ALL SELECT DATE '2026-07-01', 81.6 FROM dual
                        UNION ALL SELECT DATE '2026-08-01', 84.2 FROM dual
                    )
                    SELECT
                        month_date,
                        TO_CHAR(
                            month_date,
                            'FMMon',
                            'NLS_DATE_LANGUAGE=English'
                        ) AS month_label,
                        actual_value AS value
                    FROM revenue_data
                    ORDER BY month_date;
                    ```
            }
            orderBy {
                type: staticValue
                orderByClause: 1
            }
            columnMapping {
                label: MONTH_DATE
                value: VALUE
            }
            appearance {
                color: #3f8efc
            }
            line {
                width: 2
                type: curved
            }
        )

        series series-2 (
            name: Target
            execution {
                sequence: 20
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    WITH revenue_data AS (
                        SELECT DATE '2026-01-01' AS month_date, 70 AS target_value FROM dual
                        UNION ALL SELECT DATE '2026-02-01', 72 FROM dual
                        UNION ALL SELECT DATE '2026-03-01', 74 FROM dual
                        UNION ALL SELECT DATE '2026-04-01', 76 FROM dual
                        UNION ALL SELECT DATE '2026-05-01', 78 FROM dual
                        UNION ALL SELECT DATE '2026-06-01', 80 FROM dual
                        UNION ALL SELECT DATE '2026-07-01', 82 FROM dual
                        UNION ALL SELECT DATE '2026-08-01', 84 FROM dual
                    )
                    SELECT
                        month_date,
                        TO_CHAR(
                            month_date,
                            'FMMon',
                            'NLS_DATE_LANGUAGE=English'
                        ) AS month_label,
                        target_value AS value
                    FROM revenue_data
                    ORDER BY month_date;
                    ```
            }
            columnMapping {
                label: MONTH_DATE
                value: VALUE
            }
            appearance {
                color: #8f99a8
            }
            line {
                style: dashed
                width: 2
                type: curved
            }
        )

        axis x (
            name: x
            majorTicks {
                show: auto
            }
            tickLabel {
                position: inside
            }
        )

        axis y (
            name: y
            value {
                min: 65
                max: 85
                format: currency
                decimalPlaces: 0
                pattern: $#M
                baselineScaling: min
            }
            majorTicks {
                show: false
            }
            minorTicks {
                show: false
            }
        )

    )

    pageItem P130_TIME_RANGE (
        type: radioGroup
        label {
            label: Time Range
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: staticValues
            staticValues: STATIC2:MTD;MONTH,QTD;QUARTER,YTD;YEAR
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @dashboard-title
            slot: next
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--radioButtonGroup
            ]
        }
        source {
            type: staticValue
            staticValue: YEAR
        }
        comments {
            comments:
                ```
                Intent: Lets an executive choose the reporting period used by the dashboard.
                Pattern role: Dashboard-wide time filter.
                Implementation guidance: Bind this item to every affected region query and refresh those regions on change. The sample regions currently use static data, so changing this item does not alter them until the queries are made period-aware.
                ```
        }
    )

    button actions-menu (
        buttonName: ACTIONS_MENU
        label: Actions Menu
        layout {
            sequence: 40
            region: @dashboard-title
            slot: next
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
            ]
            icon: fa-ellipsis-v
        }
        behavior {
            type: menu
        }
        comments {
            comments:
                ```
                Intent: Groups lower-frequency or optional page actions.
                Pattern role: Overflow actions.
                AI guidance: Use for actions that should remain available without competing with primary and secondary actions.
                ```
        }

        menu menu-action-a (
            label: Action 1
            layout {
                sequence: 10
            }
            behavior {
                type: redirectUrl
                targetUrl: #
            }
        )

        menu menu-action-b (
            label: Action 2
            layout {
                sequence: 20
            }
            behavior {
                type: redirectUrl
                targetUrl: #
            }
        )

        menu menu-action-c (
            label: Action 3
            layout {
                sequence: 30
            }
            behavior {
                type: redirectUrl
                targetUrl: #
            }
        )

    )

    button primary-action (
        buttonName: PRIMARY_ACTION
        label: Primary Action
        layout {
            sequence: 30
            region: @dashboard-title
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        comments {
            comments:
                ```
                Intent: Represents the main follow-up action from the Executive Dashboard overview.
                Pattern role: Primary page action.
                AI guidance: Keep prominent. Use a domain-specific label only when adapting this pattern to a real application.
                ```
        }
    )

    button secondary-action (
        buttonName: SECONDARY_ACTION
        label: Secondary Action
        layout {
            sequence: 20
            region: @dashboard-title
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        comments {
            comments:
                ```
                Intent: Represents a useful but lower-priority follow-up action.
                Pattern role: Secondary page action.
                AI guidance: Keep visually subordinate to the primary action.
                ```
        }
    )

    button view-details-link-3 (
        buttonName: VIEW_DETAILS_LINK
        label: View Report
        layout {
            sequence: 30
            region: @chart-4_1
            slot: edit
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--link
                t-Button--iconRight
            ]
            icon: fa-arrow-right
        }
        behavior {
            action: redirectUrl
            targetUrl: #
        }
        comments {
            comments:
                ```
                Intent: Provides a direct path from the comparison chart to supporting detail.
                Pattern role: Region-level detail action.
                AI guidance: Use text-link detail actions when the drill-down is a common analytical follow-up.
                ```
        }
    )

)

