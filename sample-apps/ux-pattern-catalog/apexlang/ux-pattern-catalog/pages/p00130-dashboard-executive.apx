    region metric-cards (
        name: Metric Cards
        type: themeTemplateComponent/metricCard
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                    'fa-line-chart'    icon,
                    'Primary KPI'      label,
                    84200              metric_value,
                    'Trend'            badge,
                    '+12%'             badge_value,
                    'success'          badge_state,
                    'fa-trend-up'      badge_icon
                from sys.dual
                union all
                select
                    'fa-bar-chart'     icon,
                    'Secondary KPI'    label,
                    12800              metric_value,
                    'Trend'            badge,
                    '+320 units'       badge_value,
                    'success'          badge_state,
                    'fa-trend-up'      badge_icon
                from sys.dual
                union all
                select
                    'fa-area-chart'    icon,
                    'Trend KPI'        label,
                    64                 metric_value,
                    'Trend'            badge,
                    '20m faster'       badge_value,
                    'success'          badge_state,
                    'fa-trend-up'      badge_icon
                from sys.dual
                union all
                select
                    'fa-dashboard'     icon,
                    'Status KPI'       label,
                    348                metric_value,
                    'Trend'            badge,
                    '-14 items'        badge_value,
                    'danger'           badge_state,
                    'fa-trend-down'    badge_icon
                from sys.dual
                ```
        }
        orderBy {
            type: staticValue
            orderByClause: BADGE_VALUE
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: [
                #DEFAULT#
                margin-bottom-md
            ]
            cssClasses: app-MetricCards
        }
        accessibility {
            landmarkType: region
        }
        comments {
            comments:
                ```
                Intent: Presents the executive KPIs that should be scanned before reviewing the revenue, pipeline, and regional charts.
                Pattern role: Primary KPI summary.
                AI guidance: Keep metrics comparable in importance. Badge value, badge state, and badge icon should be semantically aligned. Format key values for quick scanning and avoid turning this region into a dense report.
                Implementation note: The app-MetricCards CSS class scopes page-level CSS to this region.
                ```
        }
        componentAppearance {
            display: report
        }
        settings {
            metric: &METRIC_VALUE.
            metricCssClasses: u-text-subheading-md
            meta: &LABEL.
            layout: 4Columns
        }
        plugin-avatar {
            displayAvatar: true
            icon: &ICON.
            style: subtle
            position: inline
        }
        plugin-badge {
            displayBadge: true
            label: Trend
            value: BADGE_VALUE
            state: BADGE_STATE
            icon: &BADGE_ICON.
            style: subtle
            shape: rounded
        }

