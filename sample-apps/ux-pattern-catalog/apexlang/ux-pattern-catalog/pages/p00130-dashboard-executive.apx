    region chart-4_1 (
        name: Pipeline Funnel
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                    1 seq,
                    'Awareness' label,
                    48200 as value
                from sys.dual
                union all
                select 2, 'Leads', 12400 from sys.dual
                union all
                select 3, 'Qualified', 4800 from sys.dual
                union all
                select 4, 'Proposals', 1920 from sys.dual
                union all
                select 5, 'Closed Won', 480 from sys.dual
                ```
        }
        layout {
            sequence: 80
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        comments {
            comments:
                ```
                Intent: Shows how opportunities narrow from awareness through closed-won so executives can see conversion and stage drop-off.
                Pattern role: Sales pipeline funnel.
                AI guidance: Order stages from broadest to narrowest, use mutually exclusive stage counts, and keep the funnel focused on a single pipeline definition. Pair it with a detail link when users need to investigate a stage.
                ```
        }
        chart {
            type: funnel
        }
        title {
            title: Opportunities Conversion
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function( options ) {
                
                    options.styleDefaults = $.extend( true, {}, options.styleDefaults, {
                        colors: [
                            'rgba(66, 81, 191, 0.5)',
                            'rgba(95, 185, 181, 0.5)'
                        ]
                    });
                
                    return options;
                }
                ```
        }

        series series-1 (
            name: Opportunities Conversion
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: LABEL
                value: VALUE
            }
            label {
                show: true
            }
        )

    )

