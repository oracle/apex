                heading: Flag 1
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    {if FLAG_1/}
                      <span aria-hidden="true" class="fa fa-check-circle u-success-text" title="Yes"></span>
                    {else /}
                      <span aria-hidden="true" class="fa fa-circle-o u-opacity-50" title="No"></span>
                    {endif /}
                    ```
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

