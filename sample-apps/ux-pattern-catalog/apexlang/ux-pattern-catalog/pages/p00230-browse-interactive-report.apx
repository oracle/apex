            view {
                rowsPerPage: 50
            }

            displayColumn CATEGORY (
                sequence: 2
            )

            displayColumn FLAG_1 (
                sequence: 4
            )

            displayColumn FLAG_2 (
                sequence: 5
            )

            displayColumn FLAG_3 (
                sequence: 6
            )

            displayColumn FLAG_4 (
                sequence: 7
            )

            displayColumn ID (
                sequence: 9
            )

            displayColumn PRIORITY (
                sequence: 3
            )

            displayColumn TITLE (
                sequence: 1
            )

            displayColumn UPDATED_ON (
                sequence: 8
            )

        )

    )

    region interactive-report-2 (
        name: Interactive Report
        type: staticContent
        source {
            htmlCode: Interactive Report
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: [
                #DEFAULT#
                t-HeroRegion--hideIcon
            ]
        }
        comments {
            comments:
                ```
                Intent: Provides context and an optional action area for the interactive report.
                Pattern role: Report context and optional action container.
                AI guidance: Keep the description concise and production-like. Use this area for secondary or infrequent report actions when needed; do not imply that a drawer, editor, or other specific interaction is required by the pattern.
                ```
        }
    )

    button actions-menu (
        buttonName: ACTIONS_MENU
        label: Actions Menu
        layout {
            sequence: 40
            region: @interactive-report-2
            slot: next
        }
        appearance {
