list item-details-side-actions (
    name: Item Details - Side Actions

    entry delete (
        label: Delete
        icon {
            imageIconCssClasses: fa-trash-o
        }
        layout {
            sequence: 60
        }
        link {
            target: {
                type: url
                url: #
            }
        }
    )

    entry duplicate (
        label: Duplicate
