list navigation-menu (
    name: Navigation Menu

    entry administration (
        label: Administration
        icon {
            imageIconCssClasses: fa-gear
        }
        layout {
            sequence: 270
        }
        isCurrent {
            type: pages
            pages: [
                500
                501
                502
                503
            ]
        }
        link {
            target: {
                page: 500
            }
        }
    )

    entry advanced (
        label: Advanced
        icon {
            imageIconCssClasses: fa-rocket
        }
        layout {
            sequence: 120
        }
        isCurrent {
            type: pages
            pages: 300
        }
        link {
            target: {
                page: 300
            }
        }
    )

    entry basics (
        label: Basics
        icon {
            imageIconCssClasses: fa-layers
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 100
            }
        }
    )

    entry cards-region (
        label: Cards Region
        layout {
            sequence: 210
            parentEntry: @advanced
        }
        isCurrent {
            type: pages
            pages: 301
        }
        link {
