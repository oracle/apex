list settings (
    name: Settings

    entry activity-calendar (
        label: Activity Calendar
        icon {
            imageIconCssClasses: fa-calendar
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 17
                clearCache: 17
            }
        }
        userDefinedAttributes {
            1: Calendar view of all application activity by user.
            2: calendarIcon
        }
    )

    entry build-options (
        label: Build Options
        icon {
            imageIconCssClasses: fa-check-square-o
        }
        layout {
            sequence: 50
        }
        link {
            target: {
                page: 10020
                clearCache: 10020
                action: resetPagination
            }
        }
        userDefinedAttributes {
            1: Set application configuration
        }
    )

    entry event-log (
        label: Event Log
        icon {
            imageIconCssClasses: fa-table
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 21
                action: resetPagination
            }
        }
        userDefinedAttributes {
            1: View administrative and debug event log.
            2: reportIcon
        }
    )

    entry page-views (
        label: Page Views
        icon {
            imageIconCssClasses: fa-analytics
        }
        layout {
            sequence: 70
        }
        link {
            target: {
                page: 39
                clearCache: 10020
                action: resetPagination
            }
        }
        userDefinedAttributes {
            1: Set application configuration
        }
    )

    entry theme-style (
        label: Theme Style
        icon {
            imageIconCssClasses: fa-desktop
        }
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 10010
                clearCache: 10010
                action: resetPagination
            }
        }
        userDefinedAttributes {
            1: Set application user interface theme style for all users
        }
    )

    entry top-users (
        label: Top Users
        icon {
            imageIconCssClasses: fa-line-chart
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 16
            }
        }
        userDefinedAttributes {
            1: Report of page views aggregated by user.
            2: reportIcon
        }
    )

)

