list upload-data-progress (
    name: Upload Data Progress

    entry confirmation (
        label: Confirmation
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 30
            }
        }
    )

    entry generate-vector-embeddings (
        label: Generate Vector Embeddings
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 27
            }
        }
    )

    entry preview-and-load-data (
        label: Preview and Load Data
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 26
            }
        }
    )

    entry select-file (
        label: Select File
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 25
            }
        }
    )

)

