genAIService EBA_GENAI_OCI (
    name: OCI GenAI Service
    provider: ociGenAI
    ociGenAI {
        compartmentId: ocid1.compartment.oc1
        servingMode: onDemand
    }
    endpointUrl {
        url: https://inference.generativeai.us-chicago-1.oci.oraclecloud.com
    }
    authentication {
        credentials: @EBA_CREDENTIALS_OCI
    }
    advanced {
        modelName: cohere.command-a-03-2025
        providerApi: generic
    }
)

