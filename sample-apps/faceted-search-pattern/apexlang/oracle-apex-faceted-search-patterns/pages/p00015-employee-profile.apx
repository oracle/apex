    button back-to-search (
        buttonName: BACK_TO_SEARCH
        label: Back to search
        layout {
            sequence: 120
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
                t-Button--iconLeft
            ]
            icon: fa-arrow-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: &P15_RETURN_PAGE.
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P15_RETURN_PAGE
        }
    )

    process initialize-profile (
        name: Initialize Employee Profile
        type: formInitialization
        formRegion: @profile
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 4395121736209103215
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P15_EMPLOYEE_ID
        }
