page 15 (
    name: Employee Profile
    alias: EMPLOYEE-PROFILE
    title: Employee Profile
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
    }
    help {
        helpText:
            ```html
                <p>Review the employee selected from a search result. This supporting page demonstrates navigation from a result component to a record detail view.</p>
                <h3>Components used</h3>
                <ul>
                <li><strong>Form region:</strong> Reads the selected employee from APEX sample data.</li>
                <li><strong>Form Initialization process:</strong> Loads the record identified by the primary-key page item.</li>
                <li><strong>Display Only page items:</strong> Present the record fields for review.</li>
                <li><strong>Hidden page items and return buttons:</strong> Carry the record identifier and support returning to the search context.</li>
                </ul>
                <h3>How the components work together</h3>
                <p>The result action passes the employee identifier to this page. Form Initialization loads that record and the Display Only items present its details. Back to search returns to the originating search page with its search filters preserved.</p>
            ```
    }
    comments {
        comments: Uses the native sample-data form and Form Initialization pattern from ux-pattern-catalog page 410. The primary key selects one record; fields are read-only and returning preserves search filters.
    }

    region breadcrumb (
        name: Employee Profile
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region button-bar (
        name: Employee Profile Actions
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region profile (
        name: Employee Profile
        type: form
        source {
            location: localDatabase
            tableName: FSP_EMPLOYEES
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    pageItem P15_AVATAR (
        type: hidden
        layout {
            sequence: 10
            region: @profile
            slot: regionBody
        }
        source {
            formRegion: @profile
            column: AVATAR
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

