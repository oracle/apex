page 12 (
    name: FS-06 - Timeline
    alias: FS-06-TIMELINE
    title: FS-06 - Timeline
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
    }
    help {
        helpText:
            ```html
            <h3>When to use</h3>
            <p>Use this pattern to filter records and explore matching results chronologically. It suits use cases such as reviewing tasks, milestones, or activities by date, responsible person, and status, then opening a record for details.</p>
            
            <h3>About this pattern page</h3>
            <p>Search matches task name, assignee, or status. The Month facet supports multiple calendar-month ranges based on task start dates. Status and Assigned To checkbox facets allow multiple selections. The Timeline presents matching tasks with dates, assignees, and colored status badges. Task titles open details; assignee links filter by person. Reset clears all selections.</p>
            ```
    }
    comments {
        comments: Timeline filters tasks using START_DATE. The Month facet supplies named calendar-month ranges with inclusive first-of-month and exclusive next-month boundaries. Keep the sample-task LOV to 25 months (12 before and after the current month) to bound the generated facet-count query. Months with no matching tasks are hidden.
    }

    region activity-timeline (
        name: Activity Timeline
        type: themeTemplateComponent/timeline
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ID,
                       TASK_NAME,
                       ASSIGNED_TO_EMPNO,
                       ASSIGNED_TO_NAME,
                       ASSIGNED_TO_EMAIL,
                       HOURS_ALLOCATED,
                       WORK_MODE,
                       START_DATE,
                       END_DATE,
                       STATUS,
                           case
                    when upper(trim(STATUS)) in ('OPEN', 'OVERDUE', 'BLOCKED') then 'danger'
                    when upper(trim(STATUS)) in ('ACTIVE', 'CLOSED', 'COMPLETED', 'IN-PROGRESS', 'IN PROGRESS') then 'success'
                    else 'warning'
                end AS BADGE_STATE,
                       CALENDAR_COLOR
                  from FSP_TASKS
                ```
        }
        orderBy {
            type: item
            item: {
                itemName: P12_ORDER_BY
                orderBys: {
                    START_DATE: START_DATE ASC
                    START_DATE_DESC: START_DATE DESC
                    ID: ID ASC
                }
            }
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/content-block
            templateOptions: [
                #DEFAULT#
                t-ContentBlock--h1
                t-ContentBlock--lightBG
                t-Region--removeHeader js-removeLandmark
            ]
        }
        advanced {
            htmlDomId: activity-timeline
        }
        componentAppearance {
            display: report
        }
        settings {
            userName: ASSIGNED_TO_NAME
            date: START_DATE
            title: TASK_NAME
            description: WORK_MODE
            displayAvatar: true
            displayBadge: true
            style: compact
            applyThemeColors: false
        }
        plugin-avatar {
            icon: fa-calendar-month fa-2x
            shape: noShape
        }
        plugin-badge {
            label: Status
            value: STATUS
            state: BADGE_STATE
            style: subtle
            shape: rounded
        }

        column ASSIGNED_TO_EMAIL (
            layout {
                sequence: 90
            }
            source {
                databaseColumn: ASSIGNED_TO_EMAIL
                dataType: varchar2
            }
        )

        column ASSIGNED_TO_EMPNO (
            layout {
                sequence: 80
            }
            source {
                databaseColumn: ASSIGNED_TO_EMPNO
                dataType: number
            }
        )

        column ASSIGNED_TO_NAME (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: ASSIGNED_TO_NAME
                dataType: varchar2
                availableOnClient: true
            }
        )

        column BADGE_STATE (
            layout {
                sequence: 140
            }
            source {
                databaseColumn: BADGE_STATE
                dataType: varchar2
            }
        )

        column CALENDAR_COLOR (
            layout {
                sequence: 130
            }
            source {
                databaseColumn: CALENDAR_COLOR
                dataType: varchar2
            }
        )

        column END_DATE (
            layout {
                sequence: 120
            }
            source {
                databaseColumn: END_DATE
                dataType: date
            }
        )

        column HOURS_ALLOCATED (
            layout {
                sequence: 100
            }
            source {
                databaseColumn: HOURS_ALLOCATED
                dataType: number
            }
        )

        column ID (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: ID
                dataType: number
                primaryKey: true
            }
        )

        column START_DATE (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: START_DATE
                dataType: date
                availableOnClient: true
            }
            appearance {
                formatMask: DD-MON-YYYY
            }
        )

        column STATUS (
            layout {
                sequence: 70
            }
            source {
                databaseColumn: STATUS
                dataType: varchar2
                availableOnClient: true
            }
        )

        column TASK_NAME (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: TASK_NAME
                dataType: varchar2
                availableOnClient: true
            }
        )

        column WORK_MODE (
            layout {
                sequence: 110
            }
            source {
                databaseColumn: WORK_MODE
                dataType: varchar2
            }
        )

        action assignee-name (
            position: userNameLink
            layout {
                sequence: 20
            }
            behavior {
                target: {
                    page: 12
                    items: {
                        P12_ASSIGNEE: &ASSIGNED_TO_NAME.
                    }
                }
                linkAttributes: title="Filter by this assignee"
            }
            serverSideCondition {
                type: itemIsNotNull
                item: ASSIGNED_TO_NAME
            }
        )

        action task-title (
            position: titleLink
            layout {
                sequence: 10
            }
            behavior {
                type: redirectUrl
                targetUrl: #
            }
        )

    )

    region breadcrumb (
        name: FS-06 - Timeline
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region button-bar (
        name: Button Bar
        type: staticContent
        source {
            htmlCode: <div id="active_facets"></div>
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region search (
        name: Filter activities
        type: facetedSearch
        source {
            filteredRegion: @activity-timeline
        }
        layout {
            sequence: 10
            slot: leftColumn
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            compactNosThreshold: 10000
            showCurrentFacets: true
        }

        facet P12_ASSIGNEE (
            type: checkboxGroup
            label {
                label: Assigned To
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 40
            }
            listEntries {
                maxDisplayedEntries: 5
                allowToExclude: false
            }
            source {
                databaseColumn: ASSIGNED_TO_NAME
            }
        )

        facet P12_SEARCH (
            type: search
            label {
                label: Search
            }
            layout {
                sequence: 10
            }
            appearance {
                valuePlaceholder: Search...
            }
        )

        facet P12_STATUS (
            type: checkboxGroup
            label {
                label: Status
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 30
            }
            listEntries {
                maxDisplayedEntries: 6
                allowToExclude: false
            }
            source {
                databaseColumn: STATUS
            }
        )

        facet P12_TASK_MONTH (
            type: range
            label {
                label: Month
            }
            settings {
                selectMultiple: true
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                        select to_char(month_start, 'FMMonth YYYY', 'NLS_DATE_LANGUAGE=English') as display_value,
                               to_char(month_start, 'YYYYMMDDHH24MISS') || '|' ||
                               to_char(add_months(month_start, 1), 'YYYYMMDDHH24MISS') as return_value
                          from (
                                select add_months(trunc(sysdate, 'MM'), level - 13) as month_start
                                  from dual
                                connect by level <= 25
                               )
                         order by month_start
                    ```
            }
            layout {
                sequence: 20
            }
            listEntries {
                maxDisplayedEntries: 5
                allowToExclude: false
            }
            source {
                databaseColumn: START_DATE
                dataType: date
            }
        )

    )

    pageItem P12_ORDER_BY (
        type: selectList
        label {
            label: Order By
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Start Date ascending;START_DATE,Start Date descending;START_DATE_DESC
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @button-bar
            slot: next
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: #DEFAULT#
            icon: fa-sort
            height: 1
        }
        validation {
            valueRequired: true
        }
        advanced {
            cssClasses: no-item-ui
            warnOnUnsavedChanges: ignore
        }
        default {
            type: static
            staticValue: START_DATE
        }
    )

    button timeline-reset (
        buttonName: TIMELINE_RESET
        label: Reset Timeline
        layout {
            sequence: 10
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-undo
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 12
                clearCache: 12
                action: resetRegions
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

