page 5 (
    name: FS-02 - Cards
    alias: FS-02-CARDS
    title: FS-02 - Cards
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
    }
    help {
        helpText:
            ```html
            <h3>When to use</h3>
            <p>Use this pattern to browse and manage employee records when visual identification and quick access to profiles or email are useful. Search and filters help users narrow a larger employee list to relevant results.</p>
            
            <h3>About this pattern page</h3>
            <p>Search for employees, then narrow results by Job, Business Unit, or Status. Sort the cards by First Name. Each card shows an employee’s avatar, name and job title, email, and status, with actions to view the profile or email the employee. Use Reset to clear the current filters.</p>
            ```
    }
    comments {
        comments: Uses the clickable-title and primary/secondary card-action pattern from ux-pattern-catalog page 210. Actions open the selected employee profile or compose an email; the Order By item controls the cards source ordering.
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 40
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region button-bar (
        name: Button Bar
        type: staticContent
        source {
            htmlCode: <div id="active_facets"></div>
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region employees_1 (
        name: Employees
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select EMPLOYEE_ID,
                       FIRST_NAME,
                       LAST_NAME,
                       EMAIL,
                       JOB_TITLE,
                       initcap(EMPLOYMENT_STATUS) as EMPLOYMENT_STATUS,
                       case EMPLOYMENT_STATUS when 'ACTIVE' then 'u-success' 
                            when 'INACTIVE' then 'u-danger'
                            when 'LEAVE' then 'u-warning'
                       end BADGE_STATE,
                      case EMPLOYMENT_STATUS when 'ACTIVE' then 'fa-check-circle-o' 
                            when 'INACTIVE' then 'fa-times-circle-o'
                            when 'LEAVE' then 'fa-minus-circle-o'
                       end BADGE_ICON,
                       CAREER_LEVEL,
                       COST_CENTER_DESCRIPTION,
                       BUSINESS_UNIT,
                       TIMEZONE,
                       WORK_ARRANGEMENT,
                       AVATAR
                  from FSP_EMPLOYEES E, FSP_COST_CENTERS CC
                  where E.COST_CENTER_ID = CC.COST_CENTER_ID
                ```
        }
        orderBy {
            type: item
            item: {
                itemName: P5_ORDER_BY
                orderBys: {
                    REPORTS1: FIRST_NAME DESC
                    REPORTS2: LAST_NAME ASC
                    DEPTNO: JOB_TITLE ASC
                }
            }
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--hideHeader js-addHiddenHeadingRoleDesc
                t-CardsRegion--styleC
                t-Form--large
            ]
        }
        advanced {
            htmlDomId: employees_1
        }
        card {
            primaryKeyColumn1: EMPLOYEE_ID
        }
        title {
            advancedFormatting: true
            htmlExpression: &FIRST_NAME. &LAST_NAME. - &JOB_TITLE.
        }
        subtitle {
            column: EMAIL
        }
        iconAndBadge {
            badgeColumn: EMPLOYMENT_STATUS
            badgeCssClasses: &BADGE_STATE.
        }
        media {
            source: imageUrl
            url: #APEX_FILES#sample_data&AVATAR.
            position: first
            appearance: square
        }

        action email-employee (
            label: Email employee
            layout {
                position: secondary
                sequence: 30
            }
            behavior {
                type: redirectUrl
                targetUrl: mailto:&EMAIL.
            }
            appearance {
                displayType: textWithIcon
                icon: fa-envelope-o
                cssClasses: [
                    t-Button--noUI
                    u-color-1
                ]
            }
            serverSideCondition {
                type: itemIsNotNull
                item: EMAIL
            }
        )

        action view-profile (
            label: View profile
            layout {
                sequence: 20
            }
            behavior {
                target: {
                    page: 15
                    items: {
                        P15_EMPLOYEE_ID: &EMPLOYEE_ID.
                        P15_RETURN_PAGE: 5
                    }
                    clearCache: 15
                }
            }
            appearance {
                displayType: textWithIcon
                icon: fa-user
                hot: true
                cssClasses: t-Button--primary
            }
        )

    )

    region filter-employees (
        name: Filter employees
        type: facetedSearch
        source {
            filteredRegion: @employees_1
        }
        layout {
            sequence: 50
            slot: leftColumn
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            compactNosThreshold: 10000
            showCurrentFacets: selector
            currentFacetsSelector: #active_facets
        }

        facet P5_BUSINESS_UNIT (
            type: checkboxGroup
            label {
                label: Business Unit
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 90
            }
            listEntries {
                maxDisplayedEntries: 5
                allowToExclude: false
            }
            source {
                databaseColumn: BUSINESS_UNIT
            }
        )

        facet P5_CAREER_LEVEL (
            type: checkboxGroup
            label {
                label: Level
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 120
            }
            listEntries {
                maxDisplayedEntries: 5
                allowToExclude: false
            }
            source {
                databaseColumn: CAREER_LEVEL
            }
        )

        facet P5_JOB (
            type: checkboxGroup
            label {
                label: Job
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 20
            }
            listEntries {
                maxDisplayedEntries: 5
                allowToExclude: false
            }
            source {
                databaseColumn: JOB_TITLE
            }
        )

        facet P5_SEARCH (
            type: search
            label {
                label: Search
            }
            layout {
                sequence: 10
            }
            source {
                dbColumns: FIRST_NAME,LAST_NAME,EMAIL,JOB_TITLE,BUSINESS_UNIT,WORK_ARRANGEMENT
            }
        )

        facet P5_STATUS (
            type: checkboxGroup
            label {
                label: Status
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 100
            }
            listEntries {
                maxDisplayedEntries: 10
                allowToExclude: false
            }
            source {
                databaseColumn: EMPLOYMENT_STATUS
            }
        )

        facet P5_WORK_MODE (
            type: checkboxGroup
            label {
                label: Work Mode
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 110
            }
            listEntries {
                maxDisplayedEntries: 10
                allowToExclude: false
            }
            source {
                databaseColumn: WORK_ARRANGEMENT
            }
        )

    )

    pageItem P5_ORDER_BY (
        type: selectList
        label {
            label: Order By
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:First Name;REPORTS1,Last Name;REPORTS2,Job Title;DEPTNO
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @button-bar
            slot: next
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: #DEFAULT#
            icon: fa-sort
            height: 1
        }
        validation {
            valueRequired: true
        }
        advanced {
            cssClasses: no-item-ui
            warnOnUnsavedChanges: ignore
        }
        default {
            type: static
            staticValue: REPORTS1
        }
    )

    button employee (
        buttonName: Employee
        label: Employee
        layout {
            sequence: 30
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 15
                clearCache: 15
            }
        }
    )

    button reset (
        buttonName: RESET
        label: Reset
        layout {
            sequence: 20
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-undo
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 5
                clearCache: 5
                action: resetRegions
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

