list administration (
    name: Administration

    entry reset-data (
        label: Reset Data
        icon {
            imageIconCssClasses: fa-refresh
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 602
            }
        }
        userDefinedAttributes {
            1: This application ships with sample data. You can reset the sample data using this administrative page.
        }
    )

    entry theme-style-selection (
        label: Theme Style Selection
        icon {
            imageIconCssClasses: fa-table
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 601
            }
        }
        userDefinedAttributes {
            1: Set the default application look and feel
        }
    )

)

list data-presentation (
    name: Data Presentation

    entry charts-from-json (
        label: Charts from JSON
        icon {
            imageIconCssClasses: fa-bar-chart
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 402
            }
        }
        userDefinedAttributes {
            1: Visualizes JSON data using dynamic charts and graphical components.
        }
    )

    entry faceted-search (
        label: Faceted Search
        icon {
            imageIconCssClasses: fa-server-search
        }
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 403
            }
        }
        userDefinedAttributes {
            1: Enables advanced filtering and search capabilities across JSON datasets.
        }
    )

    entry interactive-grid (
        label: Interactive Grid
        icon {
            imageIconCssClasses: fa-layout-grid-3x
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 401
            }
        }
        userDefinedAttributes {
            1: Provides an editable grid interface for managing structured and JSON-based data.
        }
    )

    entry map (
        label: Map
        icon {
            imageIconCssClasses: fa-map-marker
        }
        layout {
            sequence: 50
        }
        link {
            target: {
                page: 404
            }
        }
        userDefinedAttributes {
            1: Displays location-based data using map visualization integrated with JSON data.
        }
    )

    entry master-detail (
        label: Master Detail
        icon {
            imageIconCssClasses: fa-layout-header-sidebar-left
        }
        layout {
            sequence: 60
        }
        link {
            target: {
                page: 405
            }
        }
        userDefinedAttributes {
            1: Shows relationships between datasets with synchronized master-detail views.
        }
    )

    entry search-page (
        label: Search Page
        icon {
            imageIconCssClasses: fa-search
        }
        layout {
            sequence: 45
        }
        link {
            target: {
                page: 408
            }
        }
        userDefinedAttributes {
            1: Searches JSON-based product data instantly using Standard Search Configuration.
        }
    )

)

list home (
    name: Home

    entry data-presentation (
        label: Data Presentation
        icon {
            imageIconCssClasses: fa-bar-chart
        }
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 400
            }
        }
        userDefinedAttributes {
            1: Highlights different ways to visualize and interact with data in APEX.
        }
    )

    entry duality-view (
        label: Duality View
        icon {
            imageIconCssClasses: fa-exchange
        }
        layout {
            sequence: 55
        }
        link {
            target: {
                page: 200
            }
        }
        userDefinedAttributes {
            1: Showcases bidirectional synchronization between relational data and JSON using duality views.
        }
    )

    entry json-sources (
        label: JSON Sources
        icon {
            imageIconCssClasses: fa-file-json-o
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 100
            }
        }
        userDefinedAttributes {
            1: Demonstrates how to work with JSON data stored in Oracle tables and collections.
        }
    )

    entry sql-json-functions (
        label: SQL/JSON Functions
        icon {
            imageIconCssClasses: fa-code
        }
        layout {
            sequence: 60
        }
        link {
            target: {
                page: 300
            }
        }
        userDefinedAttributes {
            1: Explores built-in SQL functions for querying and transforming JSON data manually.
        }
    )

    entry use-cases (
        label: Use Cases
        icon {
            imageIconCssClasses: fa-missile
        }
        layout {
            sequence: 50
        }
        link {
            target: {
                page: 500
            }
        }
        userDefinedAttributes {
            1: Provides practical examples of real-world JSON and APEX implementations.
        }
    )

)

list json-sources (
    name: JSON Sources

    entry json-collection-table (
        label: JSON Collection Table
        icon {
            imageIconCssClasses: fa-file-brackets
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 102
            }
        }
        userDefinedAttributes {
            1: Shows how to use JSON collections to manage JSON data.
        }
    )

    entry post-processing (
        label: Post Processing
        icon {
            imageIconCssClasses: fa-recycle
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 103
            }
        }
        userDefinedAttributes {
            1: Demonstrates transforming JSON data after retrieval using local processing logic.
        }
    )

    entry table-with-json-column (
        label: Table with JSON Column
        icon {
            imageIconCssClasses: fa-database-file
        }
        layout {
            sequence: 5
        }
        link {
            target: {
                page: 101
            }
        }
        userDefinedAttributes {
            1: Demonstrates storing and querying JSON data within relational table columns.
        }
    )

)

list navigation-bar (
    name: Navigation Bar

    entry about (
        label: About
        icon {
            imageIconCssClasses: fa-question-circle-o
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 700
                clearCache: 700
            }
        }
        config {
            buildOption: @feature-about-page
        }
    )

    entry administration (
        label: Administration
        icon {
            imageIconCssClasses: fa-gear
        }
        layout {
            sequence: 5
        }
        link {
            target: {
                page: 600
            }
        }
    )

    entry app-user (
        label: &APP_USER.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 15
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
    )

    entry list_item (
        label: ---
        layout {
            sequence: 20
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry sign-out (
        label: Sign Out
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 30
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

)

