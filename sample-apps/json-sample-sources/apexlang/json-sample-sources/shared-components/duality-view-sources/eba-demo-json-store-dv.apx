jsonDualityView eba_demo_json_store_dv (
    name: EBA_DEMO_JSON_STORE_DV
    source {
        location: localDatabase
        tableName: EBA_DEMO_JSON_STORES_DV
    }
    dataProfile {
        name: EBA_DEMO_JSON_STORE_DV
        rowSelector: .
    }

    dataProfileColumn address (
        columnName: ADDRESS
        source {
            sequence: 7
            dataType: varchar2
            maxLength: 512
        }
        parsing {
            pathExpression: address
        }
    )

    dataProfileColumn apex-metadata-asof (
        columnName: APEX_METADATA_ASOF
        source {
            sequence: 3
            dataType: varchar2
        }
        parsing {
            pathExpression: _metadata.asof
        }
        advanced {
            common: false
        }
    )

    dataProfileColumn apex-metadata-etag (
        columnName: APEX_METADATA_ETAG
        source {
            sequence: 2
            dataType: varchar2
        }
        parsing {
            pathExpression: _metadata.etag
        }
        advanced {
            common: false
        }
    )

    dataProfileColumn country (
        columnName: COUNTRY
        source {
            sequence: 4
            dataType: varchar2
            maxLength: 255
        }
        parsing {
            pathExpression: country
        }
    )

    dataProfileColumn country-code (
        columnName: COUNTRY_CODE
        source {
            sequence: 6
            dataType: varchar2
            maxLength: 2
        }
        parsing {
            pathExpression: country_code
        }
    )

    dataProfileColumn id (
        columnName: ID
        source {
            sequence: 1
            dataType: number
            primaryKey: true
        }
        parsing {
            pathExpression: _id
        }
    )

    dataProfileColumn location-latitude (
        columnName: LOCATION_LATITUDE
        source {
            sequence: 8
            dataType: number
        }
        parsing {
            pathExpression: location.latitude
        }
    )

    dataProfileColumn location-longitude (
        columnName: LOCATION_LONGITUDE
        source {
            sequence: 9
            dataType: number
        }
        parsing {
            pathExpression: location.longitude
        }
    )

    dataProfileColumn storename (
        columnName: STORENAME
        source {
            sequence: 5
            dataType: varchar2
            maxLength: 255
        }
        parsing {
            pathExpression: storeName
        }
    )

)

