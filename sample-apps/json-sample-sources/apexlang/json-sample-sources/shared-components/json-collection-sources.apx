    source {
        location: localDatabase
        tableName: EBA_DEMO_JSON_CUSTOMERS
    }
    dataProfile {
        name: EBA_DEMO_JSON_CUSTOMERS
        rowSelector: .
    }

    dataProfileColumn address-city (
