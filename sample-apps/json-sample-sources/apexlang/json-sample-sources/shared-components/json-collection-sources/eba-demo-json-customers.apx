        advanced {
            sourceDataType: string
        }
    )

    dataProfileColumn preferred-lang (
        columnName: PREFERRED_LANG
        source {
            sequence: 16
            parentColumn: @customer-metadata
            dataType: varchar2
        }
        parsing {
            pathExpression: preferred_lang
        }
        advanced {
            sourceDataType: string
        }
    )

    dataProfileColumn signup-channel (
        columnName: SIGNUP_CHANNEL
        source {
            sequence: 17
            parentColumn: @customer-metadata
            dataType: varchar2
        }
        parsing {
            pathExpression: signup_channel
        }
        advanced {
            sourceDataType: string
        }
    )

    dataProfileColumn subscribed (
        columnName: SUBSCRIBED
        source {
            sequence: 14
