lov countries (
    name: COUNTRIES
    source {
        location: jsonDualityView
        jsonDualityView: @eba_demo_json_store_dv
    }
    localPostProcessing {
        type: sqlQuery
        sqlQuery:
            ```sql
            select distinct 
                   COUNTRY,
                   COUNTRY_CODE
              from #APEX$SOURCE_DATA#
            ```
    }
    columnMapping {
        return: COUNTRY_CODE
        display: COUNTRY
        defaultSort: COUNTRY
    }
)

lov customers (
    name: CUSTOMERS
    source {
        location: jsonSource
        jsonSource: @eba_demo_json_customers
    }
    columnMapping {
        return: CUSTOMER_ID
        display: FULL_NAME
        defaultSort: FULL_NAME
    }
)

lov desktop-theme-styles (
    name: DESKTOP THEME STYLES
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select s.name d,
                   s.theme_style_id r
              from apex_application_theme_styles s,
                   apex_application_themes t
             where s.application_id = :app_id
               and t.application_id = s.application_id
               and t.theme_number   = s.theme_number
               and t.is_current     = 'Yes'
             order by 1
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

