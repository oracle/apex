page 105 (
    name: Create/Edit Ticket
    alias: EDIT-TICKET
    title: Create/Edit Ticket
    pageGroup: @json-sources
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: mustNotBePublicUser
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region comments (
        name: Comments
        title: Comments
        type: themeTemplateComponent/comments
        source {
            location: jsonSource
            jsonSource: @eba_demo_json_support_ticket
        }
        dataProfile {
            nestedRows: @comments
        }
        localPostProcessing {
            type: whereOrderByClause
            whereClause: C_ID = :P105_C_ID and COMMENTS_POS is not null
        }
        layout {
            sequence: 60
            parentRegion: @create-edit-ticket
            slot: regionBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
        accessibility {
            landmarkType: region
        }
        componentAppearance {
            display: report
        }
        settings {
            commentText: MESSAGE
            userName: AUTHOR
            date: CREATED_AT
            style: chatSpeechBubbles
        }

        column AUTHOR (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: AUTHOR
                dataType: varchar2
            }
        )

        column COMMENTS_POS (
            layout {
                sequence: 60
            }
            source {
                databaseColumn: COMMENTS_POS
                dataType: number
            }
        )

        column COMMENT_ID (
            layout {
                sequence: 50
            }
            source {
                databaseColumn: COMMENT_ID
                dataType: number
            }
        )

        column CREATED_AT (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: CREATED_AT
                dataType: date
            }
        )

        column C_ID (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: C_ID
                dataType: varchar2
                primaryKey: true
            }
        )

        column MESSAGE (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: MESSAGE
                dataType: varchar2
            }
        )

    )

    region create-edit-ticket (
        name: Create / Edit Ticket
        type: form
        source {
            location: jsonSource
            jsonSource: @eba_demo_json_support_ticket
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region identification (
        name: Identification
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @create-edit-ticket
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region ticket-details (
        name: Ticket details
        type: staticContent
        layout {
            sequence: 30
            parentRegion: @create-edit-ticket
            slot: regionBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--scrollBody
            ]
        }
    )

    pageItem P105_CONCERN_ORDER_ID (
        type: selectList
        label {
            label: Order Number
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select o.order_id as display,
                       o.order_id as return
                  from eba_demo_json_orders o
                 where o.customer_id = :P105_CUSTOMER_ID
                order by order_id
                
                ```
            nullDisplayValue: - Select Order -
        }
        cascadingLov {
            parentItems: P105_CUSTOMER_ID
        }
        layout {
            sequence: 40
            region: @ticket-details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @create-edit-ticket
            column: CONCERN_ORDER_ID
            dataType: number
        }
    )

    pageItem P105_CONCERN_PRODUCT_ID (
        type: selectList
        label {
            label: Product Name
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.product_name as display,
                       p.product_id   as return
                  from eba_demo_json_products p,
                       eba_demo_json_order_items oi
                 where oi.product_id = p.product_id
                   and oi.order_id = :P105_CONCERN_ORDER_ID
                
                ```
            nullDisplayValue: - Select Product -
        }
        cascadingLov {
            parentItems: P105_CONCERN_ORDER_ID
        }
        layout {
            sequence: 50
            region: @ticket-details
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @create-edit-ticket
            column: CONCERN_PRODUCT_ID
            dataType: number
        }
    )

    pageItem P105_CONCERN_STORE_ID (
        type: selectList
        label {
            label: Store Name
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct s.store_name as display,
                                s.store_id   as return
                  from eba_demo_json_stores s
                 where exists (select 1
                                 from eba_demo_json_orders o
                                where o.store_id = s.store_id
                                  and o.order_id = :P105_CONCERN_ORDER_ID)
                
                ```
            nullDisplayValue: - Select Store -
        }
        cascadingLov {
            parentItems: P105_CONCERN_ORDER_ID
        }
        layout {
            sequence: 60
            region: @ticket-details
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @create-edit-ticket
            column: CONCERN_STORE_ID
            dataType: number
        }
    )

    pageItem P105_CREATED_AT2 (
        type: hidden
        layout {
            sequence: 60
            region: @identification
            slot: regionBody
        }
        appearance {
            formatMask: DD-MON-YYYY HH24:MI
        }
        source {
            formRegion: @create-edit-ticket
            column: CREATED_AT2
            dataType: date
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P105_CREATED_DATE (
        type: hidden
        layout {
            sequence: 80
            region: @identification
            slot: regionBody
        }
        appearance {
            formatMask: DD-MON-YYYY
        }
        serverSideCondition {
            type: itemIsNull
            item: P105_C_ID
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P105_CUSTOMER_ID (
        type: selectList
        label {
            label: Customer's Full Name
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct c.full_name as display,
                                c.customer_id as return
                  from eba_demo_json_customers c,
                       eba_demo_json_orders    o
                 where o.customer_id = c.customer_id
                
                
                ```
            nullDisplayValue: - Select Customer -
        }
        layout {
            sequence: 10
            region: @ticket-details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @create-edit-ticket
            column: CUSTOMER_ID
            dataType: number
        }
    )

    pageItem P105_C_ID (
        type: hidden
        layout {
            sequence: 10
            region: @identification
            slot: regionBody
        }
        source {
            formRegion: @create-edit-ticket
            column: C_ID
            dataType: varchar2
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P105_DESCRIPTION (
        type: textarea
        label {
            label: Description
            alignment: left
        }
        layout {
            sequence: 70
            region: @identification
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
            height: 5
        }
        source {
            formRegion: @create-edit-ticket
            column: DESCRIPTION
            dataType: varchar2
        }
    )

    pageItem P105_PRIORITY (
        type: selectList
        label {
            label: Priority
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @priority
            displayExtraValues: false
            nullDisplayValue: - Select Priority -
        }
        layout {
            sequence: 40
            region: @identification
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @create-edit-ticket
            column: PRIORITY
            dataType: varchar2
        }
    )

    pageItem P105_STATUS (
        type: selectList
        label {
            label: Status
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @status
            displayExtraValues: false
            nullDisplayValue: - Select Status -
        }
        layout {
            sequence: 30
            region: @identification
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @create-edit-ticket
            column: STATUS
            dataType: varchar2
        }
    )

    pageItem P105_TITLE (
        type: textField
        label {
            label: Title
            alignment: left
        }
        layout {
            sequence: 20
            region: @identification
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
            maxLength: 4000
        }
        source {
            formRegion: @create-edit-ticket
            column: TITLE
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P105_C_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P105_C_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P105_C_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    computation p105-created-date (
        itemName: P105_CREATED_DATE
        execution {
            sequence: 20
        }
        computation {
            type: item
            itemName: P105_CREATED_AT2
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 3595517975385823
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process default-created-date-for-insert (
        name: Default Created Date for Insert
        type: executeCode
        source {
            plsqlCode: :P105_CREATED_AT2 := to_char(sysdate,'DD-MON-YYYY HH24:MI');
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 3595192487385823
        }
        serverSideCondition {
            type: itemIsNull
            item: P105_C_ID
        }
    )

    process initialize-form-edit-ticket (
        name: Initialize form edit ticket
        type: formInitialization
        formRegion: @create-edit-ticket
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 3574868301385806
        }
    )

    process process-form-edit-ticket (
        name: Process form edit ticket
        type: formAutoRowProcessing
        formRegion: @create-edit-ticket
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 3575257199385806
        }
    )

)

