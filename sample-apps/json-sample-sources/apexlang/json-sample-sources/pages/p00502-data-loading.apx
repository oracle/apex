    pageItem P502_JSON_FILE (
        type: fileUpload
        label {
            label: JSON file
            alignment: left
        }
        display {
            displayAs: blockDropzone
        }
        storage {
            type: appTempFiles
        }
        layout {
            sequence: 10
            region: @load-json
            slot: regionBody
            alignment: left
            columnSpan: 12
            labelColumnSpan: 0
        }
        appearance {
            template: @/hidden
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
    )

    pageItem P502_LOADED_ROW_COUNT (
        type: hidden
        layout {
            sequence: 20
            region: @load-json
            slot: regionBody
