        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 30
            region: @load-json
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
            executeValidations: false
        }
    )

    button next (
        buttonName: NEXT
        label: Next
        layout {
            sequence: 10
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: #DEFAULT#
            icon: fa-angle-right
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 503
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button previous (
        buttonName: PREVIOUS
        label: Previous
        layout {
            sequence: 10
            region: @breadcrumb
            slot: previous
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: #DEFAULT#
            icon: fa-angle-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 500
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button upload (
        buttonName: UPLOAD
        label: Upload
        layout {
            sequence: 30
            region: @load-json
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button upload-document (
        buttonName: upload_document
        label: Upload Document
        layout {
            sequence: 10
            region: @report-view-on-data-source
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-upload
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button upload-raw-document (
        buttonName: upload_raw_document
        label: Upload Document
        layout {
            sequence: 20
            region: @raw-json-documents
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-upload
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction close-region (
        name: Close Region
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-close-region (
            action: closeRegion
            affectedElements {
                selectionType: region
                region: @load-json
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction open-load-data-dialog (
        name: Open Load Data dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @upload-document
        }

        action native-open-region (
            action: openRegion
            affectedElements {
                selectionType: region
                region: @load-json
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction open-load-data-dialog-for-raw-document-region (
        name: Open Load Data dialog for raw document region
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @upload-raw-document
        }

        action native-open-region (
            action: openRegion
            affectedElements {
                selectionType: region
                region: @load-json
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process load-additional-json (
        name: Load additional JSON
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_uploaded_file blob;
                    l_uploaded_text clob;
                begin
                    select blob_content
                      into l_uploaded_file
                      from apex_application_temp_files
                     where name = :P502_JSON_FILE;
                
                    l_uploaded_text := apex_util.blob_to_clob( l_uploaded_file );
                
                    insert into eba_demo_json_support_ticket ( data )
                    select rtrim( t.column_value, chr( 13 ) )
                      from table( apex_string.split_clobs( l_uploaded_text, chr( 10 ) ) ) t
                     where rtrim( t.column_value, chr( 13 ) ) is not null;
                
                    :P502_LOADED_ROW_COUNT := sql%rowcount;
                end;
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: &P502_LOADED_ROW_COUNT. JSON documents loaded into the JSON Collection Table.
        }
        advanced {
            executionMappingIdentifier: 3780158475340711
        }
        serverSideCondition {
            whenButtonPressed: @upload
        }
    )

)

