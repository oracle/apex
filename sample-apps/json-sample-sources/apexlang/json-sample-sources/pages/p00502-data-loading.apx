page 502 (
    name: Data Loading
    alias: DATA-LOADING
    title: Data Loading
    pageGroup: @use-cases
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: mustNotBePublicUser
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region load-json (
        name: Load JSON
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>
                  Upload a file with <em>Support Tickets</em> JSON documents, one per row.
                  The <a href="#APP_FILES#additional-json-data.txt" download>additional-json-data.txt</a>
                  file contains sample data to use.
                </p>
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-size600x400
            ]
        }
    )

    region overview (
        name: Overview
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>
                This page demonstrates how to upload JSON documents directly through the UI and store them in the <strong>EBA_DEMO_JSON_SUPPORT_TICKET</strong> JSON collection table in Oracle APEX. It features views for both structured ticket data and raw JSON documents for easy viewing and management.
                </p>
                
                <p>
                To get started, click <strong>Upload Document</strong> to upload support ticket JSON documents into the collection table. 
                A sample file is available in the upload dialog to help you test the feature and load example data.
                </p>
                
                <p>
                Use the region selector to switch between the <strong>Report View on Data Source</strong> and the <strong>Raw JSON Documents</strong> view.
                </p>
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
    )

    region raw-json-documents (
        name: Raw JSON Documents
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select json_value( data, '$.ticket_id') as ticket_id,
                       data as json
                from   eba_demo_json_support_ticket
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 12877549017378835
        }

        column JSON (
            type: plainText
            heading {
                heading: Json
            }
            layout {
                sequence: 20
            }
            source {
                dataType: CLOB
            }
            columnFilter {
                type: none
            }
            advanced {
                endUserAlias: B
            }
            enableUsersTo {
                sort: false
                controlBreak: false
                aggregate: false
                compute: false
                chart: false
                groupBy: false
                pivot: false
            }
        )

        column TICKET_ID (
            type: plainText
            heading {
                heading: Ticket ID
            }
            layout {
                sequence: 10
            }
            accessibility {
                valueIdentifiesRow: true
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 138814 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn JSON (
                sequence: 2
            )

            displayColumn TICKET_ID (
                sequence: 1
            )

        )

    )

    region region-display-selector (
        name: Region Display Selector
        type: regionDisplaySelector
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        settings {
            includeShowAll: false
