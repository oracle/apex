page 200 (
    name: Duality View
    alias: DUALITY-VIEW
    title: Duality View
    pageGroup: @duality-view
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: mustNotBePublicUser
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region duality-view (
        name: Duality View
        type: themeTemplateComponent/contentRow
        source {
            location: jsonDualityView
            jsonDualityView: @eba_demo_json_store_dv
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
        accessibility {
            landmarkType: region
        }
        componentAppearance {
            display: report
        }
        settings {
            overline: &COUNTRY.
            title: &STORENAME.
            description: &ADDRESS.
            displayAvatar: true
        }
        plugin-avatar {
            icon: fa-store
            shape: circular
        }

        column ADDRESS (
            layout {
                sequence: 70
            }
            source {
                databaseColumn: ADDRESS
                dataType: varchar2
            }
        )

        column APEX_METADATA_ASOF (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: APEX_METADATA_ASOF
                dataType: varchar2
            }
        )

        column APEX_METADATA_ETAG (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: APEX_METADATA_ETAG
                dataType: varchar2
            }
        )

        column COUNTRY (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: COUNTRY
                dataType: varchar2
            }
        )

        column COUNTRY_CODE (
            layout {
                sequence: 60
            }
            source {
                databaseColumn: COUNTRY_CODE
                dataType: varchar2
            }
        )

        column ID (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: ID
                dataType: number
                primaryKey: true
            }
        )

        column LOCATION_LATITUDE (
            layout {
                sequence: 80
            }
            source {
                databaseColumn: LOCATION_LATITUDE
                dataType: number
            }
        )

        column LOCATION_LONGITUDE (
            layout {
                sequence: 90
            }
            source {
                databaseColumn: LOCATION_LONGITUDE
                dataType: number
            }
        )

        column STORENAME (
            layout {
                sequence: 50
            }
            source {
                databaseColumn: STORENAME
                dataType: varchar2
            }
            accessibility {
                valueIdentifiesRow: true
            }
        )

        action edit (
            position: primaryActions
            template: button
            label: Edit
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 201
                    items: {
                        P201_ID: &ID.
                    }
                    clearCache: 201
                }
            }
            appearance {
                displayType: icon
                icon: fa-pencil-square-o
            }
        )

    )

    region overview (
        name: Overview
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>
                This page demonstrates the use of JSON Relational Duality Views in Oracle APEX through a content row based on <strong>EBA_DEMO_JSON_STORES_DV</strong>. It supports full CRUD operations, showcasing how changes made to JSON data are seamlessly synchronized with the underlying relational structure.
                </p>
                
                <p>
                To get started, select a store record to view its JSON document representation. 
                You can then create, update, or delete data directly through the page interface and observe how the changes are automatically reflected in the underlying relational tables through the duality view.
                </p>
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
    )

    button add-store (
        buttonName: Add_Store
        label: Add Store
        layout {
            sequence: 10
            region: @duality-view
            slot: top
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 201
                clearCache: 201
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button next (
        buttonName: NEXT
        label: Next
        layout {
            sequence: 10
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: #DEFAULT#
            icon: fa-angle-right
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 300
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button previous (
        buttonName: PREVIOUS
        label: Previous
        layout {
            sequence: 10
            region: @breadcrumb
            slot: previous
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: #DEFAULT#
            icon: fa-angle-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 503
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction refresh-page (
        name: refresh page
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @duality-view
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @duality-view
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

