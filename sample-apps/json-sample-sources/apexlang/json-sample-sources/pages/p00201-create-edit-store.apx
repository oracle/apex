page 201 (
    name: Create/Edit Store
    alias: CREATE-EDIT-STORE
    title: Create/Edit Store
    pageGroup: @duality-view
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: mustNotBePublicUser
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region edit-create-store (
        name: Edit/Create Store
        type: form
        source {
            location: jsonDualityView
            jsonDualityView: @eba_demo_json_store_dv
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P201_ADDRESS (
        type: textarea
        label {
            label: Address
            alignment: left
        }
        layout {
            sequence: 60
            region: @edit-create-store
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            valueRequired: true
            maxLength: 512
        }
        source {
            formRegion: @edit-create-store
            column: ADDRESS
            dataType: varchar2
        }
    )

    pageItem P201_COUNTRY (
        type: hidden
        layout {
            sequence: 20
            region: @edit-create-store
            slot: regionBody
        }
        source {
            formRegion: @edit-create-store
            column: COUNTRY
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P201_COUNTRY_CODE (
        type: selectList
        label {
            label: Country
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @countries
            displayExtraValues: false
            nullDisplayValue: - Select Country -
        }
        layout {
            sequence: 40
            region: @edit-create-store
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @edit-create-store
            column: COUNTRY_CODE
            dataType: varchar2
        }
        quickPicks {
            type: static
            label1: USA
            value1: US
            label2: Spain
            value2: ES
            label3: Germany
            value3: DE
            label4: India
            value4: IN
            label5: Australia
            value5: AU
            label6: Brazil
            value6: BR
            label7: Mexico
            value7: MX
            label8: China
            value8: CN
        }
    )

    pageItem P201_GEOCODED_ADDRESS (
        type: geocodedAddress
        label {
            label: Geocoded Address
            alignment: left
        }
        settings {
            structuredAddress: false
            triggerGeocoding: dynamicAction
        }
        geocodingInput {
            countryType: item
            country: P201_COUNTRY_CODE
            addressItem: P201_ADDRESS
        }
        layout {
            sequence: 110
            region: @edit-create-store
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P201_ID (
        type: hidden
        layout {
            sequence: 10
            region: @edit-create-store
            slot: regionBody
        }
        source {
            formRegion: @edit-create-store
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P201_LOCATION_LATITUDE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 90
            region: @edit-create-store
            slot: regionBody
        }
        source {
            formRegion: @edit-create-store
            column: LOCATION_LATITUDE
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P201_LOCATION_LONGITUDE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 100
            region: @edit-create-store
            slot: regionBody
        }
        source {
            formRegion: @edit-create-store
            column: LOCATION_LONGITUDE
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P201_STORENAME (
        type: textField
        label {
            label: Store Name
            alignment: left
        }
        layout {
            sequence: 30
            region: @edit-create-store
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @edit-create-store
            column: STORENAME
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 200
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P201_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P201_ID
        }
    )

    button geocode-address (
        buttonName: GEOCODE_ADDRESS
        label: Find Location
        layout {
            sequence: 70
            region: @edit-create-store
            slot: regionBody
            columnCssClasses: u-textEnd
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-map-marker
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P201_ID
        }
    )

    dynamicAction find-location (
        name: Find Location
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @geocode-address
        }

        action native-geocoding-trigger (
            action: triggerGeocoding
            affectedElements {
                selectionType: items
                items: P201_GEOCODED_ADDRESS
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction set-latitude-value (
        name: set _latitude_value
        execution {
            sequence: 20
        }
        when {
            event: item/geocodedAddress/apexgeocoderselection
            selectionType: items
            items: P201_GEOCODED_ADDRESS
        }

        action native-set-value (
            action: setValue
            settings {
                type: jsExpression
                jsExpression: this.data ? this.data.latitude : null
            }
            affectedElements {
                selectionType: items
                items: P201_LOCATION_LATITUDE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction set-longitude-value (
        name: set _longitude_value
        execution {
            sequence: 30
        }
        when {
            event: item/geocodedAddress/apexgeocoderselection
            selectionType: items
            items: P201_GEOCODED_ADDRESS
        }

        action native-set-value (
            action: setValue
            settings {
                type: jsExpression
                jsExpression: this.data ? this.data.longitude : null
            }
            affectedElements {
                selectionType: items
                items: P201_LOCATION_LONGITUDE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation lat-not-null (
        name: lat_not_null
        execution {
            sequence: 20
        }
        validation {
            plsqlExpression: :P201_LOCATION_LATITUDE is not null
        }
        error {
            errorMessage: Latitude can't be null!
            associatedItem: @P201_LOCATION_LATITUDE
        }
    )

    validation long-not-null (
        name: long_not_null
        execution {
            sequence: 10
        }
        validation {
            plsqlExpression: :P201_LOCATION_LONGITUDE is not null
        }
        error {
            errorMessage: Longitude can't be null!
            associatedItem: @P201_LOCATION_LONGITUDE
        }
    )

    computation p201-country (
        itemName: P201_COUNTRY
        execution {
            sequence: 10
            point: afterSubmit
        }
        computation {
            sqlQuery:
                ```sql
                select distinct country
                  from eba_demo_json_stores
                 where country_code = :P201_COUNTRY_CODE
                ```
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 10030597370461914
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE,UPDATE
        }
    )

    process display-geocodded-address (
        name: Display Geocodded Address
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P201_ID is not null
                   and :P201_LOCATION_LATITUDE is not null
                   and :P201_LOCATION_LONGITUDE is not null
                then
                  :P201_GEOCODED_ADDRESS :=
                      '{"type":"Point","coordinates":['
                      || apex_json.stringify(to_number( :P201_LOCATION_LONGITUDE))
                      || ','
                      || apex_json.stringify(to_number( :P201_LOCATION_LATITUDE))
                      || ']}';
                end if;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 10032307887461932
        }
    )

    process initialize-form-edit-create-store (
        name: Initialize form Edit/Create Store
        type: formInitialization
        formRegion: @edit-create-store
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 10042907666488926
        }
    )

    process process-form-edit-create-store (
        name: Process form Edit/Create Store
        type: formAutoRowProcessing
        formRegion: @edit-create-store
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 10043388835488926
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 200
            }
        }
    )

)

