page 602 (
    name: Reset Data
    alias: RESET-DATA
    title: Reset Data
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @administration-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @reset-data
            slot: subRegions
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region reset-data (
        name: Reset Data
        type: staticContent
        source {
            htmlCode: <p>Click the <strong>Reset Data</strong> button to reset data used in this application to its initial defaults.</p>
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/alert
            templateOptions: [
                #DEFAULT#
                t-Alert--wizard
                t-Alert--defaultIcons
                t-Alert--info
            ]
        }
    )

    button cancel (
        buttonName: Cancel
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 600
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button reset-data (
        buttonName: Reset_Data
        label: Reset Data
        layout {
            sequence: 10
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process load-product-images (
        name: Load product images
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin 
                    eba_demo_json_data_pkg.load_product_images(:APP_ID,'product_images.zip');
                end;    
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 11886800705269337
        }
        serverSideCondition {
            whenButtonPressed: @reset-data
            type: noRowsReturned
            sqlQuery: select * from eba_demo_json_products where product_image is not null
        }
    )

    process reset-data (
        name: Reset Data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    eba_demo_json_data_pkg.reset_data;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: The sample data used in this application has been reset successfully.
        }
        error {
            errorMessage: Error while resetting the data. Please try again.
        }
        advanced {
            executionMappingIdentifier: 4455571935920187
        }
        serverSideCondition {
            whenButtonPressed: @reset-data
        }
    )

    branch (
        name: go back to home
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 1
            }
        }
    )

)

