page 407 (
    name: Create/Edit Order
    alias: CREATE-EDIT-ORDER
    title: Create/Edit Order
    pageGroup: @data-presentation
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: mustNotBePublicUser
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region edit-create-order (
        name: Edit / Create Order
        title: Edit / Create Order
        type: form
        source {
            location: jsonDualityView
            jsonDualityView: @eba_demo_json_customer_orders_dv
        }
        dataProfile {
            nestedRows: @orders
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P407_EMAIL_ADDRESS (
        type: hidden
        layout {
            sequence: 40
            region: @edit-create-order
            slot: regionBody
        }
        source {
            formRegion: @edit-create-order
            column: EMAIL_ADDRESS
            dataType: varchar2
            queryOnly: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P407_FULL_NAME (
        type: hidden
        layout {
            sequence: 30
            region: @edit-create-order
            slot: regionBody
        }
        source {
            formRegion: @edit-create-order
            column: FULL_NAME
            dataType: varchar2
            queryOnly: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P407_ID (
        type: hidden
        layout {
            sequence: 10
            region: @edit-create-order
            slot: regionBody
        }
        source {
            formRegion: @edit-create-order
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P407_ORDERS_POS (
        type: hidden
        layout {
            sequence: 80
            region: @edit-create-order
            slot: regionBody
        }
        source {
            formRegion: @edit-create-order
            column: ORDERS_POS
            dataType: number
            queryOnly: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P407_ORDER_DATETIME (
        type: datePicker
        label {
            label: Order Datetime
            alignment: left
        }
        layout {
            sequence: 70
            region: @edit-create-order
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            formatMask: DD-MON-YYYY
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 10
        }
        source {
            formRegion: @edit-create-order
            column: ORDER_DATETIME
            dataType: timestamp
        }
    )

    pageItem P407_ORDER_ID (
        type: hidden
        layout {
            sequence: 20
            region: @edit-create-order
            slot: regionBody
        }
        source {
            formRegion: @edit-create-order
            column: ORDER_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P407_ORDER_STATUS (
        type: selectList
        label {
            label: Order Status
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @order-status
            nullDisplayValue: - Select Status -
        }
        layout {
            sequence: 60
            region: @edit-create-order
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @edit-create-order
            column: ORDER_STATUS
            dataType: varchar2
        }
    )

    pageItem P407_STORE_ID (
        type: selectList
        label {
            label: Store
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @stores
            nullDisplayValue: - Select Store -
        }
        layout {
            sequence: 50
            region: @edit-create-order
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @edit-create-order
            column: STORE_ID
            dataType: number
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P407_ID is null or :P407_ORDER_ID is null
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P407_ID is not null and :P407_ORDER_ID is not null
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P407_ID is not null and :P407_ORDER_ID is not null
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation p407-order-datetime-must-be-timestamp (
        name: P407_ORDER_DATETIME must be timestamp
        execution {
            sequence: 50
        }
        validation {
            type: itemIsAValidTimestamp
            item: P407_ORDER_DATETIME
        }
        error {
            errorMessage: #LABEL# must be a valid timestamp.
            associatedItem: @P407_ORDER_DATETIME
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            itemsToReturn: [
                P407_ID
                REQUEST
            ]
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 9962425914444835
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-orders (
        name: Initialize form Orders
        type: formInitialization
        formRegion: @edit-create-order
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 9961697569444835
        }
    )

    process process-form-orders (
        name: Process form Orders
        type: formAutoRowProcessing
        formRegion: @edit-create-order
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 9962039832444835
        }
    )

)

