    dynamicAction da-hide-fields-on-load (
        name: DA - Hide Fields on Load
        execution {
            sequence: 70
        }
        when {
            event: ready
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P503_EMAIL_ADDRESS
                    P503_STORE_ID
                    P503_PRODUCT_ID
                    P503_QUANTITY
                    P503_PAYMENT_METHOD
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction da-show-email-and-store (
        name: DA - Show Email and Store
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P503_CUSTOMER_ID
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P503_CUSTOMER_ID
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P503_EMAIL_ADDRESS
                    P503_STORE_ID
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action show-email (
            name: Show Email
            action: show
            affectedElements {
                selectionType: items
                items: P503_EMAIL_ADDRESS
            }
            execution {
                sequence: 10
            }
        )

        action show-store (
            name: " Show Store"
            action: show
            affectedElements {
                selectionType: items
                items: P503_STORE_ID
            }
            execution {
                sequence: 20
            }
        )

    )

    dynamicAction da-show-product (
        name: DA - Show Product
        execution {
            sequence: 80
        }
        when {
            selectionType: items
            items: P503_STORE_ID
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P503_STORE_ID
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P503_PRODUCT_ID
                    P503_QUANTITY
                    P503_PAYMENT_METHOD
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action show-product (
            name: Show Product
            action: show
            affectedElements {
                selectionType: items
                items: P503_PRODUCT_ID
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction da-show-quantity-payment-method-and-switch-button (
        name: DA - Show Quantity , Payment Method and switch button
        execution {
            sequence: 90
        }
        when {
            selectionType: items
            items: P503_PRODUCT_ID
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P503_PRODUCT_ID
        }

        action hide-quantity-payment-method-and-and-switch-button (
            name: Hide Quantity , Payment Method and and switch button
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P503_QUANTITY
                    P503_PAYMENT_METHOD
                    P503_DEFAULT_ADDRESS
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action show-quantity-payment-method-and-switch-button (
            name: Show Quantity , Payment Method and switch button
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P503_QUANTITY
                    P503_PAYMENT_METHOD
                    P503_DEFAULT_ADDRESS
                ]
            }
            execution {
                sequence: 20
            }
        )

    )

    dynamicAction da-toggle-shipment-address-fields (
        name: DA - Toggle Shipment Address Fields
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P503_DEFAULT_ADDRESS
        }
        clientSideCondition {
            type: item=value
            item: P503_DEFAULT_ADDRESS
            value: Y
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P503_STREET
                    P503_CITY
                    P503_STATE
                    P503_COUNTRY
                    P503_POSTAL_CODE
                ]
            }
            execution {
                sequence: 10
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P503_STREET
                    P503_CITY
                    P503_STATE
                    P503_COUNTRY
                    P503_POSTAL_CODE
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

    dynamicAction fetch-customer-email (
        name: Fetch Customer Email
        execution {
            sequence: 40
        }
        when {
            selectionType: items
            items: P503_CUSTOMER_ID
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select email_address
                      from eba_demo_json_customers
                     where customer_id = :P503_CUSTOMER_ID
                    
                    ```
                itemsToSubmit: P503_CUSTOMER_ID
            }
            affectedElements {
                selectionType: items
                items: P503_EMAIL_ADDRESS
            }
            execution {
                sequence: 10
            }
        )

    )

    process clear-form-items (
        name: CLEAR_FORM_ITEMS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  :P503_CUSTOMER_ID      := null;
                  :P503_STORE_ID         := null;
                  :P503_PRODUCT_ID       := null;
                  :P503_QUANTITY         := 1;
                  :P503_PAYMENT_METHOD   := 'Card';
                  :P503_STREET           := null;
                  :P503_CITY             := null;
                  :P503_STATE            := null;
                  :P503_COUNTRY          := null;
                  :P503_POSTAL_CODE      := null;
                  :P503_DEFAULT_ADDRESS  := 'Y';
                  :P503_EMAIL_ADDRESS    := null;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 9599173390718216
        }
    )

    process fetch-customer-address (
        name: Fetch Customer Address
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  select json_value(customer_metadata, '$.address.street')          as street,
                         json_value(customer_metadata, '$.address.city')            as city,
                         json_value(customer_metadata, '$.address.state_province')  as state,
                         json_value(customer_metadata, '$.address.country')         as country,
                         json_value(customer_metadata, '$.address.postal_code')     as postal_code
                    into :P503_STREET,
                         :P503_CITY,
                         :P503_STATE,
                         :P503_COUNTRY,
                         :P503_POSTAL_CODE
                    from eba_demo_json_customers
                   where customer_id = :P503_CUSTOMER_ID;
                exception
                   when no_data_found then
                      null;
                end;
                
                ```
        }
        execution {
            sequence: 5
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 13539640835675303
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                :P503_DEFAULT_ADDRESS = 'Y'
                and :P503_CUSTOMER_ID is not null
                ```
        }
    )

    process start-a-new-workflow (
        name: Start a new workflow
        type: workflow
        workflow {
            definition: @ORDER_PLACEMENT_WORKFLOW_1
        }
        workflowInstance {
            returnWorkflowIdItem: P503_WF_ID
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Workflow started
        }
        error {
            errorMessage: Error
        }
        advanced {
            executionMappingIdentifier: 6137831472528791
        }

        parameter (
            name: @P_CUSTOMER_ID
            value {
                item: P503_CUSTOMER_ID
            }
        )

        parameter (
            name: @P_PRODUCT_ID
            value {
                item: P503_PRODUCT_ID
            }
        )

        parameter (
            name: @P_QUANTITY
            value {
                item: P503_QUANTITY
            }
        )

        parameter (
            name: @P_STORE_ID
            value {
                item: P503_STORE_ID
            }
        )

        parameter (
            name: @P_PAYMENT_METHOD
            value {
                item: P503_PAYMENT_METHOD
            }
        )

        parameter (
            name: @P_STREET
            value {
                item: P503_STREET
            }
        )

        parameter (
            name: @P_CITY
            value {
                item: P503_CITY
            }
        )

        parameter (
            name: @P_STATE
            value {
                item: P503_STATE
            }
        )

        parameter (
            name: @P_COUNTRY
            value {
                item: P503_COUNTRY
            }
        )

        parameter (
            name: @P_POSTAL_CODE
            value {
                item: P503_POSTAL_CODE
            }
        )

        parameter (
            name: @P_EMAIL_ADDRESS
            value {
                item: P503_EMAIL_ADDRESS
            }
        )

    )

)

