                }
                colors {
                    background: #ffd6d2
                }
                execution {
                    sequence: 10
                }
            )

            highlight ir-condition-5 (
                condition {
                    column: CUSTOMER_NAME
                    operator: isNotNull
                }
                highlight {
                    type: cell
                }
                colors {
                    background: #e8e8e8
                }
                execution {
                    sequence: 10
                }
            )

        )

    )

    button next (
