                heading: Ticket ID
            }
            layout {
                sequence: 90
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column TITLE (
            type: plainText
            heading {
                heading: Title
            }
            layout {
                sequence: 20
            }
            accessibility {
                valueIdentifiesRow: true
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 48769 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CREATED_AT (
                sequence: 6
            )

            displayColumn CUSTOMER_NAME (
                sequence: 7
            )

            displayColumn DESCRIPTION (
                sequence: 5
            )

            displayColumn PRIORITY (
                sequence: 3
            )

            displayColumn STATUS (
                sequence: 2
            )

            displayColumn STATUS_FLAG (
                sequence: 9
            )

            displayColumn STORE_NAME (
                sequence: 8
            )

            displayColumn TICKET_ID (
                sequence: 4
            )

            displayColumn TITLE (
                sequence: 1
            )

            highlight ir-condition (
                condition {
                    column: STORE_NAME
                    operator: isNotNull
                }
                highlight {
                    type: cell
                }
                colors {
                    background: #e8e8e8
                }
                execution {
                    sequence: 10
                }
            )

            highlight ir-condition-2 (
                condition {
                    column: STATUS_FLAG
