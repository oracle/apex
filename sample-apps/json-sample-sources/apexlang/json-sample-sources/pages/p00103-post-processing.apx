                    background: #d0f1cc
                }
                execution {
                    sequence: 10
                }
            )

            highlight ir-condition-3 (
                condition {
                    column: STATUS_FLAG
                    value: Pending
                }
                highlight {
                    type: cell
                }
                colors {
