page 3 (
    name: Employees Content Row
    alias: EMPLOYEES-CONTENT-ROW
    title: Employees Content Row
    appearance {
        pageTemplate: @/standard
        templateOptions: [
            #DEFAULT#
            t-PageBody--noContentPadding
        ]
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            /* Fix wrapping of Quick Picks during page load */
            .t-Form-itemWrapper:has(.apex-quick-picks) {
                flex-wrap: wrap;
            
               .apex-quick-picks {
                    order: 5;
               }
            }
            
            /* Add margin to quick picks */
            .apex-quick-picks {
                margin-block-start: .25rem;
            }
            ```
    }
    security {
        authentication: public
    }
    help {
        helpText:
            ```html
            <h3>Search with a Content Row region</h3>
            <p>
                This page provides full text search on the employee directory using a <strong>Content Row</strong> region. The 
                region SQL query makes use of the Oracle Text index, which allows to provide exact, fuzzy or name search. The
                index is configured to first do exact search on names, following by fuzzy search on names, 
                and then on other attributes,  so that the most relevant results are first.
            </p>
            <p>
                See the <em>Quick Picks</em> under the search field for examples.
            </p>
            <p><strong>Search Options</strong></p>
            <dl>
                <dt><code>Müller</code></dt>
                <dd>Search for <strong>Müller</strong> across all attributes, starting with the name. Apply normal and fuzzy search.</dd>
                <dt><code>email:jochen.margraf.30@example.invalid</code></dt>
                <dd>The <strong>email</strong> prefix initiates exact search for the given email address. Useful if that address is known.</dd>
                <dt><code>phone:4711</code> or <code>4711</code></dt>
                <dd>If a plain number is detected, then the search is done for phone numbers ending with the provided number.</dd>
                <dt><code>New York</code></dt>
                <dd>If the name of a known city is entered, then the search is done for the city.</dd>
                <dt><code>United States</code></dt>
                <dd>If the name of a known country is entered, then the search is done for the country.</dd>
            </dl>
            
            
            ```
    }

    region breadcrumb (
        name: Employees
        type: staticContent
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: [
                #DEFAULT#
                t-HeroRegion--hideIcon
                t-Form--noPadding
                t-Form--large
                t-Form--stretchInputs
            ]
        }
        accessibility {
            landmarkType: search
        }
    )

    region results (
        name: Results
        type: themeTemplateComponent/contentRow
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.*,
                       apex_util.prepare_url('f?p=' || :APP_ID || ':4:' || :APP_SESSION || '::::P4_EMPLOYEE_ID:' || employee_id ) as edit_url,
                       substr( last_name,1,1) || substr( first_name, 1,1) as initials
                  from eba_srch_txt_employees e
                 where contains( last_name, eba_search_text_helper.get_name_search_query( :P3_SEARCH ), 1 ) > 0
                
                ```
            pageItemsToSubmit: P3_SEARCH
        }
        orderBy {
            type: staticValue
            orderByClause: score(1) desc
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            display: report
        }
        settings {
            title: <a href="&EDIT_URL!RAW.">&FIRST_NAME. &LAST_NAME.</a>
            description:
                ```html
                <div class="u-flex u-flex-col u-gap-1">
                  <div>
                    <strong>&JOB_TITLE.</strong>
                    {if ?COST_CENTER/} &middot; &COST_CENTER.{endif/}
                  </div>
                
                  <div class="u-flex u-flex-wrap u-align-items-center u-gap-x-4 u-gap-y-1">
                    <span class="u-inline-flex u-align-items-center u-gap-2"
                          {if ?CURRENT_LOCAL_TIME/}title="Local time: &CURRENT_LOCAL_TIME!ATTR. &TIMEZONE!ATTR."{endif/}>
                      <span class="fa fa-flag-&COUNTRY_CODE!ATTR." aria-hidden="true"></span>
                      <span>{if ?CITY/}&CITY. &middot; {endif/}&COUNTRY.</span>
                    </span>
                
                    {if ?EMAIL/}
                      <a href="mailto:&EMAIL!ATTR." class="u-wrap-anywhere">&EMAIL.</a>
                    {endif/}
                
                    {if ?PHONE_NUMBER/}
                      <span>&PHONE_COUNTRY_CODE. &PHONE_NUMBER.</span>
                    {endif/}
                  </div>
                </div>
                ```
            displayAvatar: true
            displayBadge: true
        }
        plugin-avatar {
            type: initials
            initials: INITIALS
        }
        plugin-badge {
            label: Direct Reports
            value: DIRECT_REPORTS
            icon: fa-users
            style: subtle
            shape: circular
            size: medium
            columnWidth: small
            position: end
            alignment: end
        }
        pagination {
            type: scroll
            initialEntitiesCount: 30
        }
        messages {
            whenNoDataFound: No search conducted or no results found.
        }

        column CAREER_LEVEL (
            layout {
                sequence: 90
            }
            source {
                databaseColumn: CAREER_LEVEL
                dataType: varchar2
            }
        )

        column CITY (
            layout {
                sequence: 80
            }
            source {
                databaseColumn: CITY
                dataType: varchar2
            }
        )

        column COST_CENTER (
            layout {
                sequence: 110
            }
            source {
                databaseColumn: COST_CENTER_ID
                dataType: number
            }
            lov {
                type: sharedComponent
                lov: @cost-center
            }
        )

        column COUNTRY (
            layout {
                sequence: 60
            }
            source {
                databaseColumn: COUNTRY
                dataType: varchar2
            }
        )

        column COUNTRY_CODE (
            layout {
                sequence: 230
            }
            source {
                databaseColumn: COUNTRY_CODE
                dataType: varchar2
            }
        )

        column DIRECT_REPORTS (
            layout {
                sequence: 140
            }
            source {
                databaseColumn: DIRECT_REPORTS
                dataType: number
            }
        )

        column EDIT_URL (
            layout {
                sequence: 220
            }
            source {
                databaseColumn: EDIT_URL
                dataType: varchar2
            }
        )

        column EMAIL (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: EMAIL
                dataType: varchar2
            }
        )

        column EMPLOYEE_GROUPS (
            layout {
                sequence: 240
            }
            source {
                databaseColumn: EMPLOYEE_GROUPS
                dataType: clob
            }
        )

        column EMPLOYEE_ID (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: EMPLOYEE_ID
                dataType: number
                primaryKey: true
            }
        )

        column FIRST_NAME (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: FIRST_NAME
                dataType: varchar2
            }
            accessibility {
                valueIdentifiesRow: true
            }
        )

        column GENDER (
            layout {
                sequence: 250
            }
            source {
                databaseColumn: GENDER
                dataType: varchar2
            }
        )

        column GEOGRAPHIC_REGION (
            layout {
                sequence: 70
            }
            source {
                databaseColumn: GEOGRAPHIC_REGION
                dataType: varchar2
            }
        )

        column INITIALS (
            layout {
                sequence: 210
            }
            source {
                databaseColumn: INITIALS
                dataType: varchar2
            }
        )

        column JOB_TITLE (
            layout {
                sequence: 100
            }
            source {
                databaseColumn: JOB_TITLE
                dataType: varchar2
            }
        )

        column LAST_NAME (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: LAST_NAME
                dataType: varchar2
            }
            accessibility {
                valueIdentifiesRow: true
            }
        )

        column MANAGER_ID (
            layout {
                sequence: 120
            }
            source {
                databaseColumn: MANAGER_ID
                dataType: number
            }
        )

        column ORG_SIZE (
            layout {
                sequence: 130
            }
            source {
                databaseColumn: ORG_SIZE
                dataType: number
            }
        )

        column PERMALINK (
            layout {
                sequence: 190
            }
            source {
                databaseColumn: PERMALINK
                dataType: varchar2
            }
        )

        column PHONE_COUNTRY_CODE (
            layout {
                sequence: 150
            }
            source {
                databaseColumn: PHONE_COUNTRY_CODE
                dataType: varchar2
            }
        )

        column PHONE_NUMBER (
            layout {
                sequence: 160
            }
            source {
                databaseColumn: PHONE_NUMBER
                dataType: varchar2
            }
        )

        column PROFILE (
            layout {
                sequence: 170
            }
            source {
                databaseColumn: PROFILE
                dataType: clob
            }
        )

        column TAGS (
            layout {
                sequence: 180
            }
            source {
                databaseColumn: TAGS
                dataType: clob
            }
        )

        column TIMEZONE (
            layout {
                sequence: 200
            }
            source {
                databaseColumn: TIMEZONE
                dataType: varchar2
            }
        )

        column USER_ID (
            layout {
                sequence: 50
            }
            source {
                databaseColumn: USER_ID
                dataType: varchar2
            }
        )

        action details (
            position: primaryActions
            template: button
            label: Details
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 4
                    items: {
                        P4_EMPLOYEE_ID: &EMPLOYEE_ID.
                    }
                }
            }
            appearance {
                displayType: icon
                icon: fa-info-circle-o
            }
        )

    )

    pageItem P3_DUMMY (
        type: textField
        label {
            label: Dummy
            alignment: left
        }
        layout {
            sequence: 20
            region: @breadcrumb
            slot: searchFieldAndSmartFilters
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            cssClasses: u-hidden
            width: 30
        }
        config {
            buildOption: @commented-out
        }
    )

    pageItem P3_SEARCH (
        type: textField
        label {
            label: Search
            alignment: left
        }
        settings {
            subtype: search
        }
        layout {
            sequence: 10
            region: @breadcrumb
            slot: searchFieldAndSmartFilters
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: #DEFAULT#
            icon: fa-search
            width: 72
            valuePlaceholder: Search by name, email or last digits of phone number
        }
        quickPicks {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Müller'                              d, 'Müller'                              r from sys.dual                                                             union all 
                select 'city:' || lower(city) || ' müller'   d, 'city:' || lower(city) || ' müller'   r from eba_srch_txt_employees where last_name = 'Muller' and rownum=1   union all
                select 'New York'                            d, 'New York'                            r from sys.dual                                                             union all
                select 'France'                              d, 'France'                              r from sys.dual                                                             union all
                select 'email:' || email                     d, 'email:' || email                     r from eba_srch_txt_employees where country = 'France'   and rownum = 1 union all
                select 'phone:' || substr(phone_number, -3 ) d, 'phone:' || substr(phone_number, -3 ) r from eba_srch_txt_employees where country = 'Germany'  and rownum = 1
                
                ```
        }
    )

    dynamicAction keydown (
        name: KeyDown
        execution {
            sequence: 30
            type: debounce
            time: 250
        }
        when {
            event: keyup
            selectionType: items
            items: P3_SEARCH
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @results
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            clientSideCondition {
                type: jsExpression
                javaScriptExpression: $v("P3_SEARCH").length >= 2 || $v("P3_SEARCH").length === 0
            }
        )

    )

    dynamicAction search (
        name: Search
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P3_SEARCH
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @results
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

