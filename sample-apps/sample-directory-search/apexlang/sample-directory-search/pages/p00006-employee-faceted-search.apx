page 6 (
    name: Employee Faceted Search
    alias: EMPLOYEE-FACETED-SEARCH
    title: Employee Faceted Search
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: [
            #DEFAULT#
            t-PageBody--noContentPadding
        ]
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        authentication: public
    }
    help {
        helpText:
            ```html
            <h3>Search using Faceted Search</h3>
            <p>
                This page provides full text search on the employee directory as part of a Faceted Search region. The 
                <em>Search</em> facet has its <strong>Search Type</strong> attribute set to <strong>Oracle Text</strong>,  
                which allows to provide exact, fuzzy or name search. The
                index is configured to first do exact search on names, following by fuzzy search on names, 
                and then on other attributes,  so that the most relevant results are first.
            </p>
            <p><strong>Search Options</strong></p>
            <dl>
                <dt><code>Müller</code></dt>
                <dd>Search for <strong>Müller</strong> across all attributes, starting with the name. Apply normal and fuzzy search.</dd>
                <dt><code>email:jochen.margraf.30@example.invalid</code></dt>
                <dd>The <strong>email</strong> prefix initiates exact search for the given email address. Useful if that address is known.</dd>
                <dt><code>phone:4711</code> or <code>4711</code></dt>
                <dd>If a plain number is detected, then the search is done for phone numbers ending with the provided number.</dd>
                <dt><code>New York</code></dt>
                <dd>If the name of a known city is entered, then the search is done for the city.</dd>
                <dt><code>United States</code></dt>
                <dd>If the name of a known country is entered, then the search is done for the country.</dd>
            </dl>
            
            
            ```
    }

    region breadcrumb (
        name: Employees
        type: staticContent
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: [
                #DEFAULT#
                t-HeroRegion--hideIcon
                t-Form--noPadding
            ]
            renderComponents: belowContent
        }
        accessibility {
            landmarkType: search
        }
    )

    region results (
        name: Results
        type: themeTemplateComponent/contentRow
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select EMPLOYEE_ID,
                       FIRST_NAME,
                       LAST_NAME,
                       substr(LAST_NAME, 1, 1) || substr(FIRST_NAME, 1, 1) as INITIALS,
                       EMAIL,
                       USER_ID,
                       COUNTRY,
                       COUNTRY_CODE,
                       GEOGRAPHIC_REGION,
                       CITY,
                       CAREER_LEVEL,
                       JOB_TITLE,
                       COST_CENTER_ID,
                       COST_CENTER_DESCRIPTION,
                       MANAGER_ID,
                       ORG_SIZE,
                       DIRECT_REPORTS,
                       PHONE_COUNTRY_CODE,
                       PHONE_NUMBER,
                       PROFILE,
                       TAGS,
                       PERMALINK,
                       TIMEZONE,
                       employee_groups
                  from eba_srch_txt_EMPLOYEE_ORG_v
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
        accessibility {
            landmarkType: region
        }
        componentAppearance {
            display: report
        }
        settings {
            title: <a href="f?p=&APP_ID.:4:&APP_SESSION.::::P4_EMPLOYEE_ID:&EMPLOYEE_ID.">&FIRST_NAME. &LAST_NAME.</a>
            description:
                ```html
                <div class="u-flex u-flex-col u-gap-1">
                  <div>
                    <strong>&JOB_TITLE.</strong>
                    {if ?COST_CENTER_DESCRIPTION/} &middot; &COST_CENTER_DESCRIPTION.{endif/}
                  </div>
                
                  <div class="u-flex u-flex-wrap u-align-items-center u-gap-x-4 u-gap-y-1">
                    <span class="u-inline-flex u-align-items-center u-gap-2">
                      <span class="fa fa-flag-&COUNTRY_CODE!ATTR." aria-hidden="true"></span>
                      <span>&COUNTRY.</span>
                    </span>
                
                    {if ?EMAIL/}
                      <a href="mailto:&EMAIL!ATTR." class="u-wrap-anywhere">&EMAIL.</a>
                    {endif/}
                
                    <span>&DIRECT_REPORTS. Direct Reports</span>
                  </div>
                </div>
                ```
            miscellaneous:
                ```html
                {loop TAGS/}
                  <span class="a-Chip a-Chip--applied u-pointer-events-none u-text-body-2xs">&APEX$ITEM.</span>
                {endloop/}
                ```
            displayAvatar: true
        }
        plugin-avatar {
            type: initials
            initials: INITIALS
            size: small
        }

        column CAREER_LEVEL (
            layout {
                sequence: 90
            }
            source {
                databaseColumn: CAREER_LEVEL
                dataType: varchar2
            }
        )

        column CITY (
            layout {
                sequence: 80
            }
            source {
                databaseColumn: CITY
                dataType: varchar2
            }
        )

        column COST_CENTER_DESCRIPTION (
            layout {
                sequence: 120
            }
            source {
                databaseColumn: COST_CENTER_DESCRIPTION
                dataType: varchar2
            }
        )

        column COST_CENTER_ID (
            layout {
                sequence: 110
            }
            source {
                databaseColumn: COST_CENTER_ID
                dataType: number
            }
        )

        column COUNTRY (
            layout {
                sequence: 60
            }
            source {
                databaseColumn: COUNTRY
                dataType: varchar2
            }
        )

        column COUNTRY_CODE (
            layout {
                sequence: 230
            }
            source {
                databaseColumn: COUNTRY_CODE
                dataType: varchar2
            }
        )

        column DIRECT_REPORTS (
            layout {
                sequence: 150
            }
            source {
                databaseColumn: DIRECT_REPORTS
                dataType: number
            }
        )

        column EMAIL (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: EMAIL
                dataType: varchar2
            }
        )

        column EMPLOYEE_GROUPS (
            layout {
                sequence: 220
            }
            source {
                databaseColumn: EMPLOYEE_GROUPS
                dataType: clob
            }
        )

        column EMPLOYEE_ID (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: EMPLOYEE_ID
                dataType: number
            }
        )

        column FIRST_NAME (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: FIRST_NAME
                dataType: varchar2
            }
            accessibility {
                valueIdentifiesRow: true
            }
        )

        column GEOGRAPHIC_REGION (
            layout {
                sequence: 70
            }
            source {
                databaseColumn: GEOGRAPHIC_REGION
                dataType: varchar2
            }
        )

        column INITIALS (
            layout {
                sequence: 240
            }
            source {
                databaseColumn: INITIALS
                dataType: varchar2
            }
        )

        column JOB_TITLE (
            layout {
                sequence: 100
            }
            source {
                databaseColumn: JOB_TITLE
                dataType: varchar2
            }
        )

        column LAST_NAME (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: LAST_NAME
                dataType: varchar2
            }
            accessibility {
                valueIdentifiesRow: true
            }
        )

        column MANAGER_ID (
            layout {
                sequence: 130
            }
            source {
                databaseColumn: MANAGER_ID
                dataType: number
            }
        )

        column ORG_SIZE (
            layout {
                sequence: 140
            }
            source {
                databaseColumn: ORG_SIZE
                dataType: number
            }
        )

        column PERMALINK (
            layout {
                sequence: 200
            }
            source {
                databaseColumn: PERMALINK
                dataType: varchar2
            }
        )

        column PHONE_COUNTRY_CODE (
            layout {
                sequence: 160
            }
            source {
                databaseColumn: PHONE_COUNTRY_CODE
                dataType: varchar2
            }
        )

        column PHONE_NUMBER (
            layout {
                sequence: 170
            }
            source {
                databaseColumn: PHONE_NUMBER
                dataType: varchar2
            }
        )

        column PROFILE (
            layout {
                sequence: 180
            }
            source {
                databaseColumn: PROFILE
                dataType: clob
            }
        )

        column TAGS (
            layout {
                sequence: 190
            }
            source {
                databaseColumn: TAGS
                dataType: clob
            }
        )

        column TIMEZONE (
            layout {
                sequence: 210
            }
            source {
                databaseColumn: TIMEZONE
                dataType: varchar2
            }
        )

        column USER_ID (
            layout {
                sequence: 50
            }
            source {
                databaseColumn: USER_ID
                dataType: varchar2
            }
        )

    )

    region search (
        name: Search
        type: facetedSearch
        source {
            filteredRegion: @results
        }
        layout {
            sequence: 30
            slot: leftColumn
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
        settings {
            compactNosThreshold: 10000
            displayChartForTopNValues: 10
        }

        facet P6_COUNTRY (
            type: checkboxGroup
            label {
                label: Country
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 30
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: COUNTRY
            }
        )

        facet P6_EMPLOYEE_GROUPS (
            type: checkboxGroup
            label {
                label: Groups
            }
            lov {
                type: sharedComponent
                lov: @groups
            }
            layout {
                sequence: 50
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: EMPLOYEE_GROUPS
            }
            multipleValues {
                type: jsonArray
            }
        )

        facet P6_JOB_TITLE (
            type: checkboxGroup
            label {
                label: Job Title
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 40
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: JOB_TITLE
            }
        )

        facet P6_REGION (
            type: checkboxGroup
            label {
                label: Region
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 20
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: GEOGRAPHIC_REGION
            }
        )

        facet P6_SEARCH (
            type: search
            label {
                label: Search
            }
            settings {
                searchType: oracleText
                inputField: externalPageItem
                externalPageItem: P6_SEARCH_FIELD
            }
            layout {
                sequence: 10
            }
            source {
                dbColumns: LAST_NAME
            }
        )

    )

    pageItem P6_SEARCH_FIELD (
        type: textField
        label {
            label: Search Field
            alignment: left
        }
        settings {
            subtype: search
        }
        layout {
            sequence: 10
            region: @breadcrumb
            slot: searchFieldAndSmartFilters
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            icon: fa-search
            width: 72
            valuePlaceholder: Search...
        }
    )

    button reset (
        buttonName: RESET
        label: Reset
        layout {
            sequence: 10
            region: @breadcrumb
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
                t-Button--iconLeft
            ]
            icon: fa-undo
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 6
                clearCache: 6
                action: resetRegions
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

