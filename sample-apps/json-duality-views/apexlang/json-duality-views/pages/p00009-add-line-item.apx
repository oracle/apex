page 9 (
    name: Add Line Item
    alias: ADD-LINE-ITEM
    title: Add Line Item
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: mustNotBePublicUser
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region add-line-item-buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region add-line-item-form (
        name: Line Items
        type: form
        source {
            location: jsonDualityView
            jsonDualityView: @purchase-orders
            pageItemsToSubmit: P9_PRODUCT_ID
        }
        dataProfile {
            nestedRows: @line-items-profile-column
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P9_LINE_ID (
        type: hidden
        layout {
            sequence: 80
            region: @add-line-item-form
            slot: regionBody
        }
        source {
            formRegion: @add-line-item-form
            column: LINE_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P9_PO_ID (
        type: hidden
        layout {
            sequence: 70
            region: @add-line-item-form
            slot: regionBody
        }
        source {
            formRegion: @add-line-item-form
            column: PO_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P9_PRODUCT_ID (
        type: selectOne
        label {
            label: Product
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.description, p.product_id
                from dv_products p
                where not exists (
                    select 1
                    from dv_po_line_items li
                    where li.po_id = :P9_PO_ID
                    and li.product_id = p.product_id
                    and (:P9_LINE_ID is null or li.line_id <> :P9_LINE_ID)
                )
                order by p.description
                ```
        }
        layout {
            sequence: 10
            region: @add-line-item-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @add-line-item-form
            column: PRODUCT_ID
            dataType: number
            primaryKey: true
        }
    )

    pageItem P9_QUANTITY (
        type: numberField
        label {
            label: Quantity
            alignment: left
        }
        layout {
            sequence: 40
            region: @add-line-item-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @add-line-item-form
            column: QUANTITY
            dataType: number
        }
        default {
            type: static
            staticValue: 1
        }
    )

    pageItem P9_TOTAL (
        type: displayOnly
        label {
            label: Total Amount
            alignment: left
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 60
            region: @add-line-item-form
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: expression
            plsqlExpression: :P9_UNIT_PRICE * :P9_QUANTITY
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P9_UNIT_PRICE (
        type: numberField
        label {
            label: Unit Price
            alignment: left
        }
        layout {
            sequence: 50
            region: @add-line-item-form
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            formatMask: 999G999G999G999G990D00
            width: 30
        }
        source {
            formRegion: @add-line-item-form
            column: UNIT_PRICE
            dataType: number
        }
    )

    button cancel-add-line-item-button (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @add-line-item-buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create-add-line-item-button (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @add-line-item-buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P9_PO_ID is null or :P9_LINE_ID is null
        }
    )

    button delete-add-line-item-button (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @add-line-item-buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P9_PO_ID is not null and :P9_LINE_ID is not null
        }
    )

    button save-add-line-item-button (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @add-line-item-buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P9_PO_ID is not null and :P9_LINE_ID is not null
        }
    )

    dynamicAction cancel-add-line-item-dialog-da (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel-add-line-item-button
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction set-add-line-item-unit-price-da (
        name: Set Unit Price
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P9_PRODUCT_ID
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select unit_price
                    from dv_products
                    where product_id = :P9_PRODUCT_ID
                    ```
                itemsToSubmit: P9_PRODUCT_ID
            }
            affectedElements {
                selectionType: items
                items: P9_UNIT_PRICE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction update-add-line-item-total-da (
        name: Update Total
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: [
                P9_QUANTITY
                P9_UNIT_PRICE
            ]
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P9_QUANTITY
        }

        action calculate-total (
            name: Calculate Total
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: to_char(:P9_QUANTITY * :P9_UNIT_PRICE,'999G999G999G999G990D00')
                itemsToSubmit: [
                    P9_QUANTITY
                    P9_UNIT_PRICE
                ]
            }
            affectedElements {
                selectionType: items
                items: P9_TOTAL
            }
            execution {
                sequence: 10
                fireOnInit: false
                stopExecutionOnError: false
                waitForResult: false
            }
        )

    )

    process close-add-line-item-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 3409106504860887
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-add-line-item (
        name: Initialize form Line Items
        type: formInitialization
        formRegion: @add-line-item-form
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 3406135944860879
        }
    )

    process process-add-line-item (
        name: Process form Line Items
        type: formAutoRowProcessing
        formRegion: @add-line-item-form
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 3406512811860880
        }
    )

)

