page 8 (
    name: Line Item
    alias: LINE-ITEM
    title: Line Item
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: mustNotBePublicUser
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region line-item-buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region line-item-form (
        name: Line Items
        type: form
        source {
            location: jsonDualityView
            jsonDualityView: @purchase-orders
        }
        dataProfile {
            nestedRows: @line-items-profile-column
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P8_LINE_ID (
        type: hidden
        layout {
            sequence: 80
            region: @line-item-form
            slot: regionBody
        }
        source {
            formRegion: @line-item-form
            column: LINE_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P8_PO_ID (
        type: hidden
        layout {
            sequence: 70
            region: @line-item-form
            slot: regionBody
        }
        source {
            formRegion: @line-item-form
            column: PO_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P8_PRODUCT_DESC (
        type: textField
        label {
            label: Product Description
            alignment: left
        }
        layout {
            sequence: 30
            region: @line-item-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 200
        }
        source {
            formRegion: @line-item-form
            column: PRODUCT_DESC
            dataType: varchar2
        }
        readOnly {
            type: always
        }
    )

    pageItem P8_PRODUCT_PRODUCT_CODE (
        type: textField
        label {
            label: Product Code
            alignment: left
        }
        layout {
            sequence: 20
            region: @line-item-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 20
        }
        source {
            formRegion: @line-item-form
            column: PRODUCT_PRODUCT_CODE
            dataType: varchar2
        }
        readOnly {
            type: always
        }
    )

    pageItem P8_PRODUCT_UNIT_PRICE (
        type: hidden
        layout {
            sequence: 90
            region: @line-item-form
            slot: regionBody
        }
        source {
            formRegion: @line-item-form
            column: PRODUCT_UNIT_PRICE
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P8_QUANTITY (
        type: numberField
        label {
            label: Quantity
            alignment: left
        }
        layout {
            sequence: 40
            region: @line-item-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @line-item-form
            column: QUANTITY
            dataType: number
        }
    )

    pageItem P8_TOTAL (
        type: displayOnly
        label {
            label: Total Amount
            alignment: left
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 60
            region: @line-item-form
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            formatMask: FML999G999G999G999G990D00
        }
        default {
            type: expression
            plsqlExpression: :P8_UNIT_PRICE * :P8_QUANTITY
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P8_UNIT_PRICE (
        type: numberField
        label {
            label: Unit Price
            alignment: left
        }
        layout {
            sequence: 50
            region: @line-item-form
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @line-item-form
            column: UNIT_PRICE
            dataType: number
        }
    )

    button cancel-line-item-button (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @line-item-buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create-line-item-button (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @line-item-buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P8_PO_ID is null or :P8_LINE_ID is null
        }
    )

    button delete-line-item-button (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @line-item-buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P8_PO_ID is not null and :P8_LINE_ID is not null
        }
    )

    button save-line-item-button (
        buttonName: SAVE
        label: Apply
        layout {
            sequence: 30
            region: @line-item-buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            language: sql
            sqlExpression: :P8_PO_ID is not null and :P8_LINE_ID is not null
        }
    )

    dynamicAction cancel-line-item-dialog-da (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel-line-item-button
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction update-line-item-total-da (
        name: Update Total
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: [
                P8_QUANTITY
                P8_UNIT_PRICE
            ]
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P8_QUANTITY
        }

        action calculate-total (
            name: Calculate Total
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression:
                    ```plsql
                    to_char(:P8_QUANTITY * :P8_UNIT_PRICE,'999G999G999G999G990D00')
                    
                    ```
                itemsToSubmit: [
                    P8_QUANTITY
                    P8_UNIT_PRICE
                ]
            }
            affectedElements {
                selectionType: items
                items: P8_TOTAL
            }
            execution {
                sequence: 10
                fireOnInit: false
                stopExecutionOnError: false
                waitForResult: false
            }
        )

    )

    computation p8-unit-price (
        itemName: P8_UNIT_PRICE
        execution {
            sequence: 10
        }
        computation {
            type: item
            itemName: P8_PRODUCT_UNIT_PRICE
        }
        serverSideCondition {
            type: itemIsNull
            item: P8_UNIT_PRICE
        }
    )

    process close-line-item-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 3456916715966297
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-line-item (
        name: Initialize form Line Items
        type: formInitialization
        formRegion: @line-item-form
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 3453531359966286
        }
    )

    process process-line-item (
        name: Process form Line Items
        type: formAutoRowProcessing
        formRegion: @line-item-form
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 3453906926966286
        }
    )

)

