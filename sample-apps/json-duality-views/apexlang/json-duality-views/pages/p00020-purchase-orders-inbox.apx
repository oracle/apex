    dynamicAction dialog-closed (
        name: Refresh Line Items and Purchase Order
        execution {
            sequence: 40
        }
        when {
            event: apexafterclosedialog
            selectionType: jsExpression
            javaScriptExpression: window
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @dv-po-line-items
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @dv-purchase-orders
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh-4 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @master-records
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

    dynamicAction dialog-closed-2 (
        name: Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @dv-purchase-orders
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @dv-purchase-orders
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction perform-search (
        name: Perform Search
        execution {
            sequence: 150
        }
        when {
            event: keypress
            selectionType: items
            items: P20_SEARCH
        }
        clientSideCondition {
            type: item=value
            item: JAVASCRIPT_EXPRESSION
            value: this.browserEvent.which === apex.jQuery.ui.keyCode.ENTER
        }

        action native-cancel-event (
            action: cancelEvent
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @master-records
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process select-first-purchase-order (
        name: Select First Purchase Order
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    select po_id
                      into :P20_PO_ID
                      from (
                          select json_value(data, '$._id' returning number) po_id
                            from dv_purchase_order_dv
                           order by json_value(data, '$.last_updated') desc nulls last,
                                    json_value(data, '$.po_number')
                      )
                     where rownum = 1;
                exception
                    when no_data_found then
                        null;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 2427822935534829
        }
        serverSideCondition {
            type: itemIsNull
            item: P20_PO_ID
        }
    )

)

