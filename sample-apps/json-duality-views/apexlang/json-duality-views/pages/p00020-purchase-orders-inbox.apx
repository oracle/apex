    region master-records (
        name: Purchase Orders
        type: classicReport
        source {
            location: jsonDualityView
            jsonDualityView: @purchase-orders
            pageItemsToSubmit: P20_SEARCH
        }
        localPostProcessing {
            type: sqlQuery
            sqlQuery:
                ```sql
                select "PO_ID",
                    null LINK_CLASS,
                    apex_page.get_url(p_items => 'P20_PO_ID', p_values => "PO_ID") LINK,
                    -- null ICON_CLASS,
                   case STATUS
                     when 'COMPLETED' then 'fa fa-file-check'
                     when 'REJECTED' then 'fa fa-file-x'
                     else 'fa fa-file-edit'
                   end ICON_CLASS,
                    null LINK_ATTR,
                   case STATUS
                     when 'COMPLETED' then 'u-success'
                     when 'REJECTED' then 'u-danger'
                     else 'u-info'
                   end ICON_COLOR_CLASS,
                    case when coalesce(:P20_PO_ID,'0') = "PO_ID"
                      then 'is-selected' 
                      else ' '
                    end LIST_CLASS,
                    'PO #' || "PO_NUMBER" LIST_TITLE,
                    substr(
                        coalesce("CUSTOMER_COMPANY_NAME", "CUSTOMER_NAME") ||
                        chr(10) ||
                        to_char("TOTAL_AMOUNT", 'FML999G999G990D00') ||
                        ' · ' ||
                        to_char("DATE", 'Mon DD, YYYY'),
                        1,
                        200
                    ) LIST_TEXT,
                    "STATUS" LIST_BADGE
                from #APEX$SOURCE_DATA#
                where :P20_SEARCH is null
                   or instr(
                        upper(
                            "PO_NUMBER" || ' ' ||
                            "STATUS" || ' ' ||
                            coalesce("CUSTOMER_COMPANY_NAME", "CUSTOMER_NAME") || ' ' ||
                            "CUSTOMER_EMAIL"
                        ),
                        upper(:P20_SEARCH)
                      ) > 0
                order by "LAST_UPDATED" desc nulls last, "PO_NUMBER"
                ```
        }
        layout {
            sequence: 40
            slot: leftColumn
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
            cssClasses: search-results
        }
        reportLayout {
            numberOfRows: 1000
        }
        componentAppearance {
            template: @/media-list
            templateOptions: [
                t-MediaList--showIcons
                t-MediaList--showDesc
                t-MediaList--stack
            ]
        }
        messages {
            whenNoDataFound: <div class="u-tC">No data found.</div>
        }

