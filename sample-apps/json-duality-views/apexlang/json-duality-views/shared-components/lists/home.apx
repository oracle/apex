list home (
    name: Home

    entry about-duality-view (
        label: About JSON Relational Duality Views
        icon {
            imageIconCssClasses: fa-info-circle
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 22
            }
        }
        userDefinedAttributes {
            translatable: true
            1: Review the JSON Relational Duality View DDL, generated JSON schema, and sample JSON document shape used by the app.
        }
    )

    entry purchase-orders-inbox (
        label: Purchase Orders Inbox
        icon {
            imageIconCssClasses: fa-inbox
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 20
            }
        }
        userDefinedAttributes {
            translatable: true
            1: Explore the email-style parent and child pattern with purchase orders in the left sidebar and details on the right.
        }
    )

    entry purchase-orders-stacked (
        label: Purchase Orders Report
        icon {
            imageIconCssClasses: fa-table
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 10
            }
        }
        userDefinedAttributes {
            translatable: true
            1: Use the vertical parent and child pattern with the purchase order parent above nested line items.
        }
    )

)

