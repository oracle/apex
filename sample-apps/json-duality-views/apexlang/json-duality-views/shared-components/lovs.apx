lov boolean (
    name: BOOLEAN
    source {
        location: staticValues
    }

    entry false (
        sequence: 2
        display: No
        return: FALSE
    )

    entry true (
        sequence: 1
        display: Yes
        return: TRUE
    )

)

lov customers (
    name: CUSTOMERS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select 
                name,
                customer_id,
                company_name
            from dv_customers
            ;
            ```
    }
    columnMapping {
        return: CUSTOMER_ID
        display: NAME
        defaultSort: NAME
    }

    column COMPANY_NAME (
        heading {
            heading: Company Name
        }
        layout {
            sequence: 30
        }
        source {
            dataType: varchar2
        }
    )

    column CUSTOMER_ID (
        show: false
        layout {
            sequence: 10
        }
        source {
            dataType: number
        }
        advanced {
            searchable: false
        }
    )

    column NAME (
        heading {
            heading: Name
        }
        layout {
            sequence: 20
        }
        source {
            dataType: varchar2
        }
    )

)

