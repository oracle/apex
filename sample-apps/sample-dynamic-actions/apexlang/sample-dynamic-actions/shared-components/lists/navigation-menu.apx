list navigation-menu (
    name: Navigation Menu

    entry add-remove-class-error (
        label: Add/Remove Class (Error)
        layout {
            sequence: 110
            parentEntry: @style
        }
        isCurrent {
            type: pages
            pages: [
                6
                7
            ]
        }
        link {
            target: {
                page: 6
                clearCache: RIR
                action: resetPagination
            }
        }
    )

    entry add-remove-class-focus (
        label: Add/Remove Class (Focus)
        layout {
            sequence: 120
            parentEntry: @style
        }
