                select c.ID,
                       c.TITLE,
                       c.ENDPOINT_URL,
                       b.ENDPOINT_URL BASE_URL,
                       c.RESOURCE_NAME
                  from eba_util_farest_catalog c
                  left outer join eba_util_farest_cat_baseurl b on b.id = c.baseurl_id
